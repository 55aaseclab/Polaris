{
  "name": "geek-env",
  "private": true,
  "type": "module",
  "scripts": {
    "polaris": "pnpm --filter polaris run polaris",
    "polaris:server": "pnpm --filter polaris run server",
    "polaris:executor": "pnpm --filter polaris run executor",
    "polaris:web": "pnpm --filter polaris-web run dev -- --host 0.0.0.0",
    "build": "pnpm --filter polaris run build && pnpm --filter polaris-web run build",
    "check": "pnpm --filter polaris run check && pnpm --filter polaris-web run check",
    "test:polaris": "pnpm --filter polaris run test",
    "test:polaris:coverage": "pnpm --filter polaris run test:coverage"
  }
}
