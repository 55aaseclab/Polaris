{
  "name": "geek-env",
  "private": true,
  "type": "module",
  "scripts": {
    "polaris": "pnpm --filter polaris run polaris",
    "polaris:server": "pnpm --filter polaris run server",
    "paseo:embed": "pnpm --filter @paseo/embed run build",
    "paseo:embed-demo": "pnpm --filter paseo-embed-demo run dev",
    "test:paseo-embed": "pnpm --filter @paseo/embed run test",
    "build": "pnpm run build:surfaces && pnpm --filter polaris run build",
    "build:surfaces": "pnpm --filter @polaris/surface-paseo run build && pnpm --filter @polaris/surface-wanghai run build && pnpm --filter @polaris/polaris-shell run build && pnpm --filter polaris-portal run build && pnpm --filter polaris-tool-portal run build",
    "check": "pnpm --filter @polaris/vault-runtime run check && pnpm --filter polaris run check",
    "tool-portal:dev": "pnpm --filter polaris-tool-portal run dev",
    "tool-portal:build": "pnpm --filter polaris-tool-portal run build",
    "test:runtime": "pnpm --filter @polaris/vault-runtime run test",
    "test:polaris": "pnpm --filter polaris run test",
    "test:surfaces": "pnpm --filter @polaris/polaris-shell --filter @polaris/surface-paseo --filter @polaris/surface-wanghai --filter polaris-portal --filter polaris-tool-portal run test",
    "test:polaris:skills": "pnpm --filter polaris run test:skills",
    "test:literature-review": "pnpm --filter polaris run test:literature-review",
    "test:polaris:domain-packs": "pnpm --filter polaris run test:domain-packs",
    "test:polaris:full-minus-infra": "pnpm run test:runtime && pnpm --filter polaris run test:full-minus-infra",
    "test:live-auth": "pnpm --filter polaris run test:live-auth",
    "test:polaris:coverage": "pnpm --filter polaris run test:coverage",
    "business-core:typecheck": "pnpm --filter @polaris/business-core run typecheck",
    "content-production:typecheck": "pnpm --filter @polaris/content-production run typecheck",
    "content-production:test": "pnpm --filter @polaris/content-production run test",
    "product-video:typecheck": "pnpm --filter @polaris/product-video run typecheck",
    "product-video:test": "pnpm --filter @polaris/product-video run test",
    "business-portal:dev": "pnpm --filter @polaris/business-portal run dev",
    "business-portal:typecheck": "pnpm --filter @polaris/business-portal run typecheck",
    "business-portal:test": "pnpm --filter @polaris/business-portal run test",
    "business-portal:build": "pnpm --filter @polaris/business-portal run build",
    "test:polaris:business-tools": "node --test scripts/tests/polaris-business-tools.test.mjs"
  }
}
