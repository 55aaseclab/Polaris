map $http_x_forwarded_proto $polaris_content_security_policy {
  default "";
  https "upgrade-insecure-requests";
}

upstream polaris_server {
  server ${POLARIS_SERVER_UPSTREAM};
}

upstream polaris_webportal {
  server ${POLARIS_WEBPORTAL_UPSTREAM};
}

upstream paseo_app {
  server ${PASEO_APP_UPSTREAM};
}

server {
  listen ${NGINX_HTTP_PORT} default_server;
  server_name ${NGINX_SERVER_NAME} _;
  absolute_redirect off;
  add_header Content-Security-Policy $polaris_content_security_policy always;

  location = /paseo {
    return 301 /paseo/$is_args$args;
  }

  location /api/ {
    proxy_pass http://polaris_server;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /paseo/ {
    proxy_pass http://paseo_app/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://polaris_webportal;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
