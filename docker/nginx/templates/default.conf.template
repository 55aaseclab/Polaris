map $http_x_forwarded_proto $polaris_content_security_policy {
  default "";
  https "upgrade-insecure-requests";
}

map "${POLARIS_AUTH_MODE}" $polaris_auth_override {
  default "";
  disabled "disabled:${POLARIS_AUTH_DEFAULT_USER_ID}";
}

upstream polaris_server {
  server ${POLARIS_SERVER_UPSTREAM};
}

upstream paseo_app {
  server ${PASEO_APP_UPSTREAM};
}

server {
  listen ${NGINX_HTTP_PORT} default_server;
  server_name ${NGINX_SERVER_NAME} _;
  absolute_redirect off;
  add_header Content-Security-Policy $polaris_content_security_policy always;
  add_header Set-Cookie "polaris_auth_override=$polaris_auth_override; Path=/; SameSite=Lax" always;

  location /api/ {
    proxy_pass http://polaris_server;
    proxy_http_version 1.1;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location ^~ /landing/ {
    return 302 /paseo;
  }

  location = /welcome {
    return 302 /paseo;
  }

  location = /auth/callback {
    return 302 /paseo/auth/callback$is_args$args;
  }

  location = /paseo {
    proxy_pass http://paseo_app;
    proxy_http_version 1.1;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /paseo/ {
    rewrite ^/paseo/(.*)$ /$1 break;
    proxy_pass http://paseo_app;
    proxy_http_version 1.1;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    return 302 /paseo;
  }
}
