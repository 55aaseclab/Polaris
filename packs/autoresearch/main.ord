dsl version "0.4"
domain AutoResearch version "0.1.0"
title "autoresearch"
description "Evidence-bound literature collection, analysis, and report production."
category "Research"

port codex version "1.0.0" {
  in { question: String }
  out { keywordPlanRef: String, keywordCount: Number, keywordStatus: String }
  effect ffi
  binding { tool "codex" }
}

port literature.collection version "1.0.0" {
  in {
    question: String
    keywordPlanRef: String
    collectionInputRef: String
    workspaceId: ID
    runPrefix: ID
    decisionContext: String
    audience: String
  }
  out {
    collectionInputRef: String
    inputValid: Boolean
    collectionId: ID
    collectionCount: Number
    collectionStatus: String
  }
  effect ffi
  binding { tool "literature.collection" }
}

port pdf.capture version "1.0.0" {
  in { url: String }
  out { pdfPath: String? }
  effect ffi
  binding { tool "pdf.capture" }
}

port manual.review version "1.0.0" {
  in { capturedCollectionRef: String, reviewMode: String }
  out { reviewedCollectionRef: String, reviewStatus: String }
  effect ffi
  binding { tool "manual.review" }
}

port literature.analysis version "1.0.0" {
  in {
    reviewedCollectionRef: String
    analysisInputRef: String
    analysisOutputRef: String
    analysisRoot: String
    analysisId: ID
    question: String
    decisionContext: String
    audience: String
  }
  out {
    snapshotRef: String
    analysisInputRef: String
    clueCount: Number
    analysisOutputRef: String
    claimCount: Number
    analysisStatus: String
    analysisValid: Boolean
  }
  effect ffi
  binding { tool "literature.analysis" }
}

port literature.report version "1.0.0" {
  in {
    analysisOutputRef: String
    reportInputRef: String
    draftRef: String
    reviewsRef: String
    markdownRef: String
    reportId: ID
    reportTemplate: String
    draftOutputRef: String
    reviewOutputRef: String
    revisedDraftRef: String
    reportRunDir: String
    pdfRef: String
  }
  out {
    reportInputRef: String
    selectedTemplate: String
    draftRef: String
    draftValid: Boolean
    reviewsRef: String
    reportPassed: Boolean
    reviewCount: Number
    markdownRef: String
    manifestRef: String
    pdfRef: String
  }
  effect ffi
  binding { tool "literature.report" }
}

flow LiteratureReview title "Literature Review" create {
  description "Collect evidence, analyze claims, and publish a PDF report."
  input {
    question: String required control textarea label "Research brief"
    decisionContext: String required label "Decision context"
    audience: String required label "Audience"
    reviewMode: String required label "Collection review mode"
    reportTemplate: String required label "Report template"
  }
  steps {
    planKeywords "Plan search keywords" {
      uses { question }
      call codex
      command "plan-search-keywords"
      output { keywordPlanRef: String, keywordCount: Number, keywordStatus: String }
    }
    prepareCollection "Prepare collection input" {
      uses { question, keywordPlanRef, decisionContext, audience }
      call literature.collection
      command "prepare-literature-input"
      output { collectionInputRef: String, inputValid: Boolean }
    }
    validateCollection "Validate collection input" {
      uses { collectionInputRef }
      call literature.collection
      command "validate-input"
      output { inputValid: Boolean }
    }
    collectAndExpand "Collect and expand literature sources" {
      uses { collectionInputRef }
      call literature.collection
      command "collect-and-expand"
      output {
        expandedCollectionRef: String
        collectionId: ID
        collectionCount: Number
        collectionStatus: String
      }
    }
    capturePdfs "Capture PDFs" {
      uses { expandedCollectionRef }
      map item in expandedCollectionRef call pdf.capture
      command "capture"
      output { capturedCollectionRef: String, captureStatus: String }
    }
    reviewRecords "Review records" {
      uses { capturedCollectionRef, reviewMode }
      call manual.review
      command "review"
      output { reviewedCollectionRef: String, reviewStatus: String }
    }
    prepareAnalysis "Prepare analysis snapshot" {
      uses { reviewedCollectionRef, question, decisionContext, audience }
      call literature.analysis
      command "prepare"
      output { snapshotRef: String, analysisInputRef: String, clueCount: Number }
    }
    runAnalysis "Run claim analysis" {
      uses { analysisInputRef }
      call literature.analysis
      command "run"
      output { analysisOutputRef: String, claimCount: Number, analysisStatus: String }
    }
    validateAnalysis "Validate analysis output" {
      uses { analysisOutputRef }
      call literature.analysis
      command "validate-output"
      output { analysisValid: Boolean }
    }
    prepareReport "Prepare report input" {
      uses { analysisOutputRef, reportTemplate }
      call literature.report
      command "prepare"
      output { reportInputRef: String, selectedTemplate: String }
    }
    draftReport "Draft report" {
      uses { reportInputRef }
      call literature.report
      command "draft"
      output { draftRef: String, draftValid: Boolean }
    }
    reviewReport "Review report" {
      uses { reportInputRef, draftRef }
      call literature.report
      command "review"
      output { reviewsRef: String, reportPassed: Boolean, reviewCount: Number }
    }
    reviseReport "Revise report" {
      uses { reportInputRef, draftRef, reviewsRef }
      call literature.report
      command "revise"
      output { draftRef: String, reportPassed: Boolean }
    }
    publishReport "Publish Markdown report" {
      uses { reportInputRef, draftRef, reviewsRef }
      call literature.report
      command "publish"
      output { markdownRef: String, manifestRef: String }
    }
    renderPdf "Render PDF report" {
      uses { markdownRef }
      call literature.report
      command "pdf"
      output { pdfRef: String }
    }
  }
  output {
    pdfRef: String from pdfRef
    markdownRef: String from markdownRef
    manifestRef: String from manifestRef
  }
  ui { layout wizard primary "Review" icon "book-open" }
}
