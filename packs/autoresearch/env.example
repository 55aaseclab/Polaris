# Copy to a private file and set POLARIS_LITERATURE_ENV_FILE to its path.
POLARIS_LITERATURE_WORKSPACES_ROOT=/path/to/literature-workspaces
POLARIS_LITERATURE_CACHE_ROOT=/path/to/literature-cache
POLARIS_LITERATURE_RUNTIME_MODE=local

# Optional local Codex and source adapters.
# POLARIS_LITERATURE_CODEX_BIN=/path/to/codex
# POLARIS_LITERATURE_CODEX_CLI=/path/to/a/custom/clue-codex-cli
# POLARIS_LITERATURE_CODEX_MODEL=gpt-5.4-mini
# POLARIS_LITERATURE_SEMANTIC_SCHOLAR_API_KEY=
# POLARIS_LITERATURE_DEEPSEC_API_URL=https://example.invalid/api/papers/search
# POLARIS_LITERATURE_CROSSREF_API_URL=https://api.crossref.org
# POLARIS_LITERATURE_REASONING_EFFORT=medium
# POLARIS_LITERATURE_REPORT_REASONING_EFFORT=medium
# POLARIS_LITERATURE_GRAPHVIZ_BIN=dot
# POLARIS_LITERATURE_PDF_CACHE=/path/to/literature-pdfs
# BROWSER_CAMOFOX_URL=http://127.0.0.1:9377
# DISPLAY=:99
