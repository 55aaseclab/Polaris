{
  "schema_version": "polaris.literature-review.workflow.v1",
  "workflow_id": "literature-review",
  "workflow_version": "0.1.0",
  "workflow_language": "0.4-trial",
  "contract_compatibility": [
    "clue.data-collection.input.v2",
    "clue.data-collection.output.v2",
    "clue.data-collection.review-state.v1",
    "clue.data-collection.review-output.v1",
    "clue.data-collection.review-list.v1",
    "clue.data-collection.non-review.v1",
    "clue.manual-review.state.v2",
    "clue.manual-review.result.v2",
    "clue.intelligence-analysis.input.v2",
    "clue.intelligence-analysis.output.v2",
    "clue.report-writing.input.v2"
  ],
  "execution": {
    "default_network": "deny",
    "default_isolation": "scoped",
    "integrated_mode": "polaris-durable-job-only"
  },
  "components": {
    "collection": "tools/data-collection/clue-data-collection",
    "collection_review": "tools/collection-review/clue-collection-review",
    "analysis_review": "tools/analysis-review/clue-analysis-review",
    "analysis": "tools/intelligence-analysis/clue-intelligence-analysis",
    "report": "tools/report-writing/clue-report-writing",
    "workflow": "packs/autoresearch/workflow.py",
    "setup": "packs/autoresearch/install-dependencies.sh"
  },
  "port_bindings": {
    "ValidateLiteratureInput": "literature.collection",
    "CollectLiteratureSources": "literature.collection",
    "AugmentLiteratureCollection": "literature.collection",
    "ResolveCollectionReview": "literature.collection.review",
    "FreezeLiteratureSnapshot": "literature.analysis",
    "IterateLiteratureClaims": "literature.analysis.iterator",
    "ProposeLiteratureBatches": "literature.analysis.iterator",
    "MergeLiteratureBatches": "literature.analysis.iterator",
    "ProposeLiteratureClaims": "literature.analysis.iterator",
    "ValidateLiteratureClaims": "literature.analysis.iterator",
    "ResolveAnalysisReview": "literature.analysis.review",
    "FinalizeLiteratureAnalysis": "literature.analysis",
    "PrepareLiteratureReport": "literature.report",
    "DraftLiteratureReport": "literature.report",
    "ReviewLiteratureReport": "literature.report",
    "ReviseLiteratureReport": "literature.report",
    "PublishLiteratureMarkdown": "literature.report",
    "RenderLiteraturePdf": "literature.report"
  }
}
