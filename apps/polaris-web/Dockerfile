# syntax=docker/dockerfile:1.7
FROM node:22-bookworm AS build

RUN npm install -g pnpm@10.33.0

WORKDIR /workspace

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV PNPM_STORE_DIR=/pnpm/store

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/polaris/package.json apps/polaris/package.json
COPY apps/polaris-web/package.json apps/polaris-web/package.json
COPY config/users/user-map.example.json config/users/user-map.example.json

RUN --mount=type=cache,target=/pnpm/store \
  pnpm install --no-frozen-lockfile --filter polaris-web...

COPY apps/polaris-web ./apps/polaris-web

RUN mkdir -p config/users \
  && cp config/users/user-map.example.json config/users/user-map.json

ARG VITE_POLARIS_API_BASE=/api
ARG VITE_PASEO_APP_BASE_URL=
ARG VITE_CLERK_PUBLISHABLE_KEY=
ARG VITE_CLERK_DOMAIN=
ARG VITE_CLERK_PROXY_URL=
ARG VITE_CLERK_SATELLITE_DOMAIN=
ARG VITE_CLERK_SIGN_IN_URL=
ARG VITE_CLERK_SIGN_UP_URL=
ARG VITE_POLARIS_APP_VERSION=0.2.6
ARG VITE_POLARIS_RELEASE_CHANNEL=stable
ARG VITE_POLARIS_TELEMETRY_ENABLED=
ARG VITE_POLARIS_POSTHOG_KEY=
ARG VITE_POLARIS_POSTHOG_HOST=
ARG VITE_POLARIS_SENTRY_DSN=
ARG VITE_POLARIS_SENTRY_ENVIRONMENT=

ENV NODE_ENV=production
ENV VITE_POLARIS_API_BASE=${VITE_POLARIS_API_BASE}
ENV VITE_PASEO_APP_BASE_URL=${VITE_PASEO_APP_BASE_URL}
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY}
ENV VITE_CLERK_DOMAIN=${VITE_CLERK_DOMAIN}
ENV VITE_CLERK_PROXY_URL=${VITE_CLERK_PROXY_URL}
ENV VITE_CLERK_SATELLITE_DOMAIN=${VITE_CLERK_SATELLITE_DOMAIN}
ENV VITE_CLERK_SIGN_IN_URL=${VITE_CLERK_SIGN_IN_URL}
ENV VITE_CLERK_SIGN_UP_URL=${VITE_CLERK_SIGN_UP_URL}
ENV VITE_POLARIS_APP_VERSION=${VITE_POLARIS_APP_VERSION}
ENV VITE_POLARIS_RELEASE_CHANNEL=${VITE_POLARIS_RELEASE_CHANNEL}
ENV VITE_POLARIS_TELEMETRY_ENABLED=${VITE_POLARIS_TELEMETRY_ENABLED}
ENV VITE_POLARIS_POSTHOG_KEY=${VITE_POLARIS_POSTHOG_KEY}
ENV VITE_POLARIS_POSTHOG_HOST=${VITE_POLARIS_POSTHOG_HOST}
ENV VITE_POLARIS_SENTRY_DSN=${VITE_POLARIS_SENTRY_DSN}
ENV VITE_POLARIS_SENTRY_ENVIRONMENT=${VITE_POLARIS_SENTRY_ENVIRONMENT}

RUN --mount=type=cache,target=/pnpm/store \
  pnpm --filter polaris-web run build

FROM nginx:1.27-alpine

COPY apps/polaris-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/polaris-web/dist /usr/share/nginx/html

EXPOSE 80
