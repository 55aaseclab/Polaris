{
  "name": "polaris",
  "private": true,
  "type": "module",
  "scripts": {
    "polaris": "sh -lc 'if [ \"$1\" = \"--\" ]; then shift; fi; exec ./node_modules/.bin/tsx scripts/polaris.ts \"$@\"' --",
    "server": "pnpm run polaris -- server",
    "executor": "pnpm run polaris -- executor",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.3",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
