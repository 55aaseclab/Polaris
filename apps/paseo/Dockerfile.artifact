# syntax=docker/dockerfile:1.7

FROM node:22 AS artifact

ARG PASEO_WEB_BASE_URL=

ENV EXPO_NO_TELEMETRY=1
ENV DO_NOT_TRACK=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/paseo

COPY apps/paseo/source ./
COPY apps/paseo/patches /tmp/paseo-patches
COPY apps/paseo/rewrite-export-base-url.mjs /tmp/rewrite-paseo-base-url.mjs

RUN git reset --hard -q \
  && git clean -fdq \
  && git apply --3way /tmp/paseo-patches/paseo-web-authing-core.patch /tmp/paseo-patches/paseo-web-polaris-branding.patch /tmp/paseo-patches/paseo-web-settings-auth-visibility.patch /tmp/paseo-patches/paseo-web-polaris-host-sync.patch /tmp/paseo-patches/paseo-web-host-account-isolation.patch /tmp/paseo-patches/paseo-web-embed-mode.patch /tmp/paseo-patches/paseo-web-authing-package.patch /tmp/paseo-patches/paseo-web-auth-disabled-clean.patch /tmp/paseo-patches/paseo-web-surface-only.patch \
  && rm -rf .git

RUN --mount=type=cache,target=/root/.npm \
  --mount=type=cache,target=/root/.cache \
  npm ci --ignore-scripts --no-audit --prefer-offline \
  && PATH="/opt/paseo/node_modules/.bin:${PATH}" node scripts/postinstall-patches.mjs

ENV PASEO_WEB_BASE_URL=${PASEO_WEB_BASE_URL}

RUN --mount=type=cache,target=/root/.npm \
  --mount=type=cache,target=/root/.cache \
  npm run build:web --workspace=@getpaseo/app \
  && base_url="${PASEO_WEB_BASE_URL%/}" \
  && if [ -n "$base_url" ]; then \
    BASE_URL="$base_url" node /tmp/rewrite-paseo-base-url.mjs \
    && rm -f /tmp/rewrite-paseo-base-url.mjs; \
  fi

FROM scratch AS artifact-export

COPY --from=artifact /opt/paseo/packages/app/dist /dist
