+          <Text style={settingsStyles.rowHint}>
+            {`${driverLabel} · ${isRunning ? "运行中" : "已停止"}`}
+          </Text>
+        </View>
+        <Button
+          size="sm"
+          variant="secondary"
+          leftIcon={Power}
+          disabled={busy}
+          onPress={() => void act(isRunning ? "stop" : "start")}
+        >
+          {isRunning ? "停止" : "开始"}
+        </Button>
+      </View>
     </View>
   );
 }
