index 0000000..d30bf0f
--- /dev/null
+++ b/packages/app/src/app/auth/callback.tsx
@@ -0,0 +1,97 @@
+import { useEffect, useRef, useState } from "react";
+import { ActivityIndicator, Text, View } from "react-native";
+import { useRouter } from "expo-router";
+import { StyleSheet, useUnistyles } from "react-native-unistyles";
+import { Button } from "@/components/ui/button";
+import {
+  beginPolarisSignIn,
+  clearPolarisSignIn,
+  completePolarisSignIn,
+  getPolarisAuthToken,
+  polarisApiBaseUrl,
+  publishPolarisAuthSession,
+} from "@/lib/polaris-authing";
+
+const incompleteUserMessage = "Authing 用户信息未补全，请先完成用户名补全";
+
+interface PolarisSessionResponse {
+  authingUserId: string;
+  authingUsername: string | null;
+  polarisUserId: string | null;
+}
+
+async function fetchPolarisSession(token: string): Promise<PolarisSessionResponse> {
+  const response = await fetch(`${polarisApiBaseUrl()}/session`, {
+    headers: { authorization: `Bearer ${token}` },
+  });
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new Error(typeof body.error === "string" ? body.error : "无法加载 Polaris 会话");
+  }
+  return body as PolarisSessionResponse;
+}
+
+async function ensurePolarisUser(token: string): Promise<void> {
+  const session = await fetchPolarisSession(token);
+  if (session.polarisUserId) {
+    return;
+  }
+  const userProfileId = session.authingUsername?.trim();
+  if (!userProfileId) {
+    throw new Error(incompleteUserMessage);
+  }
+  const response = await fetch(`${polarisApiBaseUrl()}/users`, {
+    method: "POST",
+    headers: {
+      authorization: `Bearer ${token}`,
+      "content-type": "application/json",
+    },
+    body: JSON.stringify({
+      userProfileId,
+      authingUsername: session.authingUsername ?? "",
+      authingUserId: session.authingUserId,
+    }),
+  });
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new Error(typeof body.error === "string" ? body.error : "无法创建 Polaris 用户");
+  }
+}
+
+export default function PolarisAuthCallbackRoute() {
+  const router = useRouter();
+  const { theme } = useUnistyles();
+  const handledRef = useRef(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (handledRef.current) return;
+    handledRef.current = true;
+    let disposed = false;
+    void completePolarisSignIn()
+      .then(async (returnPath) => {
+        const token = getPolarisAuthToken();
+        if (!token) {
+          throw new Error("Authing 登录未完成");
+        }
+        await ensurePolarisUser(token);
+        publishPolarisAuthSession();
+        router.replace(returnPath as never);
+      })
+      .catch((reason) => {
+        if (disposed) return;
+        const message = reason instanceof Error ? reason.message : String(reason);
+        setError(message);
+        clearPolarisSignIn();
+      });
+
+    return () => {
+      disposed = true;
+    };
+  }, [router]);
+
+  return (
+    <View style={styles.container}>
+      {error ? (
+        <View style={styles.errorContent}>
+          <Text style={styles.error}>{error}</Text>
+          <Button size="sm" variant="secondary" onPress={beginPolarisSignIn}>
+            重新登录
+          </Button>
+        </View>
+      ) : <ActivityIndicator color={theme.colors.foregroundMuted} />}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: { flex: 1, alignItems: "center", justifyContent: "center", padding: theme.spacing[6] },
+  errorContent: { alignItems: "center", gap: theme.spacing[3] },
+  error: { color: theme.colors.destructive, fontSize: theme.fontSize.sm, textAlign: "center" },
+}));

