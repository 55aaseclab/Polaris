+import { Redirect } from "expo-router";
+import SettingsScreen from "@/screens/settings-screen";
+import { usePolarisAuthSession } from "@/lib/polaris-authing";
+
+const USER_VIEW = { kind: "polaris-user" as const };
+
+export default function PolarisUserRoute() {
+  const hasPolarisSession = usePolarisAuthSession();
+  if (!hasPolarisSession) {
+    return <Redirect href="/welcome" />;
+  }
+
+  return <SettingsScreen view={USER_VIEW} />;
+}
