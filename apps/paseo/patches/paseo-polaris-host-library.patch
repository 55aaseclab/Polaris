+import { beginPolarisSignIn, getPolarisAuthToken } from "@/lib/polaris-authing";
+
+const labels = {
+  title: "Polaris 工作库",
+  description: "管理此账户的 Polaris Host；它们与 Paseo 原生 Workspaces 相互独立",
+  namePlaceholder: "Host 名称",
+  create: "创建新的 Host",
+  empty: "还没有 Polaris Host",
+  start: "启动",
+  stop: "停止",
+  archive: "归档",
+  delete: "删除",
+  archived: "已归档",
+  unknown: "状态未知",
+  running: "运行中",
+  stopped: "已停止",
+  archiveConfirmTitle: "归档这个 Host？",
+  deleteConfirmTitle: "永久删除这个 Host？",
+};
+
+interface PolarisHost {
+  name: string;
+  status: {
+    lifecycle?: { phase?: string };
+  } | null;
+}
+
+interface ArchivedPolarisHost {
+  archiveId: string;
+  workspaceName: string;
+  archivedAt: string;
+}
+
+interface PolarisHostsResponse {
+  hosts: PolarisHost[];
+  archivedHosts: ArchivedPolarisHost[];
+}
+
+async function polarisRequest(path: string, init?: RequestInit): Promise<unknown> {
+  const configuredPort = process.env.EXPO_PUBLIC_POLARIS_API_PORT;
+  const apiBase = configuredPort && typeof globalThis.location !== "undefined"
+    ? `${globalThis.location.protocol}//${globalThis.location.hostname}:${configuredPort}/api`
+    : "/api";
+  const response = await fetch(`${apiBase}/polaris-hosts${path}`, {
+    ...init,
+    headers: {
+      "content-type": "application/x-www-form-urlencoded",
+      ...(getPolarisAuthToken() ? { authorization: `Bearer ${getPolarisAuthToken()}` } : {}),
+      ...init?.headers,
+    },
+  });
+  const body = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new Error(typeof body.error === "string" ? body.error : "Polaris request failed");
+  }
+  return body;
+}
+
+function hostPhase(host: PolarisHost): string {
+  const phase = host.status?.lifecycle?.phase;
+  if (!phase) return labels.unknown;
+  return phase === "running"
+    ? labels.running
+    : phase === "stopped"
+      ? labels.stopped
+      : phase;
+}
+
+export function PolarisHostLibraryPage({ serverId: _serverId }: { serverId: string }) {
+  const { theme } = useUnistyles();
+  const [hosts, setHosts] = useState<PolarisHost[]>([]);
+  const [archivedHosts, setArchivedHosts] = useState<ArchivedPolarisHost[]>([]);
+  const [hostName, setHostName] = useState("");
+  const [loading, setLoading] = useState(true);
+  const [creating, setCreating] = useState(false);
+  const [busyHost, setBusyHost] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const authenticationRequired = error === "Authentication is required";
+
+  const refresh = useCallback(async () => {
+    setLoading(true);
+    try {
+      const response = await polarisRequest("") as PolarisHostsResponse;
+      setHosts(response.hosts);
+      setArchivedHosts(response.archivedHosts);
+      setError(null);
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : String(reason));
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void refresh();
+  }, [refresh]);
+
+  const createHost = useCallback(async () => {
+    const trimmedName = hostName.trim();
+    if (!trimmedName || creating) return;
+    setCreating(true);
+    try {
+      await polarisRequest("", {
+        method: "POST",
+        body: new URLSearchParams({ hostName: trimmedName }).toString(),
+      });
+      setHostName("");
+      await refresh();
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : String(reason));
+    } finally {
+      setCreating(false);
+    }
+  }, [creating, hostName, refresh]);
+
+  const actOnHost = useCallback(async (name: string, action: "start" | "stop" | "archive" | "delete") => {
+    const destructive = action === "archive" || action === "delete";
+    if (destructive && !await confirmDialog({
+      title: action === "archive" ? labels.archiveConfirmTitle : labels.deleteConfirmTitle,
+      message: action === "archive"
+        ? `“${name}” 将停止并移入归档。`
+        : `“${name}” 及其所有数据将被永久删除。`,
+      confirmLabel: action === "archive" ? labels.archive : labels.delete,
+      destructive: true,
+    })) return;
+    setBusyHost(name);
+    try {
+      await polarisRequest(`/${encodeURIComponent(name)}`, action === "archive"
+        ? { method: "DELETE" }
+        : {
+          method: "POST",
+          body: new URLSearchParams({ action }).toString(),
+        });
+      await refresh();
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : String(reason));
+    } finally {
+      setBusyHost(null);
+    }
+  }, [refresh]);
+
+  const deleteArchivedHost = useCallback(async (host: ArchivedPolarisHost) => {
+    if (!await confirmDialog({
+      title: labels.deleteConfirmTitle,
+      message: `“${host.workspaceName}” 及其归档数据将被永久删除。`,
+      confirmLabel: labels.delete,
+      destructive: true,
+    })) return;
+    setBusyHost(host.archiveId);
+    try {
+      await polarisRequest(`/archives/${encodeURIComponent(host.archiveId)}`, { method: "DELETE" });
+      await refresh();
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : String(reason));
+    } finally {
+      setBusyHost(null);
+    }
+  }, [refresh]);
+
+  return (
+    <View>
+      <SettingsSection title={labels.title}>
+        <Text style={styles.description}>{labels.description}</Text>
+        <View style={styles.createRow}>
+          <TextInput
+            value={hostName}
+            onChangeText={setHostName}
+            onSubmitEditing={() => void createHost()}
+            placeholder={labels.namePlaceholder}
+            placeholderTextColor={theme.colors.foregroundMuted}
+            style={styles.input}
+          />
+          <Button size="sm" leftIcon={Plus} loading={creating} onPress={() => void createHost()}>
+            {labels.create}
+          </Button>
+        </View>
+        {error ? <Text style={styles.error}>{error}</Text> : null}
+        {authenticationRequired ? (
+          <Button size="sm" onPress={beginPolarisSignIn}>登录 Polaris</Button>
+        ) : null}
+        {loading ? (
+          <ActivityIndicator color={theme.colors.foregroundMuted} />
+        ) : hosts.length === 0 ? (
+          <Text style={styles.empty}>{labels.empty}</Text>
+        ) : (
+          <View style={styles.table}>
+            {hosts.map((host) => {
+              const busy = busyHost === host.name;
+              const phase = host.status?.lifecycle?.phase;
+              return (
+                <View key={host.name} style={styles.row}>
+                  <View style={styles.hostInfo}>
+                    <Text style={styles.hostName}>{host.name}</Text>
+                    <Text style={styles.status}>{hostPhase(host)}</Text>
+                  </View>
+                  <View style={styles.actions}>
+                    {phase === "stopped" ? (
+                      <Button size="xs" variant="outline" disabled={busy} onPress={() => void actOnHost(host.name, "start")}>
+                        {labels.start}
+                      </Button>
+                    ) : (
+                      <Button size="xs" variant="outline" leftIcon={Power} disabled={busy} onPress={() => void actOnHost(host.name, "stop")}>
+                        {labels.stop}
+                      </Button>
+                    )}
+                    <Button size="xs" variant="ghost" leftIcon={Archive} disabled={busy} onPress={() => void actOnHost(host.name, "archive")}>
+                      {labels.archive}
+                    </Button>
+                    <Button size="xs" variant="destructive" leftIcon={Trash2} disabled={busy} onPress={() => void actOnHost(host.name, "delete")}>
+                      {labels.delete}
+                    </Button>
+                  </View>
+                </View>
+              );
+            })}
+          </View>
+        )}
+      </SettingsSection>
+
+      {archivedHosts.length > 0 ? (
+        <SettingsSection title={labels.archived}>
+          <View style={styles.table}>
+            {archivedHosts.map((host) => (
+              <View key={host.archiveId} style={styles.row}>
+                <View style={styles.hostInfo}>
+                  <Text style={styles.hostName}>{host.workspaceName}</Text>
+                  <Text style={styles.status}>归档于 {new Date(host.archivedAt).toLocaleDateString()}</Text>
+                </View>
+                <Button size="xs" variant="destructive" leftIcon={Trash2} disabled={busyHost === host.archiveId} onPress={() => void deleteArchivedHost(host)}>
+                  {labels.delete}
+                </Button>
+              </View>
+            ))}
+          </View>
+        </SettingsSection>
+      ) : null}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  description: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm },
+  createRow: { flexDirection: "row", alignItems: "center", gap: theme.spacing[2] },
+  input: {
+    flex: 1,
+    minWidth: 0,
+    color: theme.colors.foreground,
+    backgroundColor: theme.colors.surface2,
+    borderColor: theme.colors.border,
+    borderWidth: 1,
+    borderRadius: theme.borderRadius.md,
+    paddingHorizontal: theme.spacing[3],
+    paddingVertical: theme.spacing[2],
+    fontSize: theme.fontSize.sm,
+  },
+  table: { borderTopWidth: 1, borderTopColor: theme.colors.border },
+  row: {
+    minHeight: 56,
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    gap: theme.spacing[3],
+    borderBottomWidth: 1,
+    borderBottomColor: theme.colors.border,
+    paddingVertical: theme.spacing[2],
+  },
+  hostInfo: { flex: 1, minWidth: 0, gap: theme.spacing[1] },
+  hostName: { color: theme.colors.foreground, fontSize: theme.fontSize.sm, fontWeight: theme.fontWeight.medium },
+  status: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.xs },
+  actions: { flexDirection: "row", alignItems: "center", gap: theme.spacing[1] },
+  empty: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm, paddingVertical: theme.spacing[2] },
+  error: { color: theme.colors.destructive, fontSize: theme.fontSize.sm },
+}));
