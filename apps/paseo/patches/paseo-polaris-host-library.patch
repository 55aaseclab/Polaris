+import { getHostRuntimeStore } from "@/runtime/host-runtime";
+import {
+  normalizeEmptyProjectDescriptor,
+  useSessionStore,
+} from "@/stores/session-store";
+
+export const DEFAULT_POLARIS_PROJECT_PATH = "/root/workspace";
+
+export async function addPolarisProject(
+  serverId: string,
+  path: string,
+  isDisposed: () => boolean = () => false,
+): Promise<void> {
+  while (!isDisposed()) {
+    const client = getHostRuntimeStore().getClient(serverId);
+    if (client) {
+      const result = await client.addProject(path);
+      if (result.error) throw new Error(result.error);
+      if (result.project) {
+        const sessionStore = useSessionStore.getState();
+        sessionStore.addEmptyProject(
+          serverId,
+          normalizeEmptyProjectDescriptor(result.project),
+        );
+        sessionStore.setHasHydratedWorkspaces(serverId, true);
+      }
+      return;
+    }
+    await new Promise((resolve) => setTimeout(resolve, 1_000));
+  }
+}
