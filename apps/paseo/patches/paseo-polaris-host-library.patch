diff --git a/packages/app/src/app/auth/callback.tsx b/packages/app/src/app/auth/callback.tsx
new file mode 100644
index 0000000..b45c7b3
--- /dev/null
+++ b/packages/app/src/app/auth/callback.tsx
@@ -0,0 +1,50 @@
+import { useEffect, useState } from "react";
+import { ActivityIndicator, Text, View } from "react-native";
+import { useRouter } from "expo-router";
+import { StyleSheet, useUnistyles } from "react-native-unistyles";
+import { completePolarisSignIn, clearPolarisSignIn, getPolarisAuthToken, polarisApiBaseUrl } from "@/lib/polaris-authing";
+import { useHostMutations } from "@/runtime/host-runtime";
+
+interface PolarisHostSyncResponse {
+  hosts: Array<{ name: string; status: { paseo?: { liveTarget?: string | null } } | null }>;
+}
+
+export default function PolarisAuthCallbackRoute() {
+  const router = useRouter();
+  const { theme } = useUnistyles();
+  const { upsertConnectionFromOfferUrl } = useHostMutations();
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    void completePolarisSignIn()
+      .then(async (returnPath) => {
+        const token = getPolarisAuthToken();
+        const response = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+          headers: token ? { authorization: `Bearer ${token}` } : {},
+        });
+        const body = await response.json().catch(() => null) as PolarisHostSyncResponse | null;
+        if (response.ok) {
+          await Promise.allSettled((body?.hosts ?? []).map(async (host) => {
+            const pairingUrl = host.status?.paseo?.liveTarget?.trim();
+            if (pairingUrl) await upsertConnectionFromOfferUrl(pairingUrl, host.name);
+          }));
+        }
+        router.replace(returnPath as never);
+      })
+      .catch((reason) => {
+        clearPolarisSignIn();
+        setError(reason instanceof Error ? reason.message : String(reason));
+      });
+  }, [router, upsertConnectionFromOfferUrl]);
+
+  return (
+    <View style={styles.container}>
+      {error ? <Text style={styles.error}>{error}</Text> : <ActivityIndicator color={theme.colors.foregroundMuted} />}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: { flex: 1, alignItems: "center", justifyContent: "center", padding: theme.spacing[6] },
+  error: { color: theme.colors.destructive, fontSize: theme.fontSize.sm, textAlign: "center" },
+}));
