+      setWorkspace(null);
+      return;
+    }
+    const response = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+      headers: { authorization: `Bearer ${token}` },
+    });
+    if (!response.ok) throw new Error("无法读取 Polaris 主机状态");
+    const body = await response.json().catch(() => null) as {
+      hosts?: Array<{
+        name: string;
+        status: {
+          driver?: {
+            status?: string;
+            selected?: { backend?: string; profile?: string } | null;
+          } | null;
+        } | null;
+      }>;
+    } | null;
+    setWorkspace(body?.hosts?.find((item) => item.name === host.label) ?? null);
+  }, [host.label]);
+  useEffect(() => {
+    void load().catch((error) => {
+      console.warn("[HostPage] Failed to load Polaris host status", error);
+    });
+  }, [load]);
+  const act = useCallback(async (action: "start" | "stop") => {
+    if (!workspace || busy) return;
+    setBusy(true);
+    try {
+      const token = getPolarisAuthToken();
+      if (!token) throw new Error("请先登录 Polaris");
+      const response = await fetch(`${polarisApiBaseUrl()}/polaris-hosts/${encodeURIComponent(workspace.name)}`, {
+        method: "POST",
+        headers: { "content-type": "application/x-www-form-urlencoded", ...(token ? { authorization: `Bearer ${token}` } : {}) },
+        body: new URLSearchParams({ action }).toString(),
+      });
+      if (!response.ok) throw new Error("Polaris 操作失败");
+      await load();
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : "Polaris 操作失败");
+    } finally {
+      setBusy(false);
+    }
+  }, [busy, load, toast, workspace]);
+  if (!workspace) return null;
+  const isRunning = workspace.status?.driver?.status === "running";
+  const driver = workspace.status?.driver?.selected;
+  const driverLabel = driver?.profile
+    ? `${driver.backend} · ${driver.profile}`
+    : driver?.backend || "Driver 未配置";
+
+  return (
+    <View style={settingsStyles.card}>
+      <View style={settingsStyles.row}>
+        <View style={settingsStyles.rowContent}>
