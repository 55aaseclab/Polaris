new file mode 100644
index 0000000..180056b
--- /dev/null
+++ b/packages/app/src/components/create-polaris-host-modal.tsx
@@ -0,0 +1,83 @@
+import { useCallback, useState } from "react";
+import { Text, View } from "react-native";
+import { StyleSheet, useUnistyles } from "react-native-unistyles";
+import { AdaptiveModalSheet, AdaptiveTextInput } from "@/components/adaptive-modal-sheet";
+import { Button } from "@/components/ui/button";
+import { Switch } from "@/components/ui/switch";
+import { getPolarisAuthToken, polarisApiBaseUrl } from "@/lib/polaris-authing";
+import { addPolarisProject, DEFAULT_POLARIS_PROJECT_PATH } from "@/lib/polaris-project";
+import { useHostMutations } from "@/runtime/host-runtime";
+
+export function CreatePolarisHostModal({ visible, onClose }: { visible: boolean; onClose: () => void }) {
+  const { theme } = useUnistyles();
+  const { upsertConnectionFromOfferUrl } = useHostMutations();
+  const [name, setName] = useState("");
+  const [creating, setCreating] = useState(false);
+  const [createDefaultProject, setCreateDefaultProject] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const trimmedName = name.trim();
+  const validName = /^(?=.{1,63}$)(?=.*[a-z])[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$/.test(trimmedName);
+  const create = useCallback(async () => {
+    const hostName = name.trim();
+    if (!hostName || creating) return;
+    if (!validName) {
+      setError("名称需为 1–63 位小写字母、数字或连字符，并且包含字母");
+      return;
+    }
+    setCreating(true); setError(null);
+    try {
+      const token = getPolarisAuthToken();
+      const response = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+        method: "POST",
+        headers: { "content-type": "application/x-www-form-urlencoded", ...(token ? { authorization: `Bearer ${token}` } : {}) },
+        body: new URLSearchParams({ hostName }).toString(),
+      });
+      const body = await response.json().catch(() => ({}));
+      if (!response.ok) {
+        const message = typeof body.error === "string" ? body.error : "创建主机失败";
+        if (/already exists/i.test(message)) throw new Error(`主机“${hostName}”已存在`);
+        throw new Error(message);
+      }
+      const deadline = Date.now() + 90_000;
+      while (Date.now() < deadline) {
+        await new Promise((resolve) => setTimeout(resolve, 1_000));
+        const hostsResponse = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+          headers: token ? { authorization: `Bearer ${token}` } : {},
+        });
+        const hostsBody = await hostsResponse.json().catch(() => null) as {
+          hosts?: Array<{ name: string; status?: { paseo?: { liveTarget?: string | null } } | null }>;
+        } | null;
+        const pairingUrl = hostsBody?.hosts?.find((host) => host.name === hostName)
+          ?.status?.paseo?.liveTarget?.trim();
+        if (!pairingUrl) continue;
+        const profile = await upsertConnectionFromOfferUrl(pairingUrl, hostName);
+        if (createDefaultProject) {
+          await addPolarisProject(profile.serverId, DEFAULT_POLARIS_PROJECT_PATH);
+        }
+        setName(""); onClose(); return;
+      }
+      throw new Error("主机仍在准备中，请稍后刷新主机列表");
+    } catch (reason) { setError(reason instanceof Error ? reason.message : String(reason)); }
+    finally { setCreating(false); }
+  }, [createDefaultProject, creating, name, onClose, upsertConnectionFromOfferUrl, validName]);
+  return <AdaptiveModalSheet header={{ title: "创建主机" }} visible={visible} onClose={onClose}>
+    <View style={styles.field}><Text style={styles.label}>名称</Text><AdaptiveTextInput value={name} onChangeText={(value) => { setName(value); setError(null); }} placeholder="主机名称" autoFocus /><Text style={validName || !trimmedName ? styles.hint : styles.error}>1–63 位小写字母、数字或连字符，首尾不能是连字符</Text></View>
+    <View style={styles.projectOption}>
+      <View style={styles.projectOptionCopy}>
+        <Text style={styles.label}>创建默认项目</Text>
+        <Text style={styles.hint}>{DEFAULT_POLARIS_PROJECT_PATH}</Text>
+      </View>
+      <Switch value={createDefaultProject} onValueChange={setCreateDefaultProject} />
+    </View>
+    {error ? <Text style={styles.error}>{error}</Text> : null}
+    <Button size="sm" loading={creating} disabled={!validName} onPress={() => void create()}>{creating ? "正在创建" : "创建"}</Button>
+  </AdaptiveModalSheet>;
+}
+const styles = StyleSheet.create((theme) => ({
+  field: { gap: theme.spacing[2] },
+  label: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm },
+  hint: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.xs },
+  error: { color: theme.colors.destructive, fontSize: theme.fontSize.sm },
+  projectOption: { alignItems: "center", flexDirection: "row", justifyContent: "space-between" },
+  projectOptionCopy: { gap: theme.spacing[1] },
+}));
