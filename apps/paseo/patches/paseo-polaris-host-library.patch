diff --git a/packages/app/src/app/auth/callback.tsx b/packages/app/src/app/auth/callback.tsx
new file mode 100644
index 0000000..3ba666f
--- /dev/null
+++ b/packages/app/src/app/auth/callback.tsx
@@ -0,0 +1,139 @@
+import { useEffect, useState } from "react";
+import { ActivityIndicator, Text, View } from "react-native";
+import { useRouter } from "expo-router";
+import { StyleSheet, useUnistyles } from "react-native-unistyles";
+import { Button } from "@/components/ui/button";
+import {
+  beginPolarisSignIn,
+  clearPolarisSignIn,
+  completePolarisSignIn,
+  getPolarisAuthToken,
+  polarisApiBaseUrl,
+} from "@/lib/polaris-authing";
+import { useHostMutations } from "@/runtime/host-runtime";
+import { buildHostRootRoute } from "@/utils/host-routes";
+
+interface PolarisHostSyncResponse {
+  hosts: Array<{ name: string; status: { paseo?: { liveTarget?: string | null } } | null }>;
+}
+
+const DEFAULT_POLARIS_HOST_NAME = "default";
+
+export default function PolarisAuthCallbackRoute() {
+  const router = useRouter();
+  const { theme } = useUnistyles();
+  const { upsertConnectionFromOfferUrl } = useHostMutations();
+  const [error, setError] = useState<string | null>(null);
+  const [retrySeconds, setRetrySeconds] = useState<number | null>(null);
+
+  useEffect(() => {
+    let disposed = false;
+    let retryTimer: ReturnType<typeof setTimeout> | null = null;
+    let countdownTimer: ReturnType<typeof setInterval> | null = null;
+    void completePolarisSignIn()
+      .then(async (returnPath) => {
+        let connectedHostServerId: string | null = null;
+        try {
+          const token = getPolarisAuthToken();
+          const response = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+            headers: token ? { authorization: `Bearer ${token}` } : {},
+          });
+          const body = await response.json().catch(() => null) as PolarisHostSyncResponse | null;
+          if (response.ok) {
+            const hosts = body?.hosts ?? [];
+            if (hosts.length === 0) {
+              const createResponse = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+                method: "POST",
+                headers: {
+                  "content-type": "application/x-www-form-urlencoded",
+                  ...(token ? { authorization: `Bearer ${token}` } : {}),
+                },
+                body: new URLSearchParams({ hostName: DEFAULT_POLARIS_HOST_NAME }).toString(),
+              });
+              if (!createResponse.ok) {
+                throw new Error("无法创建默认主机");
+              }
+
+              while (!disposed) {
+                await new Promise((resolve) => setTimeout(resolve, 1_000));
+                const hostsResponse = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+                  headers: token ? { authorization: `Bearer ${token}` } : {},
+                });
+                if (!hostsResponse.ok) continue;
+                const hostsBody = await hostsResponse.json().catch(() => null) as PolarisHostSyncResponse | null;
+                const pairingUrl = hostsBody?.hosts.find(
+                  (host) => host.name === DEFAULT_POLARIS_HOST_NAME,
+                )?.status?.paseo?.liveTarget?.trim();
+                if (!pairingUrl) continue;
+                connectedHostServerId = (
+                  await upsertConnectionFromOfferUrl(pairingUrl, DEFAULT_POLARIS_HOST_NAME)
+                ).serverId;
+                break;
+              }
+            } else {
+              const syncedHosts = await Promise.allSettled(hosts.map(async (host) => {
+              const pairingUrl = host.status?.paseo?.liveTarget?.trim();
+              return pairingUrl ? upsertConnectionFromOfferUrl(pairingUrl, host.name) : null;
+              }));
+              const connectedHost = syncedHosts.find(
+                (result) => result.status === "fulfilled" && result.value !== null,
+              );
+              if (connectedHost?.status === "fulfilled" && connectedHost.value) {
+                connectedHostServerId = connectedHost.value.serverId;
+              }
+            }
+          }
+        } catch (error) {
+          console.warn("[PolarisAuth] Failed to sync Polaris hosts after sign-in", error);
+        }
+        router.replace(
+          connectedHostServerId
+            ? buildHostRootRoute(connectedHostServerId)
+            : returnPath as never,
+        );
+      })
+      .catch((reason) => {
+        if (disposed) return;
+        clearPolarisSignIn();
+        setError(reason instanceof Error ? reason.message : String(reason));
+        setRetrySeconds(3);
+        retryTimer = setTimeout(beginPolarisSignIn, 3_000);
+        countdownTimer = setInterval(() => {
+          setRetrySeconds((current) => {
+            if (!current || current <= 1) {
+              if (countdownTimer) clearInterval(countdownTimer);
+              return current;
+            }
+            return current - 1;
+          });
+        }, 1_000);
+      });
+
+    return () => {
+      disposed = true;
+      if (retryTimer) clearTimeout(retryTimer);
+      if (countdownTimer) clearInterval(countdownTimer);
+    };
+  }, [router, upsertConnectionFromOfferUrl]);
+
+  return (
+    <View style={styles.container}>
+      {error ? (
+        <View style={styles.errorContent}>
+          <Text style={styles.error}>{error}</Text>
+          <Text style={styles.hint}>将在 {retrySeconds ?? 3} 秒后重新登录</Text>
+          <Button size="sm" variant="secondary" onPress={beginPolarisSignIn}>
+            重新登录
+          </Button>
+        </View>
+      ) : <ActivityIndicator color={theme.colors.foregroundMuted} />}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  container: { flex: 1, alignItems: "center", justifyContent: "center", padding: theme.spacing[6] },
+  errorContent: { alignItems: "center", gap: theme.spacing[3] },
+  error: { color: theme.colors.destructive, fontSize: theme.fontSize.sm, textAlign: "center" },
+  hint: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm, textAlign: "center" },
+}));
