index 0000000..d2c59ce
--- /dev/null
+++ b/packages/app/src/lib/polaris-authing.test.ts
@@ -0,0 +1,262 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  beginPolarisSignIn,
+  clearPolarisSignIn,
+  completePolarisSignIn,
+  getPolarisAuthToken,
+  getPolarisAuthUserScope,
+  hasPolarisAuthSession,
+  hasPolarisHostSession,
+  isPolarisAuthDisabled,
+  publishPolarisAuthSession,
+  resolvePolarisAuthRedirect,
+  signOutPolaris,
+  subscribePolarisAuthSession,
+} from "./polaris-authing";
+
+const sessionKeys = [
+  "polaris_authing_session",
+  "polaris_authing_id_token",
+  "polaris_authing_pkce_verifier",
+  "polaris_authing_state",
+  "polaris_authing_return_path",
+  "polaris_authing_redirect_uri",
+];
+
+function installSessionStorage(): Storage {
+  const values = new Map<string, string>();
+  const storage: Storage = {
+    get length() {
+      return values.size;
+    },
+    clear: () => values.clear(),
+    getItem: (key) => values.get(key) ?? null,
+    key: (index) => [...values.keys()][index] ?? null,
+    removeItem: (key) => {
+      values.delete(key);
+    },
+    setItem: (key, value) => {
+      values.set(key, String(value));
+    },
+  };
+  Object.defineProperty(globalThis, "sessionStorage", {
+    configurable: true,
+    value: storage,
+  });
+  return storage;
+}
+
+function installLocalStorage(): Storage {
+  const values = new Map<string, string>();
+  const storage: Storage = {
+    get length() {
+      return values.size;
+    },
+    clear: () => values.clear(),
+    getItem: (key) => values.get(key) ?? null,
+    key: (index) => [...values.keys()][index] ?? null,
+    removeItem: (key) => {
+      values.delete(key);
+    },
+    setItem: (key, value) => {
+      values.set(key, String(value));
+    },
+  };
+  Object.defineProperty(globalThis, "localStorage", {
+    configurable: true,
+    value: storage,
+  });
+  return storage;
+}
+
+function portalSessionToken(subject: string): string {
+  const payload = Buffer.from(JSON.stringify({ sub: subject }))
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+  return `header.${payload}.signature`;
+}
+
+afterEach(() => {
+  delete (globalThis as { sessionStorage?: Storage }).sessionStorage;
+  delete (globalThis as { localStorage?: Storage }).localStorage;
+  delete process.env.EXPO_PUBLIC_POLARIS_AUTH_MODE;
+  delete process.env.EXPO_PUBLIC_POLARIS_AUTH_DEFAULT_USER_ID;
+  vi.unstubAllGlobals();
+});
+
+describe("Polaris authentication state", () => {
+  it("clears every local authentication value on sign-out", () => {
+    const storage = installSessionStorage();
+    const onSessionChange = vi.fn();
+    const unsubscribe = subscribePolarisAuthSession(onSessionChange);
+    for (const key of sessionKeys) storage.setItem(key, "value");
+
+    expect(hasPolarisAuthSession()).toBe(true);
+
+    clearPolarisSignIn();
+
+    for (const key of sessionKeys) expect(storage.getItem(key)).toBeNull();
+    expect(getPolarisAuthToken()).toBeNull();
+    expect(hasPolarisAuthSession()).toBe(false);
+    expect(onSessionChange).toHaveBeenCalledTimes(1);
+    unsubscribe();
+  });
+
+  it("publishes the authenticated state when completing sign-in", async () => {
+    const storage = installSessionStorage();
+    installLocalStorage();
+    const token = portalSessionToken("authing-user-a");
+    storage.setItem("polaris_authing_pkce_verifier", "verifier");
+    storage.setItem("polaris_authing_state", "expected-state");
+    storage.setItem("polaris_authing_return_path", "/welcome");
+    storage.setItem("polaris_authing_redirect_uri", "http://example.test/auth/callback");
+    vi.stubGlobal("location", {
+      search: "?code=authorization-code&state=expected-state",
+      protocol: "http:",
+      hostname: "example.test",
+      origin: "http://example.test",
+    });
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(
+        new Response(
+          JSON.stringify({
+            token,
+            idToken: "authing-id-token",
+          }),
+          { status: 200 },
+        ),
+      ),
+    );
+    const onSessionChange = vi.fn();
+    const unsubscribe = subscribePolarisAuthSession(onSessionChange);
+
+    await expect(completePolarisSignIn()).resolves.toBe("/settings");
+
+    expect(getPolarisAuthToken()).toBe(token);
+    expect(storage.getItem("polaris_authing_id_token")).toBe("authing-id-token");
+    expect(hasPolarisAuthSession()).toBe(true);
+    expect(hasPolarisHostSession()).toBe(true);
+    expect(getPolarisAuthUserScope()).toBe("authing-user-a");
+    expect(onSessionChange).not.toHaveBeenCalled();
+    publishPolarisAuthSession();
+    expect(onSessionChange).toHaveBeenCalledTimes(1);
+    unsubscribe();
+  });
+
+  it("derives the Host registry scope from the authenticated user subject", () => {
+    const storage = installSessionStorage();
+    storage.setItem("polaris_authing_session", portalSessionToken("authing-user-b"));
+
+    expect(getPolarisAuthUserScope()).toBe("authing-user-b");
+    expect(hasPolarisHostSession()).toBe(true);
+
+    clearPolarisSignIn();
+    expect(getPolarisAuthUserScope()).toBeNull();
+    expect(hasPolarisHostSession()).toBe(false);
+  });
+
+  it("treats disabled auth override as an authenticated local session", () => {
+    process.env.EXPO_PUBLIC_POLARIS_AUTH_MODE = "disabled";
+    process.env.EXPO_PUBLIC_POLARIS_AUTH_DEFAULT_USER_ID = "local-dev-admin";
+
+    expect(isPolarisAuthDisabled()).toBe(true);
+    expect(getPolarisAuthToken()).toBe("polaris-disabled-auth-session");
+    expect(hasPolarisAuthSession()).toBe(true);
+    expect(hasPolarisHostSession()).toBe(true);
+    expect(getPolarisAuthUserScope()).toBe("local-dev-admin");
+    expect(resolvePolarisAuthRedirect("/settings", true)).toBeNull();
+    expect(resolvePolarisAuthRedirect("/settings", false)).toBeNull();
+    // Login surfaces are skipped entirely in disabled mode.
+    expect(resolvePolarisAuthRedirect("/welcome", false)).toBe("/settings");
+    expect(resolvePolarisAuthRedirect("/welcome", true)).toBe("/settings");
+    expect(resolvePolarisAuthRedirect("/auth/callback", false)).toBe("/settings");
+  });
+
+  it("ignores sign-in and sign-out when auth is disabled", () => {
+    process.env.EXPO_PUBLIC_POLARIS_AUTH_MODE = "disabled";
+    process.env.EXPO_PUBLIC_POLARIS_AUTH_DEFAULT_USER_ID = "local-dev-admin";
+    const replace = vi.fn();
+    vi.stubGlobal("location", {
+      replace,
+      assign: vi.fn(),
+      pathname: "/welcome",
+      search: "",
+      protocol: "http:",
+      hostname: "example.test",
+      origin: "http://example.test",
+    });
+
+    beginPolarisSignIn();
+    signOutPolaris();
+
+    expect(replace).not.toHaveBeenCalled();
+    expect(getPolarisAuthToken()).toBe("polaris-disabled-auth-session");
+    expect(hasPolarisAuthSession()).toBe(true);
+  });
+
+  it("treats oauth2-proxy sessions as plain username scopes", () => {
+    process.env.EXPO_PUBLIC_POLARIS_AUTH_MODE = "oauth2-proxy";
+    const storage = installSessionStorage();
+    storage.setItem("polaris_authing_session", "authing-user-a");
+
+    expect(getPolarisAuthToken()).toBe("authing-user-a");
+    expect(hasPolarisAuthSession()).toBe(true);
+    expect(hasPolarisHostSession()).toBe(true);
+    expect(getPolarisAuthUserScope()).toBe("authing-user-a");
+  });
+
+  it("accepts callback state from localStorage fallback", async () => {
+    installSessionStorage();
+    const localStorage = installLocalStorage();
+    localStorage.setItem("polaris_authing_pkce_verifier", "verifier");
+    localStorage.setItem("polaris_authing_state", "expected-state");
+    localStorage.setItem("polaris_authing_return_path", "/projects/demo");
