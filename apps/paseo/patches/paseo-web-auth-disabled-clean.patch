+import { isEmbedDevelopmentEnabled } from "@/embed/protocol";
+import { isPolarisAuthDisabled } from "@getpaseo/polaris-auth-client";
+
+export {
+  beginPolarisSignIn,
+  clearPolarisSignIn,
+  completePolarisSignIn,
+  getPolarisAuthToken,
+  getPolarisAuthUserScope,
+  hasPolarisAuthSession,
+  hasPolarisHostSession,
+  isPolarisAuthDisabled,
+  polarisApiBaseUrl,
+  publishPolarisAuthSession,
+  signOutPolaris,
+  subscribePolarisAuthSession,
+  usePolarisAuthSession,
+} from "@getpaseo/polaris-auth-client";
+
+export type PolarisAuthRedirect = "/welcome" | "/settings" | null;
+
+/**
+ * Gate app routes against auth state.
+ *
+ * Disabled mode is always "signed in": never send the user to /welcome, and
+ * bounce them off login-only surfaces to /settings (host sync still runs via
+ * PolarisHostRegistrySync).
+ */
+export function resolvePolarisAuthRedirect(
+  pathname: string,
+  hasSession: boolean,
+): PolarisAuthRedirect {
+  const authenticated = hasSession || isPolarisAuthDisabled();
+
+  if (authenticated) {
+    if (pathname === "/welcome") {
+      return "/settings";
+    }
+    // Disabled mode has no OAuth callback; real Authing still needs /auth/callback.
+    if (pathname === "/auth/callback" && isPolarisAuthDisabled()) {
+      return "/settings";
+    }
+    return null;
+  }
+
+  if (pathname === "/embed" && isEmbedDevelopmentEnabled()) {
+    return null;
+  }
+  if (pathname === "/welcome" || pathname === "/auth/callback") {
+    return null;
+  }
+  return "/welcome";
+}
