--- /dev/null
+++ b/packages/polaris-auth-client/src/index.ts
@@ -0,0 +1,448 @@
+import { useSyncExternalStore } from "react";
+
+const sessionKey = "polaris_authing_session";
+const idTokenKey = "polaris_authing_id_token";
+const verifierKey = "polaris_authing_pkce_verifier";
+const stateKey = "polaris_authing_state";
+const returnPathKey = "polaris_authing_return_path";
+const redirectUriKey = "polaris_authing_redirect_uri";
+const authOverrideCookieKey = "polaris_auth_override";
+const disabledAuthToken = "polaris-disabled-auth-session";
+
+const sessionListeners = new Set<() => void>();
+
+interface PolarisAuthOverride {
+  mode: "disabled";
+  userScope: string;
+}
+
+type PolarisRemoteAuthMode = "authing-browser-session" | "oauth2-proxy" | "disabled";
+
+function resolvePolarisRemoteAuthMode(): PolarisRemoteAuthMode {
+  return (process.env.EXPO_PUBLIC_POLARIS_AUTH_MODE?.trim().toLowerCase() ||
+    "authing-browser-session") as PolarisRemoteAuthMode;
+}
+
+function readTransientAuthValue(key: string): string | null {
+  const sessionValue = sessionStorage.getItem(key)?.trim();
+  if (sessionValue) {
+    return sessionValue;
+  }
+  try {
+    const localValue = localStorage.getItem(key)?.trim();
+    return localValue || null;
+  } catch {
+    return null;
+  }
+}
+
+function writeTransientAuthValue(key: string, value: string): void {
+  sessionStorage.setItem(key, value);
+  try {
+    localStorage.setItem(key, value);
+  } catch {
+    // Ignore storage availability issues in restrictive browsers.
+  }
+}
+
+function clearTransientAuthValue(key: string): void {
+  sessionStorage.removeItem(key);
+  try {
+    localStorage.removeItem(key);
+  } catch {
+    // Ignore storage availability issues in restrictive browsers.
+  }
+}
+
+function notifyPolarisSessionChange(): void {
+  for (const listener of sessionListeners) {
+    listener();
+  }
+}
+
+function readCookieValue(key: string): string | null {
+  if (typeof globalThis.document === "undefined") {
+    return null;
+  }
+  const entry = globalThis.document.cookie
+    .split(";")
+    .map((part) => part.trim())
+    .find((part) => part.startsWith(`${key}=`));
+  if (!entry) {
+    return null;
+  }
+  return decodeURIComponent(entry.slice(key.length + 1).trim()) || null;
+}
+
+function clearCookieValue(key: string): void {
+  if (typeof globalThis.document === "undefined") {
+    return;
+  }
+  globalThis.document.cookie = `${key}=; Max-Age=0; path=/`;
+}
+
+function resolvePolarisAuthOverride(): PolarisAuthOverride | null {
+  const envMode = resolvePolarisRemoteAuthMode();
+  if (envMode === "disabled") {
+    const envUserScope =
+      process.env.EXPO_PUBLIC_POLARIS_AUTH_DEFAULT_USER_ID?.trim() ||
+      "100000000000000001";
+    return {
+      mode: "disabled",
+      userScope: envUserScope,
+    };
+  }
+  const cookieValue = readCookieValue(authOverrideCookieKey);
+  if (!cookieValue?.startsWith("disabled:")) {
+    return null;
+  }
+  const userScope = cookieValue.slice("disabled:".length).trim();
+  if (!userScope) {
+    return null;
+  }
+  return {
+    mode: "disabled",
+    userScope,
+  };
+}
+
+/**
+ * Local-dev / no-IdP mode. The app is permanently signed in as the default
+ * Polaris user: no login wall, no logout, no Authing redirects.
+ */
+export function isPolarisAuthDisabled(): boolean {
+  return resolvePolarisAuthOverride()?.mode === "disabled";
+}
+
+function required(value: string | undefined, name: string): string {
+  const trimmed = value?.trim();
+  if (!trimmed) {
+    throw new Error(`${name} is required`);
+  }
+  return trimmed;
+}
+
+function fallbackCallbackUrl(): string {
+  if (typeof globalThis.location === "undefined") {
+    throw new Error("A browser is required");
+  }
+  return `${globalThis.location.origin}/auth/callback`;
+}
+
+function base64Url(bytes: Uint8Array): string {
+  let value = "";
+  for (const byte of bytes) {
+    value += String.fromCharCode(byte);
+  }
+  return btoa(value).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+function randomBytes(length: number): Uint8Array {
+  const bytes = new Uint8Array(length);
+  if (typeof globalThis.crypto?.getRandomValues === "function") {
+    globalThis.crypto.getRandomValues(bytes);
+    return bytes;
+  }
+  for (let index = 0; index < length; index += 1) {
+    bytes[index] = Math.floor(Math.random() * 256);
+  }
+  return bytes;
+}
+
+async function challenge(
+  verifier: string,
+): Promise<{ value: string; method: "S256" | "plain" }> {
+  if (typeof globalThis.crypto?.subtle?.digest === "function") {
+    return {
+      value: base64Url(
+        new Uint8Array(
+          await globalThis.crypto.subtle.digest(
+            "SHA-256",
+            new TextEncoder().encode(verifier),
+          ),
+        ),
+      ),
+      method: "S256",
+    };
+  }
+  return { value: verifier, method: "plain" };
+}
+
+interface AuthingConfig {
+  authMode: PolarisRemoteAuthMode;
+  appId?: string;
+  authorizationUrl?: string;
+  redirectUri: string;
+  logoutUrl?: string;
+  logoutRedirectUri?: string;
+  signInUrl?: string;
+  signOutUrl?: string;
+}
+
+async function loadAuthingConfig(): Promise<AuthingConfig> {
+  const response = await fetch(`${polarisApiBaseUrl()}/authing-config`);
+  const config = (await response.json().catch(() => ({}))) as Partial<AuthingConfig>;
+  if (!response.ok) {
+    throw new Error("无法加载 Authing 配置");
+  }
+  const authMode = (config.authMode?.trim().toLowerCase() ||
+    resolvePolarisRemoteAuthMode()) as PolarisRemoteAuthMode;
+  if (authMode === "oauth2-proxy") {
+    return {
+      authMode,
+      redirectUri: config.redirectUri?.trim() || fallbackCallbackUrl(),
+      logoutUrl: config.logoutUrl?.trim() || undefined,
+      logoutRedirectUri: config.logoutRedirectUri?.trim() || undefined,
+      signInUrl: config.signInUrl?.trim() || "/oauth2/start",
+      signOutUrl: config.signOutUrl?.trim() || "/oauth2/sign_out",
+    };
+  }
+  return {
+    authMode,
+    appId: required(config.appId, "POLARIS_AUTHING_APP_ID"),
+    authorizationUrl: required(config.authorizationUrl, "POLARIS_AUTHING_AUTHORIZATION_URL"),
+    redirectUri: config.redirectUri?.trim() || fallbackCallbackUrl(),
+    logoutUrl: config.logoutUrl?.trim() || undefined,
+    logoutRedirectUri: config.logoutRedirectUri?.trim() || undefined,
+    signInUrl: config.signInUrl?.trim() || undefined,
+    signOutUrl: config.signOutUrl?.trim() || undefined,
+  };
+}
+
+export function publishPolarisAuthSession(): void {
+  notifyPolarisSessionChange();
+}
+
+export function polarisApiBaseUrl(): string {
+  if (typeof globalThis.location === "undefined") {
+    throw new Error("A browser is required");
+  }
+  const port = process.env.EXPO_PUBLIC_POLARIS_API_PORT?.trim();
+  if (!port) {
+    return `${globalThis.location.origin}/api`;
+  }
+  return `${globalThis.location.protocol}//${globalThis.location.hostname}:${port}/api`;
+}
+
+export function getPolarisAuthToken(): string | null {
+  try {
+    const token = sessionStorage.getItem(sessionKey) || readCookieValue(sessionKey);
+    if (token?.trim()) {
+      return token.replace(/^Bearer\s+/i, "").trim();
+    }
+  } catch {
+    // Ignore browsers that block session storage.
+  }
+  if (resolvePolarisAuthOverride()?.mode === "disabled") {
+    return disabledAuthToken;
+  }
+  return null;
+}
+
+/**
+ * Keep Host storage scoped to the authenticated identity, never to a pairing
+ * URL or a locally remembered host.
+ */
+export function getPolarisAuthUserScope(): string | null {
+  const authOverride = resolvePolarisAuthOverride();
+  if (authOverride?.mode === "disabled") {
+    return authOverride.userScope;
+  }
+  if (resolvePolarisRemoteAuthMode() === "oauth2-proxy") {
+    return getPolarisAuthToken();
+  }
+  const token = getPolarisAuthToken();
+  const payload = token?.split(".")[1];
+  if (!payload) {
+    return null;
+  }
+  try {
+    const normalized = payload.replace(/-/g, "+").replace(/_/g, "/");
+    const padded = normalized + "=".repeat((4 - (normalized.length % 4)) % 4);
+    const decoded = globalThis.atob(padded);
+    const subject = (JSON.parse(decoded) as { sub?: unknown }).sub;
+    return typeof subject === "string" && subject.trim() ? subject.trim() : null;
+  } catch {
+    return null;
+  }
+}
+
+export function hasPolarisAuthSession(): boolean {
+  return Boolean(getPolarisAuthToken());
+}
+
+export function hasPolarisHostSession(): boolean {
+  return Boolean(getPolarisAuthToken() && getPolarisAuthUserScope());
+}
+
+export function subscribePolarisAuthSession(
+  listener: () => void,
+): () => void {
+  sessionListeners.add(listener);
+  return () => sessionListeners.delete(listener);
+}
+
+export function usePolarisAuthSession(): boolean {
+  return useSyncExternalStore(
+    subscribePolarisAuthSession,
+    hasPolarisAuthSession,
+    hasPolarisAuthSession,
+  );
+}
+
+export function beginPolarisSignIn(): void {
+  void (async () => {
+    // Disabled mode is always authenticated. Callers should not show a sign-in
+    // affordance; if they do, stay put instead of bouncing through /settings.
+    if (isPolarisAuthDisabled()) {
+      return;
+    }
+    writeTransientAuthValue(
+      returnPathKey,
+      `${globalThis.location.pathname}${globalThis.location.search}`,
+    );
+    const config = await loadAuthingConfig();
+    if (config.authMode === "oauth2-proxy") {
+      clearTransientAuthValue(verifierKey);
+      clearTransientAuthValue(stateKey);
+      writeTransientAuthValue(redirectUriKey, config.redirectUri);
+      const signInUrl = new URL(config.signInUrl || "/oauth2/start", globalThis.location.origin);
+      signInUrl.searchParams.set("rd", config.redirectUri);
+      globalThis.location.assign(signInUrl.toString());
+      return;
+    }
+    const verifier = base64Url(randomBytes(32));
+    const state = base64Url(randomBytes(24));
+    writeTransientAuthValue(verifierKey, verifier);
+    writeTransientAuthValue(stateKey, state);
+    writeTransientAuthValue(redirectUriKey, config.redirectUri);
+    const authorizationUrl = new URL(config.authorizationUrl);
+    const pkce = await challenge(verifier);
+    authorizationUrl.search = new URLSearchParams({
+      client_id: config.appId,
+      response_type: "code",
+      scope: "openid profile email username phone",
+      redirect_uri: config.redirectUri,
+      state,
+      code_challenge: pkce.value,
+      code_challenge_method: pkce.method,
+    }).toString();
+    globalThis.location.assign(authorizationUrl.toString());
+  })();
+}
+
+export async function completePolarisSignIn(): Promise<string> {
+  const envMode = resolvePolarisRemoteAuthMode();
+  const config = envMode === "oauth2-proxy" ? await loadAuthingConfig().catch(() => null) : null;
+  const params = new URLSearchParams(globalThis.location.search);
+  const code = params.get("code");
+  const state = params.get("state");
+  if ((config?.authMode ?? envMode) === "oauth2-proxy" && !code) {
+    const token =
+      getPolarisAuthToken() ||
+      (await fetch(`${polarisApiBaseUrl()}/session`)
+        .then(async (response) => {
+          const body = (await response.json().catch(() => ({}))) as {
+            authingUserId?: string;
+            authingUsername?: string | null;
+            error?: string;
+          };
+          if (!response.ok) {
+            throw new Error(body.error || "Authing 登录未完成");
+          }
+          return body.authingUserId?.trim() || body.authingUsername?.trim() || null;
+        })
+        .catch(() => null));
+    if (!token) {
+      throw new Error("Authing 登录未完成");
+    }
+    sessionStorage.setItem(sessionKey, token);
+    clearTransientAuthValue(verifierKey);
+    clearTransientAuthValue(stateKey);
+    clearTransientAuthValue(redirectUriKey);
+    const returnPath = readTransientAuthValue(returnPathKey);
+    return returnPath && returnPath !== "/welcome" ? returnPath : "/settings";
+  }
+  const verifier = readTransientAuthValue(verifierKey);
+  if (!code || !verifier || state !== readTransientAuthValue(stateKey)) {
+    throw new Error("Authing 登录状态无效，请重新登录");
+  }
+  const response = await fetch(`${polarisApiBaseUrl()}/auth/callback`, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({
+      code,
+      codeVerifier: verifier,
+      redirectUri: readTransientAuthValue(redirectUriKey) || fallbackCallbackUrl(),
+    }),
+  });
+  const payload = (await response.json().catch(() => ({}))) as {
+    token?: string;
+    idToken?: string;
+    error?: string;
+  };
+  if (!response.ok || !payload.token?.trim()) {
+    throw new Error(payload.error || "Authing 登录未完成");
+  }
+  sessionStorage.setItem(sessionKey, payload.token);
+  if (payload.idToken?.trim()) {
+    sessionStorage.setItem(idTokenKey, payload.idToken.trim());
+  }
+  clearTransientAuthValue(verifierKey);
+  clearTransientAuthValue(stateKey);
+  clearTransientAuthValue(redirectUriKey);
+  const returnPath = readTransientAuthValue(returnPathKey);
+  return returnPath && returnPath !== "/welcome" ? returnPath : "/settings";
+}
+
+export function clearPolarisSignIn(options?: {
+  notify?: boolean;
+  preserveCookie?: boolean;
+}): void {
+  sessionStorage.removeItem(sessionKey);
+  sessionStorage.removeItem(idTokenKey);
+  if (!options?.preserveCookie) {
+    clearCookieValue(sessionKey);
+  }
+  clearTransientAuthValue(verifierKey);
+  clearTransientAuthValue(stateKey);
+  clearTransientAuthValue(redirectUriKey);
+  clearTransientAuthValue(returnPathKey);
+  if (options?.notify !== false) {
+    notifyPolarisSessionChange();
+  }
+}
+
+export function signOutPolaris(): void {
+  void (async () => {
+    // There is no real session to clear in disabled mode; pretend-logout only
+    // confuses navigation (token still resolves, welcome/settings loop).
+    if (isPolarisAuthDisabled()) {
+      return;
+    }
+    const config = await loadAuthingConfig().catch(() => null);
+    const idToken = sessionStorage.getItem(idTokenKey)?.trim();
+    if ((config?.authMode ?? resolvePolarisRemoteAuthMode()) === "oauth2-proxy") {
+      const proxyLogoutUrl = new URL(config?.signOutUrl || "/oauth2/sign_out", globalThis.location.origin);
+      proxyLogoutUrl.searchParams.set("rd", "/welcome");
+      clearPolarisSignIn({ notify: false, preserveCookie: true });
+      globalThis.location.replace(proxyLogoutUrl.toString());
+      return;
+    }
+    if (config?.logoutUrl) {
+      const logoutUrl = new URL(config.logoutUrl);
+      if (idToken) {
+        logoutUrl.searchParams.set("id_token_hint", idToken);
+      }
+      logoutUrl.searchParams.set(
+        "post_logout_redirect_uri",
+        config.logoutRedirectUri || globalThis.location.origin,
+      );
+      clearPolarisSignIn({ notify: false });
+      globalThis.location.replace(logoutUrl.toString());
+      return;
+    }
+    clearPolarisSignIn();
+    globalThis.location.replace("/welcome");
+  })();
+}
