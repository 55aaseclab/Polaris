@@ -0,0 +1,32 @@
+import { describe, expect, it } from "vitest";
+import type { HostProfile } from "@/types/host-connection";
+import { filterHostsForPolarisSession } from "./host-runtime";
+
+function makeHost(): HostProfile {
+  return {
+    serverId: "srv_1",
+    label: "Host 1",
+    lifecycle: {},
+    connections: [],
+    preferredConnectionId: null,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+  };
+}
+
+describe("host runtime auth visibility", () => {
+  it("hides hosts for anonymous users with a stable empty snapshot", () => {
+    const hosts = [makeHost()];
+    const first = filterHostsForPolarisSession(hosts, false);
+    const second = filterHostsForPolarisSession(hosts, false);
+    expect(first).toEqual([]);
+    // useSyncExternalStore requires referential stability across getSnapshot
+    // calls when the underlying data has not changed.
+    expect(first).toBe(second);
+  });
+
+  it("keeps the same host list reference for authenticated users", () => {
+    const hosts = [makeHost()];
+    expect(filterHostsForPolarisSession(hosts, true)).toBe(hosts);
+  });
+});
