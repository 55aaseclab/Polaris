+// Stable empty snapshot for useSyncExternalStore. Returning a fresh [] on
+// every getSnapshot call causes an infinite re-render loop.
+const EMPTY_POLARIS_HOSTS: HostProfile[] = [];
+
+export function filterHostsForPolarisSession(
+  hosts: HostProfile[],
+  hasPolarisSession: boolean,
+): HostProfile[] {
+  // Preserve the store reference when authenticated so subscribers only
+  // re-render when the host list itself changes.
+  return hasPolarisSession ? hosts : EMPTY_POLARIS_HOSTS;
+}
