+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { HostProfile } from "@/types/host-connection";
+
+const asyncStorage = vi.hoisted(() => {
+  const values = new Map<string, string>();
+  return {
+    values,
+    getItem: vi.fn(async (key: string) => values.get(key) ?? null),
+    setItem: vi.fn(async (key: string, value: string) => {
+      values.set(key, value);
+    }),
+    removeItem: vi.fn(async (key: string) => {
+      values.delete(key);
+    }),
+  };
+});
+
+vi.mock("@react-native-async-storage/async-storage", () => ({
+  default: {
+    getItem: asyncStorage.getItem,
+    setItem: asyncStorage.setItem,
+    removeItem: asyncStorage.removeItem,
+  },
+}));
+
+import { filterHostsForPolarisSession, HostRuntimeStore } from "./host-runtime";
+
+function portalSessionToken(subject: string): string {
+  const payload = Buffer.from(JSON.stringify({ sub: subject }))
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+  return `header.${payload}.signature`;
+}
+
+function installAuthenticatedBrowser(subject: string, href: string): void {
+  const sessionStorageValues = new Map<string, string>();
+  const sessionStorage = {
+    getItem: (key: string) => sessionStorageValues.get(key) ?? null,
+    setItem: (key: string, value: string) => {
+      sessionStorageValues.set(key, value);
+    },
+    removeItem: (key: string) => {
+      sessionStorageValues.delete(key);
+    },
+  };
+  sessionStorage.setItem("polaris_authing_session", portalSessionToken(subject));
+  vi.stubGlobal("sessionStorage", sessionStorage);
+  vi.stubGlobal("window", {
+    location: { href },
+    sessionStorage,
+  });
+}
+
+afterEach(() => {
+  asyncStorage.values.clear();
+  asyncStorage.getItem.mockClear();
+  asyncStorage.setItem.mockClear();
+  asyncStorage.removeItem.mockClear();
+  vi.unstubAllGlobals();
+});
+
+function makeHost(): HostProfile {
+  return {
+    serverId: "srv_1",
+    label: "Host 1",
+    lifecycle: {},
+    connections: [],
+    preferredConnectionId: null,
+    createdAt: "2026-01-01T00:00:00.000Z",
+    updatedAt: "2026-01-01T00:00:00.000Z",
+  };
+}
+
+describe("host runtime auth visibility", () => {
+  it("hides hosts for anonymous users with a stable empty snapshot", () => {
+    const hosts = [makeHost()];
+    const first = filterHostsForPolarisSession(hosts, false);
+    const second = filterHostsForPolarisSession(hosts, false);
+    expect(first).toEqual([]);
+    // useSyncExternalStore requires referential stability across getSnapshot
+    // calls when the underlying data has not changed.
+    expect(first).toBe(second);
+  });
+
+  it("keeps the same host list reference for authenticated users", () => {
+    const hosts = [makeHost()];
+    expect(filterHostsForPolarisSession(hosts, true)).toBe(hosts);
+  });
+
+  it("never loads a previous user's scoped or legacy Host registry", async () => {
+    installAuthenticatedBrowser(
+      "new-user",
+      "https://polaris.example/h/srv_previous?scope=previous-user%3Aworkspace-a",
+    );
+    const previousHost = makeHost();
+    asyncStorage.values.set(
+      "@paseo:daemon-registry:scope:previous-user%3Aworkspace-a",
+      JSON.stringify([previousHost]),
+    );
+    asyncStorage.values.set("@paseo:daemon-registry", JSON.stringify([previousHost]));
+
+    const store = new HostRuntimeStore();
+    store.boot();
+
+    await vi.waitFor(() => {
+      expect(store.getHostRegistryStatus()).toBe("ready");
+    });
+
+    expect(store.getHosts()).toEqual([]);
+    expect(asyncStorage.getItem).toHaveBeenCalledWith(
+      "@paseo:daemon-registry:user:new-user:scope:previous-user%3Aworkspace-a:host:srv_previous",
+    );
+    expect(asyncStorage.getItem).not.toHaveBeenCalledWith(
+      "@paseo:daemon-registry:scope:previous-user%3Aworkspace-a",
+    );
+    expect(asyncStorage.getItem).not.toHaveBeenCalledWith("@paseo:daemon-registry");
+  });
+
+  it("uses the web scope together with the authenticated user scope", async () => {
+    installAuthenticatedBrowser(
+      "new-user",
+      "https://polaris.example/h/srv_current?scope=new-user%3Aworkspace-a",
+    );
+    const scopedHost = {
+      ...makeHost(),
+      serverId: "srv_current",
+      connections: [
+        {
+          id: "direct:lan:6767",
+          type: "directTcp",
+          endpoint: "lan:6767",
+          useTls: false,
+        },
+      ],
+      preferredConnectionId: "direct:lan:6767",
+    };
+    asyncStorage.values.set(
+      "@paseo:daemon-registry:user:new-user:scope:new-user%3Aworkspace-a:host:srv_current",
+      JSON.stringify([scopedHost]),
+    );
+    asyncStorage.values.set(
+      "@paseo:daemon-registry:user:new-user",
+      JSON.stringify([
+        {
+          ...makeHost(),
+          connections: [
+            {
+              id: "direct:lan:6767",
+              type: "directTcp",
+              endpoint: "lan:6767",
+              useTls: false,
+            },
+          ],
+          preferredConnectionId: "direct:lan:6767",
+          serverId: "srv_other",
+        },
+      ]),
+    );
+
+    const store = new HostRuntimeStore();
+    store.boot();
+
+    await vi.waitFor(() => {
+      expect(store.getHostRegistryStatus()).toBe("ready");
+    });
+
+    expect(store.getHosts()).toEqual([scopedHost]);
+    expect(asyncStorage.getItem).toHaveBeenCalledWith(
