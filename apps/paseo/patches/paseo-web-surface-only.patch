diff --git a/packages/app/src/screens/open-project-shell-transfer.test.ts b/packages/app/src/screens/open-project-shell-transfer.test.ts
new file mode 100644
index 0000000..fd64566
--- /dev/null
+++ b/packages/app/src/screens/open-project-shell-transfer.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it } from "vitest";
+import {
+  normalizeShellAutoProject,
+  normalizeShellReturnPath,
+} from "./open-project-shell-transfer";
+
+describe("open-project shell transfer helpers", () => {
+  it("accepts same-origin shell return paths only", () => {
+    expect(normalizeShellReturnPath("/hosts/demo")).toBe("/hosts/demo");
+    expect(normalizeShellReturnPath(" /hosts/demo ")).toBe("/hosts/demo");
+    expect(normalizeShellReturnPath("https://example.com/hosts/demo")).toBeNull();
+    expect(normalizeShellReturnPath("//evil.test")).toBeNull();
+    expect(normalizeShellReturnPath("hosts/demo")).toBeNull();
+  });
+
+  it("builds an auto-project request only when a path is present", () => {
+    expect(
+      normalizeShellAutoProject({
+        projectPath: "/root/workspace",
+        returnTo: "/hosts/demo",
+      }),
+    ).toEqual({
+      projectPath: "/root/workspace",
+      returnTo: "/hosts/demo",
+    });
+    expect(normalizeShellAutoProject({ projectPath: "   " })).toBeNull();
+  });
+});
diff --git a/packages/app/src/screens/open-project-shell-transfer.ts b/packages/app/src/screens/open-project-shell-transfer.ts
new file mode 100644
index 0000000..2abf24d
--- /dev/null
+++ b/packages/app/src/screens/open-project-shell-transfer.ts
@@ -0,0 +1,30 @@
+export interface ShellAutoProjectInput {
+  projectPath?: string | null;
+  returnTo?: string | null;
+}
+
+export interface ShellAutoProjectConfig {
+  projectPath: string;
+  returnTo: string | null;
+}
+
+export function normalizeShellReturnPath(value: string | null | undefined): string | null {
+  const trimmed = String(value ?? "").trim();
+  if (!trimmed || !trimmed.startsWith("/") || trimmed.startsWith("//")) {
+    return null;
+  }
+  return trimmed;
+}
+
+export function normalizeShellAutoProject(
+  input: ShellAutoProjectInput,
+): ShellAutoProjectConfig | null {
+  const projectPath = String(input.projectPath ?? "").trim();
+  if (!projectPath) {
+    return null;
+  }
+  return {
+    projectPath,
+    returnTo: normalizeShellReturnPath(input.returnTo),
+  };
+}
