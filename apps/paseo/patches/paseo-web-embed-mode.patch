index 0000000..2d17065
--- /dev/null
+++ b/packages/app/src/embed/workspace.ts
@@ -0,0 +1,82 @@
+import type { DaemonClient } from "@getpaseo/client/internal/daemon-client";
+import type { AgentProvider, ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import type { PaseoEmbedDefaultModel, PaseoEmbedWorkspaceRequest } from "./protocol";
+
+export interface EmbedAgentDefaults {
+  provider: AgentProvider;
+  model?: string;
+  modeId?: string;
+  thinkingOptionId?: string;
+}
+
+export const DEFAULT_EMBED_AGENT_MODEL: PaseoEmbedDefaultModel = {
+  provider: "codex",
+  model: "gpt-5.4",
+  thinkingOptionId: "medium",
+};
+
+export type EmbedWorkspaceClient = Pick<
+  DaemonClient,
+  "createAgent" | "createWorkspace" | "getProvidersSnapshot"
+>;
+
+export function resolveEmbedAgentDefaults(
+  entries: readonly ProviderSnapshotEntry[],
+  requested?: PaseoEmbedDefaultModel,
+): EmbedAgentDefaults {
+  const requestedModel = requested ?? DEFAULT_EMBED_AGENT_MODEL;
+  const requestedEntry = entries.find(
+    (candidate) => candidate.provider === requestedModel.provider,
+  );
+  if (requestedModel.provider) {
+    const availableModels = requestedEntry?.models ?? [];
+    const model =
+      requestedModel.model ??
+      availableModels.find((candidate) => candidate.isDefault)?.id ??
+      availableModels[0]?.id;
+    const selectedModel = availableModels.find((candidate) => candidate.id === model);
+    return {
+      provider: requestedModel.provider,
+      ...(model ? { model } : {}),
+      ...(requestedEntry?.defaultModeId ? { modeId: requestedEntry.defaultModeId } : {}),
+      ...(requestedModel.thinkingOptionId
+        ? { thinkingOptionId: requestedModel.thinkingOptionId }
+        : selectedModel?.defaultThinkingOptionId
+          ? { thinkingOptionId: selectedModel.defaultThinkingOptionId }
+          : {}),
+    };
+  }
+
+  throw new Error("No default provider is configured for the embedded workspace.");
+}
+
+export async function createEmbeddedWorkspaceAgent(input: {
+  client: EmbedWorkspaceClient;
+  request: PaseoEmbedWorkspaceRequest;
+}): Promise<{ agentId: string; workspaceId: string }> {
+  const createdWorkspace = await input.client.createWorkspace({
+    source: { kind: "directory", path: input.request.path },
+    ...(input.request.title ? { title: input.request.title } : {}),
+  });
+  const workspace = createdWorkspace.workspace;
+  if (!workspace) {
+    throw new Error(createdWorkspace.error ?? "The embedded workspace could not be created.");
+  }
+
+  const cwd = workspace.workspaceDirectory?.trim();
+  if (!cwd) {
+    throw new Error("The created workspace does not have a directory.");
+  }
+
+  const providers = await input.client.getProvidersSnapshot({ cwd });
+  const defaults = resolveEmbedAgentDefaults(providers.entries, input.request.defaultModel);
+  const agent = await input.client.createAgent({
+    provider: defaults.provider,
+    cwd,
+    workspaceId: workspace.id,
+    ...(defaults.model ? { model: defaults.model } : {}),
+    ...(defaults.modeId ? { modeId: defaults.modeId } : {}),
+    ...(defaults.thinkingOptionId ? { thinkingOptionId: defaults.thinkingOptionId } : {}),
+  });
+  return { agentId: agent.id, workspaceId: workspace.id };
+}
