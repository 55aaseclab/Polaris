diff --git a/packages/app/src/app/embed.tsx b/packages/app/src/app/embed.tsx
new file mode 100644
index 0000000..4da0b7b
--- /dev/null
+++ b/packages/app/src/app/embed.tsx
@@ -0,0 +1,376 @@
+import { useEffect, useRef, useState, useSyncExternalStore } from "react";
+import { ActivityIndicator, Pressable, ScrollView, StyleSheet, Text, View } from "react-native";
+import { useLocalSearchParams } from "expo-router";
+import { useUnistyles } from "react-native-unistyles";
+import { SessionProvider } from "@/contexts/session-context";
+import {
+  buildWorkspaceAttachmentScopeKey,
+  useWorkspaceAttachmentsStore,
+} from "@/attachments/workspace-attachments-store";
+import { usePaseoEmbedBridge } from "@/embed/bridge";
+import {
+  isEmbedDevelopmentEnabled,
+  type PaseoEmbedContext,
+  type PaseoEmbedWorkspaceRequest,
+} from "@/embed/protocol";
+import { createEmbeddedWorkspaceAgent } from "@/embed/workspace";
+import { EmbeddedAgentPanel } from "@/embed/embedded-agent-panel";
+import {
+  getHostRuntimeStore,
+  useHostRuntimeClient,
+  useHostRuntimeIsConnected,
+} from "@/runtime/host-runtime";
+import { usePolarisAuthSession } from "@/lib/polaris-authing";
+
+interface AgentOption {
+  id: string;
+  title: string;
+}
+
+interface AgentScope {
+  cwd: string;
+  workspaceId: string | null;
+}
+
+type WorkspaceSetupState = "idle" | "creating" | "error" | "ready";
+
+function firstParam(value: string | string[] | undefined): string {
+  if (typeof value === "string") {
+    return value.trim();
+  }
+  if (Array.isArray(value)) {
+    return value[0]?.trim() ?? "";
+  }
+  return "";
+}
+
+function normalizeAgentOptions(
+  entries: Array<{ agent: { id: string; title?: string | null } }>,
+): AgentOption[] {
+  return entries.map((entry) => ({
+    id: entry.agent.id,
+    title: entry.agent.title?.trim() || entry.agent.id,
+  }));
+}
+
+export default function EmbedRoute() {
+  const params = useLocalSearchParams<{
+    agentId?: string | string[];
+    endpoint?: string | string[];
+    parentOrigin?: string | string[];
+    nonce?: string | string[];
+    serverId?: string | string[];
+  }>();
+  const { theme } = useUnistyles();
+  const requestedServerId = firstParam(params.serverId);
+  const requestedAgentId = firstParam(params.agentId);
+  const requestedEndpoint = firstParam(params.endpoint);
+  const parentOrigin = firstParam(params.parentOrigin);
+  const nonce = firstParam(params.nonce);
+  const endpoint = requestedEndpoint || (isEmbedDevelopmentEnabled() ? "localhost:6767" : "");
+  const hostRuntimeStore = getHostRuntimeStore();
+  const runtimeHosts = useSyncExternalStore(
+    (onStoreChange) => hostRuntimeStore.subscribeHostList(onStoreChange),
+    () => hostRuntimeStore.getHosts(),
+    () => hostRuntimeStore.getHosts(),
+  );
+
+  const [serverId, setServerId] = useState(requestedServerId || "");
+  const [agentId, setAgentId] = useState(requestedAgentId || "");
+  const [agentOptions, setAgentOptions] = useState<AgentOption[]>([]);
+  const [agentScope, setAgentScope] = useState<AgentScope | null>(null);
+  const [context, setContext] = useState<PaseoEmbedContext | null>(null);
+  const [workspaceRequest, setWorkspaceRequest] = useState<PaseoEmbedWorkspaceRequest | null>(
+    null,
+  );
+  const [workspaceSetupState, setWorkspaceSetupState] = useState<WorkspaceSetupState>("idle");
+  const [workspaceSetupError, setWorkspaceSetupError] = useState<string | null>(null);
+  const endpointProbeRef = useRef<string | null>(null);
+  const workspaceSetupRequestRef = useRef<string | null>(null);
+
+  const runtimeClient = useHostRuntimeClient(serverId);
+  const isConnected = useHostRuntimeIsConnected(serverId);
+  const hasPolarisSession = usePolarisAuthSession();
+
+  const embedBridge = usePaseoEmbedBridge({
+    parentOrigin,
+    nonce,
+    onContext: setContext,
+    onWorkspaceCreate: setWorkspaceRequest,
+  });
+
+  useEffect(() => {
+    if (requestedServerId) {
+      setServerId(requestedServerId);
+    }
+  }, [requestedServerId]);
+
+  useEffect(() => {
+    if (requestedAgentId) {
+      setAgentId(requestedAgentId);
+    }
+  }, [requestedAgentId]);
+
+  useEffect(() => {
+    if (serverId || requestedServerId || !endpoint || !isEmbedDevelopmentEnabled()) {
+      return;
+    }
+    const localHost = runtimeHosts.find((host) =>
+      host.connections.some(
+        (connection) => connection.type === "directTcp" && connection.endpoint === endpoint,
+      ),
+    );
+    if (localHost) {
+      setServerId(localHost.serverId);
+      return;
+    }
+
+    if (endpointProbeRef.current === endpoint) {
+      return;
+    }
+    endpointProbeRef.current = endpoint;
+    void hostRuntimeStore
+      .probeAndUpsertDirectConnection({
+        endpoint,
+        label: "Embedded Paseo host",
+      })
+      .then(({ serverId: discoveredServerId }) => {
+        if (endpointProbeRef.current === endpoint) {
+          setServerId(discoveredServerId);
+        }
+      })
+      .catch(() => {
+        if (endpointProbeRef.current === endpoint) {
+          endpointProbeRef.current = null;
+        }
+      });
+  }, [endpoint, requestedServerId, runtimeHosts, serverId]);
+
+  useEffect(() => {
+    if (!runtimeClient || !isConnected) {
+      return;
+    }
+
+    let disposed = false;
+    void runtimeClient
+      .fetchAgents({ scope: "active", page: { limit: 50 } })
+      .then((result) => {
+        if (disposed) {
+          return;
+        }
+        const options = normalizeAgentOptions(result.entries);
+        setAgentOptions(options);
+      })
+      .catch(() => {
+        if (!disposed) {
+          setAgentOptions([]);
+        }
+      });
+
+    return () => {
+      disposed = true;
+    };
+  }, [agentId, isConnected, runtimeClient]);
+
+  useEffect(() => {
+    if (!workspaceRequest || !runtimeClient || !isConnected) {
+      return;
+    }
+    if (workspaceSetupRequestRef.current === workspaceRequest.requestId) {
+      return;
+    }
+
+    const requestId = workspaceRequest.requestId;
+    workspaceSetupRequestRef.current = requestId;
+    setWorkspaceSetupState("creating");
+    setWorkspaceSetupError(null);
+    void createEmbeddedWorkspaceAgent({ client: runtimeClient, request: workspaceRequest })
+      .then(({ agentId: createdAgentId, workspaceId: createdWorkspaceId }) => {
+        if (workspaceSetupRequestRef.current !== requestId) {
+          return;
+        }
+        setAgentId(createdAgentId);
+        setWorkspaceSetupState("ready");
+        embedBridge.reportWorkspaceCreated({
+          requestId,
+          workspaceId: createdWorkspaceId,
+          agentId: createdAgentId,
+        });
+      })
+      .catch((error) => {
+        if (workspaceSetupRequestRef.current !== requestId) {
+          return;
+        }
+        const message = error instanceof Error ? error.message : String(error);
+        setWorkspaceSetupState("error");
+        setWorkspaceSetupError(message);
+        embedBridge.reportWorkspaceFailed({ requestId, error: message });
+      });
+  }, [embedBridge, isConnected, runtimeClient, workspaceRequest]);
+
+  useEffect(() => {
+    if (!runtimeClient || !isConnected || !agentId) {
+      setAgentScope(null);
+      return;
+    }
+
+    let disposed = false;
+    void runtimeClient
+      .fetchAgent(agentId)
+      .then((result) => {
+        if (disposed) {
+          return;
+        }
+        const agent = result?.agent;
+        setAgentScope(
+          agent?.cwd ? { cwd: agent.cwd, workspaceId: agent.workspaceId ?? null } : null,
+        );
+      })
+      .catch(() => {
+        if (!disposed) {
+          setAgentScope(null);
+        }
+      });
+
+    return () => {
+      disposed = true;
+    };
+  }, [agentId, isConnected, runtimeClient]);
+
+  useEffect(() => {
+    if (!context || !serverId || !agentScope) {
+      return;
+    }
+
+    const scopeKey = buildWorkspaceAttachmentScopeKey({
+      serverId,
+      workspaceId: agentScope.workspaceId,
+      cwd: agentScope.cwd,
+    });
+    useWorkspaceAttachmentsStore.getState().setExternalContextAttachment({
+      scopeKey,
+      attachment: {
+        kind: "external_context",
+        source: context.source,
+        id: `${context.kind}:${context.id}`,
+        title: context.title,
+        ...(context.subtitle ? { subtitle: context.subtitle } : {}),
+        text: context.text,
+        ...(context.url ? { url: context.url } : {}),
+      },
+    });
+  }, [agentScope, context, serverId]);
+
+  const isCreatingWorkspace = workspaceSetupState === "creating";
+  const emptyTitle = isCreatingWorkspace ? "Creating workspace" : "Choose an agent";
+  const emptyBody = !serverId
+    ? "The embedded panel is connecting to the local Paseo daemon."
+    : isCreatingWorkspace
+      ? `Creating ${workspaceRequest?.title || workspaceRequest?.path || "workspace"}.`
+      : workspaceSetupError ??
+        "This local daemon has no active agent yet. Ask the embedding app to create one.";
+
+  const content = (
+    <View style={[styles.root, { backgroundColor: theme.colors.surface0 }]}>
+      {!serverId || (!agentId && isConnected) ? (
+        <ScrollView contentContainerStyle={styles.emptyContent}>
+          {!serverId || isCreatingWorkspace ? (
+            <ActivityIndicator color={theme.colors.foregroundMuted} />
+          ) : null}
+          <Text style={[styles.emptyTitle, { color: theme.colors.foreground }]}>
+            {emptyTitle}
+          </Text>
+          <Text style={[styles.emptyBody, { color: theme.colors.foregroundMuted }]}>
+            {emptyBody}
+          </Text>
+          {agentOptions.length > 0 ? (
+            <View style={styles.agentList}>
+              {agentOptions.map((agent) => (
+                <Pressable
+                  key={agent.id}
+                  onPress={() => setAgentId(agent.id)}
+                  style={[
+                    styles.agentButton,
+                    { borderColor: theme.colors.border, backgroundColor: theme.colors.surface1 },
+                  ]}
+                >
+                  <Text
+                    numberOfLines={1}
+                    style={[styles.agentButtonText, { color: theme.colors.foreground }]}
+                  >
+                    {agent.title}
+                  </Text>
+                </Pressable>
+              ))}
+            </View>
+          ) : null}
+        </ScrollView>
+      ) : (
+        <View style={styles.agentPanel}>
+          <EmbeddedAgentPanel
+            serverId={serverId}
+            workspaceId={agentScope?.workspaceId ?? agentId}
+            agentId={agentId}
+            onAgentChange={setAgentId}
+          />
+        </View>
+      )}
+    </View>
+  );
+
+  // Normal authenticated routes are already covered by HostSessionManager.
+  // The local development embed route is intentionally public, so it mounts
+  // its own provider to keep the daemon session and agent directory alive.
+  if (!hasPolarisSession && runtimeClient && serverId) {
+    return (
+      <SessionProvider serverId={serverId} client={runtimeClient}>
+        {content}
+      </SessionProvider>
+    );
+  }
+
+  return content;
+}
+
+const styles = StyleSheet.create({
+  root: {
+    flex: 1,
+    minHeight: 0,
+  },
+  emptyContent: {
+    alignItems: "center",
+    flexGrow: 1,
+    justifyContent: "center",
+    padding: 28,
+  },
+  emptyTitle: {
+    fontSize: 16,
+    fontWeight: "700",
+    marginTop: 14,
+  },
+  emptyBody: {
+    fontSize: 13,
+    lineHeight: 20,
+    marginTop: 7,
+    maxWidth: 320,
+    textAlign: "center",
+  },
+  agentList: {
+    alignSelf: "stretch",
+    gap: 8,
+    marginTop: 18,
+  },
+  agentButton: {
+    borderWidth: StyleSheet.hairlineWidth,
+    paddingHorizontal: 12,
+    paddingVertical: 10,
+  },
+  agentButtonText: {
+    fontSize: 13,
+    fontWeight: "600",
+  },
+  agentPanel: {
+    flex: 1,
+    minHeight: 0,
+  },
+});
