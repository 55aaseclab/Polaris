+import type { PaseoEmbedBridge, PaseoEmbedBridgeOptions } from "./bridge.shared";
+
+const noopEmbedBridge: PaseoEmbedBridge = {
+  reportWorkspaceCreated: () => {},
+  reportWorkspaceFailed: () => {},
+};
+
+// Expo resolves bridge.web.ts or bridge.native.ts at runtime. This fallback
+// keeps non-platform-aware TypeScript tooling able to resolve the module.
+export function usePaseoEmbedBridge(_input: PaseoEmbedBridgeOptions): PaseoEmbedBridge {
+  return noopEmbedBridge;
+}
