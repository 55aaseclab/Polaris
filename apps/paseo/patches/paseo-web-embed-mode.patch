+import type {
+  PaseoEmbedContext,
+  PaseoEmbedWorkspaceRequest,
+  PaseoEmbedWorkspaceCreatedMessage,
+  PaseoEmbedWorkspaceFailedMessage,
+} from "./protocol";
+
+export interface PaseoEmbedBridgeOptions {
+  parentOrigin?: string;
+  nonce?: string;
+  onContext: (context: PaseoEmbedContext) => void;
+  onWorkspaceCreate?: (workspace: PaseoEmbedWorkspaceRequest) => void;
+}
+
+export interface PaseoEmbedBridge {
+  reportWorkspaceCreated: (
+    message: Omit<
+      PaseoEmbedWorkspaceCreatedMessage,
+      "type" | "version" | "nonce"
+    >,
+  ) => void;
+  reportWorkspaceFailed: (
+    message: Omit<PaseoEmbedWorkspaceFailedMessage, "type" | "version" | "nonce">,
+  ) => void;
+}
