+import { describe, expect, it } from "vitest";
+import {
+  PASEO_EMBED_CREATE_WORKSPACE,
+  PASEO_EMBED_PROTOCOL_VERSION,
+  PASEO_EMBED_SET_CONTEXT,
+  configuredEmbedParentOrigins,
+  parsePaseoEmbedCreateWorkspaceMessage,
+  parsePaseoEmbedSetContextMessage,
+  resolveEmbedParentOrigin,
+} from "./protocol";
+
+describe("Paseo embed protocol", () => {
+  it("allows any origin from the configured parent-origin list", () => {
+    const previous = process.env.EXPO_PUBLIC_PASEO_EMBED_PARENT_ORIGIN;
+    process.env.EXPO_PUBLIC_PASEO_EMBED_PARENT_ORIGIN = [
+      "https://portal-one.example.test",
+      "https://portal-two.example.test/path",
+      "not an origin",
+    ].join(",");
+
+    try {
+      expect(
+        [...configuredEmbedParentOrigins(process.env.EXPO_PUBLIC_PASEO_EMBED_PARENT_ORIGIN)],
+      ).toEqual([
+        "https://portal-one.example.test",
+        "https://portal-two.example.test",
+      ]);
+      expect(resolveEmbedParentOrigin("https://portal-two.example.test/workflows")).toBe(
+        "https://portal-two.example.test",
+      );
+      expect(resolveEmbedParentOrigin("https://unknown.example.test")).toBeNull();
+    } finally {
+      if (previous === undefined) {
+        delete process.env.EXPO_PUBLIC_PASEO_EMBED_PARENT_ORIGIN;
+      } else {
+        process.env.EXPO_PUBLIC_PASEO_EMBED_PARENT_ORIGIN = previous;
+      }
+    }
+  });
+
+  it("accepts a valid host context message", () => {
+    expect(
+      parsePaseoEmbedSetContextMessage({
+        type: PASEO_EMBED_SET_CONTEXT,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+        context: {
+          source: "portal",
+          kind: "order",
+          id: "order-42",
+          title: "Order 42",
+          subtitle: "Manual review",
+          text: "Review the current order before release.",
+          url: "/orders/order-42",
+        },
+      }),
+    ).toEqual({
+      type: PASEO_EMBED_SET_CONTEXT,
+      version: PASEO_EMBED_PROTOCOL_VERSION,
+      nonce: "nonce-1",
+      context: {
+        source: "portal",
+        kind: "order",
+        id: "order-42",
+        title: "Order 42",
+        subtitle: "Manual review",
+        text: "Review the current order before release.",
+        url: "/orders/order-42",
+      },
+    });
+  });
+
+  it("rejects malformed or oversized host context", () => {
+    expect(parsePaseoEmbedSetContextMessage({ type: PASEO_EMBED_SET_CONTEXT })).toBeNull();
+    expect(
+      parsePaseoEmbedSetContextMessage({
+        type: PASEO_EMBED_SET_CONTEXT,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+        context: {
+          source: "portal",
+          kind: "order",
+          id: "order-42",
+          title: "Order 42",
+          text: "x".repeat(32_001),
+        },
+      }),
+    ).toBeNull();
+  });
+
+  it("accepts an external workspace request with a default model", () => {
+    expect(
+      parsePaseoEmbedCreateWorkspaceMessage({
+        type: PASEO_EMBED_CREATE_WORKSPACE,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+        workspace: {
+          requestId: "workspace-request-1",
+          path: "/tmp/embed-fixture",
+          title: "Embedded fixture",
+          defaultModel: {
+            provider: "codex",
+            model: "model-fast",
+            thinkingOptionId: "medium",
+          },
+        },
+      }),
+    ).toEqual({
+      type: PASEO_EMBED_CREATE_WORKSPACE,
+      version: PASEO_EMBED_PROTOCOL_VERSION,
+      nonce: "nonce-1",
+      workspace: {
+        requestId: "workspace-request-1",
+        path: "/tmp/embed-fixture",
+        title: "Embedded fixture",
+        defaultModel: {
+          provider: "codex",
+          model: "model-fast",
+          thinkingOptionId: "medium",
+        },
+      },
+    });
+  });
+
+  it("rejects a workspace request without a path or model provider", () => {
+    expect(
+      parsePaseoEmbedCreateWorkspaceMessage({
+        type: PASEO_EMBED_CREATE_WORKSPACE,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+        workspace: { requestId: "workspace-request-1", path: "" },
+      }),
+    ).toBeNull();
+    expect(
+      parsePaseoEmbedCreateWorkspaceMessage({
+        type: PASEO_EMBED_CREATE_WORKSPACE,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+        workspace: {
+          requestId: "workspace-request-1",
+          path: "/tmp/embed-fixture",
+          defaultModel: { model: "model-fast" },
+        },
+      }),
+    ).toBeNull();
+  });
+});
diff --git a/packages/app/src/embed/protocol.ts b/packages/app/src/embed/protocol.ts
new file mode 100644
index 0000000..b1acff0
--- /dev/null
+++ b/packages/app/src/embed/protocol.ts
@@ -0,0 +1,243 @@
+export const PASEO_EMBED_PROTOCOL_VERSION = 1 as const;
+export const PASEO_EMBED_READY = "paseo.embed.ready";
+export const PASEO_EMBED_SET_CONTEXT = "paseo.embed.context.set";
+export const PASEO_EMBED_CREATE_WORKSPACE = "paseo.embed.workspace.create";
+export const PASEO_EMBED_WORKSPACE_CREATED = "paseo.embed.workspace.created";
+export const PASEO_EMBED_WORKSPACE_FAILED = "paseo.embed.workspace.failed";
+
+const MAX_CONTEXT_FIELD_LENGTH = 240;
+const MAX_CONTEXT_TEXT_LENGTH = 32_000;
+const MAX_WORKSPACE_PATH_LENGTH = 4_096;
+
+export interface PaseoEmbedContext {
+  source: string;
+  kind: string;
+  id: string;
+  title: string;
+  subtitle?: string;
+  text: string;
+  url?: string;
+}
+
+export interface PaseoEmbedReadyMessage {
+  type: typeof PASEO_EMBED_READY;
+  version: typeof PASEO_EMBED_PROTOCOL_VERSION;
+  nonce: string;
+}
+
+export interface PaseoEmbedSetContextMessage {
+  type: typeof PASEO_EMBED_SET_CONTEXT;
+  version: typeof PASEO_EMBED_PROTOCOL_VERSION;
+  nonce: string;
+  context: PaseoEmbedContext;
+}
+
+export interface PaseoEmbedDefaultModel {
+  provider: string;
+  model?: string;
+  thinkingOptionId?: string;
+}
+
+export interface PaseoEmbedWorkspaceRequest {
+  requestId: string;
+  path: string;
+  title?: string;
+  defaultModel?: PaseoEmbedDefaultModel;
+}
+
+export interface PaseoEmbedCreateWorkspaceMessage {
+  type: typeof PASEO_EMBED_CREATE_WORKSPACE;
+  version: typeof PASEO_EMBED_PROTOCOL_VERSION;
+  nonce: string;
+  workspace: PaseoEmbedWorkspaceRequest;
+}
+
+export interface PaseoEmbedWorkspaceCreatedMessage {
+  type: typeof PASEO_EMBED_WORKSPACE_CREATED;
+  version: typeof PASEO_EMBED_PROTOCOL_VERSION;
+  nonce: string;
+  requestId: string;
+  workspaceId: string;
+  agentId: string;
+}
+
+export interface PaseoEmbedWorkspaceFailedMessage {
+  type: typeof PASEO_EMBED_WORKSPACE_FAILED;
+  version: typeof PASEO_EMBED_PROTOCOL_VERSION;
+  nonce: string;
+  requestId: string;
+  error: string;
+}
+
+function asRecord(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+function readString(value: unknown, maxLength: number): string | null {
+  if (typeof value !== "string") {
+    return null;
+  }
+  const normalized = value.trim();
+  return normalized && normalized.length <= maxLength ? normalized : null;
+}
+
+function readOptionalString(value: unknown, maxLength: number): string | undefined | null {
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  return readString(value, maxLength);
+}
+
+function parseDefaultModel(value: unknown): PaseoEmbedDefaultModel | undefined | null {
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  const model = asRecord(value);
+  if (!model) {
+    return null;
+  }
+  const provider = readString(model.provider, MAX_CONTEXT_FIELD_LENGTH);
+  const modelId = readOptionalString(model.model, MAX_CONTEXT_FIELD_LENGTH);
+  const thinkingOptionId = readOptionalString(model.thinkingOptionId, MAX_CONTEXT_FIELD_LENGTH);
+  if (!provider || modelId === null || thinkingOptionId === null) {
+    return null;
+  }
+  return {
+    provider,
+    ...(modelId ? { model: modelId } : {}),
+    ...(thinkingOptionId ? { thinkingOptionId } : {}),
+  };
+}
+
+export function isEmbedDevelopmentEnabled(): boolean {
+  return process.env.EXPO_PUBLIC_PASEO_EMBED_DEV === "1";
+}
+
+export function normalizeEmbedOrigin(value: string | undefined): string | null {
+  const raw = value?.trim();
+  if (!raw) {
+    return null;
+  }
+  try {
+    const url = new URL(raw);
+    if (url.protocol !== "http:" && url.protocol !== "https:") {
+      return null;
+    }
+    return url.origin;
+  } catch {
+    return null;
+  }
+}
+
+export function configuredEmbedParentOrigins(value: string | undefined): Set<string> {
+  return new Set(
+    (value ?? "")
+      .split(",")
+      .map((origin) => normalizeEmbedOrigin(origin))
+      .filter((origin): origin is string => origin !== null),
+  );
+}
+
+/**
+ * Production embeds must opt into known parent origins. Local development may
+ * supply an origin through the route while the explicit dev flag is set.
+ */
+export function resolveEmbedParentOrigin(value: string | undefined): string | null {
+  const candidate = normalizeEmbedOrigin(value);
+  if (!candidate) {
+    return null;
+  }
+  const configured = configuredEmbedParentOrigins(
+    process.env.EXPO_PUBLIC_PASEO_EMBED_PARENT_ORIGIN,
+  );
+  if (configured.size > 0) {
+    return configured.has(candidate) ? candidate : null;
+  }
+  return isEmbedDevelopmentEnabled() ? candidate : null;
+}
+
+export function parsePaseoEmbedSetContextMessage(
+  value: unknown,
+): PaseoEmbedSetContextMessage | null {
+  const message = asRecord(value);
+  if (
+    !message ||
+    message.type !== PASEO_EMBED_SET_CONTEXT ||
+    message.version !== PASEO_EMBED_PROTOCOL_VERSION
+  ) {
+    return null;
+  }
+
+  const nonce = readString(message.nonce, MAX_CONTEXT_FIELD_LENGTH);
+  const context = asRecord(message.context);
+  if (!nonce || !context) {
+    return null;
+  }
+
+  const source = readString(context.source, MAX_CONTEXT_FIELD_LENGTH);
+  const kind = readString(context.kind, MAX_CONTEXT_FIELD_LENGTH);
+  const id = readString(context.id, MAX_CONTEXT_FIELD_LENGTH);
+  const title = readString(context.title, MAX_CONTEXT_FIELD_LENGTH);
+  const text = readString(context.text, MAX_CONTEXT_TEXT_LENGTH);
+  const subtitle = readOptionalString(context.subtitle, MAX_CONTEXT_FIELD_LENGTH);
+  const url = readOptionalString(context.url, 2_000);
+  if (!source || !kind || !id || !title || !text || subtitle === null || url === null) {
+    return null;
+  }
+
+  return {
+    type: PASEO_EMBED_SET_CONTEXT,
+    version: PASEO_EMBED_PROTOCOL_VERSION,
+    nonce,
+    context: {
+      source,
+      kind,
+      id,
+      title,
+      ...(subtitle ? { subtitle } : {}),
+      text,
+      ...(url ? { url } : {}),
+    },
+  };
+}
+
+export function parsePaseoEmbedCreateWorkspaceMessage(
+  value: unknown,
+): PaseoEmbedCreateWorkspaceMessage | null {
+  const message = asRecord(value);
+  if (
+    !message ||
+    message.type !== PASEO_EMBED_CREATE_WORKSPACE ||
+    message.version !== PASEO_EMBED_PROTOCOL_VERSION
+  ) {
+    return null;
+  }
+
+  const nonce = readString(message.nonce, MAX_CONTEXT_FIELD_LENGTH);
+  const workspace = asRecord(message.workspace);
+  if (!nonce || !workspace) {
+    return null;
+  }
+
+  const requestId = readString(workspace.requestId, MAX_CONTEXT_FIELD_LENGTH);
+  const path = readString(workspace.path, MAX_WORKSPACE_PATH_LENGTH);
+  const title = readOptionalString(workspace.title, MAX_CONTEXT_FIELD_LENGTH);
+  const defaultModel = parseDefaultModel(workspace.defaultModel);
+  if (!requestId || !path || title === null || defaultModel === null) {
+    return null;
+  }
+
+  return {
+    type: PASEO_EMBED_CREATE_WORKSPACE,
+    version: PASEO_EMBED_PROTOCOL_VERSION,
+    nonce,
+    workspace: {
+      requestId,
+      path,
+      ...(title ? { title } : {}),
+      ...(defaultModel ? { defaultModel } : {}),
+    },
+  };
+}
