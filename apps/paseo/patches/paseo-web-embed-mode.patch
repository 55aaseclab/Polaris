+import { describe, expect, it, vi } from "vitest";
+import type { EmbedWorkspaceClient } from "./workspace";
+import { createEmbeddedWorkspaceAgent, resolveEmbedAgentDefaults } from "./workspace";
+
+describe("embedded workspace creation", () => {
+  it("creates the requested directory workspace and agent model", async () => {
+    const client = {
+      createWorkspace: vi.fn().mockResolvedValue({
+        workspace: { id: "workspace-1", workspaceDirectory: "/work/example" },
+      }),
+      getProvidersSnapshot: vi.fn().mockResolvedValue({
+        entries: [
+          {
+            provider: "codex",
+            enabled: true,
+            status: "ready",
+            defaultModeId: "full-access",
+            models: [
+              { provider: "codex", id: "model-default", label: "Default", isDefault: true },
+              { provider: "codex", id: "model-fast", label: "Fast" },
+            ],
+          },
+        ],
+      }),
+      createAgent: vi.fn().mockResolvedValue({ id: "agent-1" }),
+    } as unknown as EmbedWorkspaceClient;
+
+    await expect(
+      createEmbeddedWorkspaceAgent({
+        client,
+        request: {
+          requestId: "request-1",
+          path: "/work/example",
+          title: "Example workspace",
+          defaultModel: {
+            provider: "codex",
+            model: "model-fast",
+            thinkingOptionId: "medium",
+          },
+        },
+      }),
+    ).resolves.toEqual({ agentId: "agent-1", workspaceId: "workspace-1" });
+
+    expect(client.createWorkspace).toHaveBeenCalledWith({
+      source: { kind: "directory", path: "/work/example" },
+      title: "Example workspace",
+    });
+    expect(client.getProvidersSnapshot).toHaveBeenCalledWith({ cwd: "/work/example" });
+    expect(client.createAgent).toHaveBeenCalledWith({
+      provider: "codex",
+      model: "model-fast",
+      modeId: "full-access",
+      thinkingOptionId: "medium",
+      cwd: "/work/example",
+      workspaceId: "workspace-1",
+    });
+  });
+
+  it("uses Codex GPT-5.4 with medium thinking by default", () => {
+    expect(
+      resolveEmbedAgentDefaults([
+        {
+          provider: "codex",
+          enabled: true,
+          status: "ready",
+          models: [
+            { provider: "codex", id: "gpt-5.4", label: "GPT-5.4" },
+            { provider: "codex", id: "gpt-5.4-mini", label: "GPT-5.4 Mini", isDefault: true },
+          ],
+        },
+      ]),
+    ).toEqual({ provider: "codex", model: "gpt-5.4", thinkingOptionId: "medium" });
+  });
+});
diff --git a/packages/app/src/embed/workspace.ts b/packages/app/src/embed/workspace.ts
