+import { type PaneContextValue } from "@/panels/pane-context";
+import type { WorkspaceTabTarget } from "@/stores/workspace-tabs-store";
+
+export function createEmbeddedAgentPaneContext(input: {
+  serverId: string;
+  workspaceId: string;
+  agentId: string;
+  onAgentChange: (agentId: string) => void;
+}): PaneContextValue {
+  const selectTarget = (target: WorkspaceTabTarget) => {
+    input.onAgentChange(target.kind === "agent" ? target.agentId : "");
+  };
+
+  return {
+    serverId: input.serverId,
+    workspaceId: input.workspaceId,
+    tabId: `embed:${input.agentId}`,
+    target: { kind: "agent", agentId: input.agentId },
+    openTab: selectTarget,
+    closeCurrentTab: () => input.onAgentChange(""),
+    retargetCurrentTab: selectTarget,
+    openFileInWorkspace: () => {},
+    openImportSheet: () => {},
+  };
+}
