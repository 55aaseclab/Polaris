+// @vitest-environment jsdom
+
+import { act, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  PASEO_EMBED_PROTOCOL_VERSION,
+  PASEO_EMBED_READY,
+  PASEO_EMBED_WORKSPACE_CREATED,
+  PASEO_EMBED_WORKSPACE_FAILED,
+} from "./protocol";
+import { usePaseoEmbedBridge } from "./bridge.web";
+
+const originalParentDescriptor = Object.getOwnPropertyDescriptor(window, "parent");
+
+function installParentWindow() {
+  const parentWindow = { postMessage: vi.fn() };
+  Object.defineProperty(window, "parent", {
+    configurable: true,
+    value: parentWindow,
+  });
+  return parentWindow;
+}
+
+afterEach(() => {
+  if (originalParentDescriptor) {
+    Object.defineProperty(window, "parent", originalParentDescriptor);
+  }
+  vi.unstubAllEnvs();
+});
+
+describe("Paseo embed web bridge", () => {
+  it("reports workspace creation and failure to the verified parent", () => {
+    vi.stubEnv("EXPO_PUBLIC_PASEO_EMBED_DEV", "1");
+    const parentWindow = installParentWindow();
+    const onContext = vi.fn();
+    const { result } = renderHook(() =>
+      usePaseoEmbedBridge({
+        parentOrigin: "https://host.example",
+        nonce: "nonce-1",
+        onContext,
+      }),
+    );
+
+    expect(parentWindow.postMessage).toHaveBeenCalledWith(
+      {
+        type: PASEO_EMBED_READY,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+      },
+      "https://host.example",
+    );
+
+    act(() => {
+      result.current.reportWorkspaceCreated({
+        requestId: "request-1",
+        workspaceId: "workspace-1",
+        agentId: "agent-1",
+      });
+      result.current.reportWorkspaceFailed({
+        requestId: "request-2",
+        error: "Provider unavailable",
+      });
+    });
+
+    expect(parentWindow.postMessage).toHaveBeenLastCalledWith(
+      {
+        type: PASEO_EMBED_WORKSPACE_FAILED,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+        requestId: "request-2",
+        error: "Provider unavailable",
+      },
+      "https://host.example",
+    );
+    expect(parentWindow.postMessage).toHaveBeenCalledWith(
+      {
+        type: PASEO_EMBED_WORKSPACE_CREATED,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce: "nonce-1",
+        requestId: "request-1",
+        workspaceId: "workspace-1",
+        agentId: "agent-1",
+      },
+      "https://host.example",
+    );
+  });
+});
diff --git a/packages/app/src/embed/bridge.web.ts b/packages/app/src/embed/bridge.web.ts
new file mode 100644
index 0000000..f20b98d
--- /dev/null
+++ b/packages/app/src/embed/bridge.web.ts
@@ -0,0 +1,102 @@
+import { useEffect, useRef } from "react";
+import {
+  PASEO_EMBED_PROTOCOL_VERSION,
+  PASEO_EMBED_READY,
+  PASEO_EMBED_WORKSPACE_CREATED,
+  PASEO_EMBED_WORKSPACE_FAILED,
+  parsePaseoEmbedCreateWorkspaceMessage,
+  parsePaseoEmbedSetContextMessage,
+  resolveEmbedParentOrigin,
+} from "./protocol";
+import type { PaseoEmbedBridge, PaseoEmbedBridgeOptions } from "./bridge.shared";
+
+export function usePaseoEmbedBridge(input: PaseoEmbedBridgeOptions): PaseoEmbedBridge {
+  const onContextRef = useRef(input.onContext);
+  const onWorkspaceCreateRef = useRef(input.onWorkspaceCreate);
+  const parentOriginRef = useRef<string | null>(null);
+  const nonceRef = useRef<string | null>(null);
+  const bridgeRef = useRef<PaseoEmbedBridge | null>(null);
+  onContextRef.current = input.onContext;
+  onWorkspaceCreateRef.current = input.onWorkspaceCreate;
+
+  if (!bridgeRef.current) {
+    const postToParent = (message: Record<string, unknown>) => {
+      const parentOrigin = parentOriginRef.current;
+      const nonce = nonceRef.current;
+      if (!parentOrigin || !nonce || window.parent === window) {
+        return;
+      }
+      window.parent.postMessage(
+        {
+          ...message,
+          version: PASEO_EMBED_PROTOCOL_VERSION,
+          nonce,
+        },
+        parentOrigin,
+      );
+    };
+    bridgeRef.current = {
+      reportWorkspaceCreated: ({ requestId, workspaceId, agentId }) => {
+        postToParent({
+          type: PASEO_EMBED_WORKSPACE_CREATED,
+          requestId,
+          workspaceId,
+          agentId,
+        });
+      },
+      reportWorkspaceFailed: ({ requestId, error }) => {
+        postToParent({
+          type: PASEO_EMBED_WORKSPACE_FAILED,
+          requestId,
+          error: error.slice(0, 1_000),
+        });
+      },
+    };
+  }
+
+  useEffect(() => {
+    const parentOrigin = resolveEmbedParentOrigin(input.parentOrigin);
+    const nonce = input.nonce?.trim();
+    parentOriginRef.current = null;
+    nonceRef.current = null;
+    if (!parentOrigin || !nonce || window.parent === window) {
+      return;
+    }
+    parentOriginRef.current = parentOrigin;
+    nonceRef.current = nonce;
+
+    const handleMessage = (event: MessageEvent<unknown>) => {
+      if (event.origin !== parentOrigin || event.source !== window.parent) {
+        return;
+      }
+      const message = parsePaseoEmbedSetContextMessage(event.data);
+      if (!message || message.nonce !== nonce) {
+        const workspaceMessage = parsePaseoEmbedCreateWorkspaceMessage(event.data);
+        if (workspaceMessage && workspaceMessage.nonce === nonce) {
+          onWorkspaceCreateRef.current?.(workspaceMessage.workspace);
+        }
+        return;
+      }
+      onContextRef.current(message.context);
+    };
+
+    window.addEventListener("message", handleMessage);
+    window.parent.postMessage(
+      {
+        type: PASEO_EMBED_READY,
+        version: PASEO_EMBED_PROTOCOL_VERSION,
+        nonce,
+      },
+      parentOrigin,
+    );
+    return () => {
+      window.removeEventListener("message", handleMessage);
+      if (parentOriginRef.current === parentOrigin && nonceRef.current === nonce) {
+        parentOriginRef.current = null;
+        nonceRef.current = null;
+      }
+    };
+  }, [input.nonce, input.parentOrigin]);
+
+  return bridgeRef.current;
+}
