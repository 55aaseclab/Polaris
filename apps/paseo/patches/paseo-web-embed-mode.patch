+import { useMemo } from "react";
+import { AgentPanelContent } from "@/panels/agent-panel";
+import { PaneProvider } from "@/panels/pane-context";
+import { createEmbeddedAgentPaneContext } from "@/embed/embedded-pane-context";
+
+interface EmbeddedAgentPanelProps {
+  serverId: string;
+  workspaceId: string;
+  agentId: string;
+  onAgentChange: (agentId: string) => void;
+}
+
+export function EmbeddedAgentPanel({
+  serverId,
+  workspaceId,
+  agentId,
+  onAgentChange,
+}: EmbeddedAgentPanelProps) {
+  const paneContext = useMemo(
+    () =>
+      createEmbeddedAgentPaneContext({
+        serverId,
+        workspaceId,
+        agentId,
+        onAgentChange,
+      }),
+    [agentId, onAgentChange, serverId, workspaceId],
+  );
+
+  return (
+    <PaneProvider value={paneContext}>
+      <AgentPanelContent serverId={serverId} agentId={agentId} isPaneFocused />
+    </PaneProvider>
+  );
+}
