diff --git a/packages/app/src/utils/agent-initialization.ts b/packages/app/src/utils/agent-initialization.ts
index 9b73f73..d8c394f 100644
--- a/packages/app/src/utils/agent-initialization.ts
+++ b/packages/app/src/utils/agent-initialization.ts
@@ -68,3 +68,20 @@ export function rejectInitDeferred(key: string, error: Error): void {
   initPromises.delete(key);
   deferred.reject(error);
 }
+
+export function rejectInitDeferredsForServer(serverId: string, error: Error): void {
+  for (const key of Array.from(initPromises.keys())) {
+    if (!key.startsWith(`${serverId}:`)) {
+      continue;
+    }
+    const deferred = initPromises.get(key);
+    if (!deferred) {
+      continue;
+    }
+    if (deferred.timeoutId) {
+      clearTimeout(deferred.timeoutId);
+    }
+    initPromises.delete(key);
+    deferred.reject(error);
+  }
+}
