-function required(value: string | undefined, name: string): string {
-  const trimmed = value?.trim();
-  if (!trimmed) throw new Error(`${name} is required`);
-  return trimmed;
-}
-
-export function polarisApiBaseUrl(): string {
-  if (typeof globalThis.location === "undefined") throw new Error("A browser is required");
-  const port = process.env.EXPO_PUBLIC_POLARIS_API_PORT?.trim();
-  if (!port) return `${globalThis.location.origin}/api`;
-  return `${globalThis.location.protocol}//${globalThis.location.hostname}:${port}/api`;
-}
-
-function fallbackCallbackUrl(): string {
-  if (typeof globalThis.location === "undefined") throw new Error("A browser is required");
-  return `${globalThis.location.origin}/auth/callback`;
-}
-
-interface AuthingConfig {
-  appId: string;
-  authorizationUrl: string;
-  redirectUri: string;
-  logoutUrl?: string;
-  logoutRedirectUri?: string;
-}
-
-async function loadAuthingConfig(): Promise<AuthingConfig> {
-  const response = await fetch(`${polarisApiBaseUrl()}/authing-config`);
-  const config = (await response.json().catch(() => ({}))) as Partial<AuthingConfig>;
-  if (!response.ok) throw new Error("无法加载 Authing 配置");
-  return {
-    appId: required(config.appId, "POLARIS_AUTHING_APP_ID"),
-    authorizationUrl: required(config.authorizationUrl, "POLARIS_AUTHING_AUTHORIZATION_URL"),
-    redirectUri: config.redirectUri?.trim() || fallbackCallbackUrl(),
-    logoutUrl: config.logoutUrl?.trim() || undefined,
-    logoutRedirectUri: config.logoutRedirectUri?.trim() || undefined,
-  };
-}
-
-function base64Url(bytes: Uint8Array): string {
-  let value = "";
-  for (const byte of bytes) value += String.fromCharCode(byte);
-  return btoa(value).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
-}
-
-function randomBytes(length: number): Uint8Array {
-  const bytes = new Uint8Array(length);
-  if (typeof globalThis.crypto?.getRandomValues === "function") {
-    globalThis.crypto.getRandomValues(bytes);
-    return bytes;
-  }
-  for (let index = 0; index < length; index += 1) {
-    bytes[index] = Math.floor(Math.random() * 256);
-  }
-  return bytes;
-}
-
-async function challenge(verifier: string): Promise<{ value: string; method: "S256" | "plain" }> {
-  if (typeof globalThis.crypto?.subtle?.digest === "function") {
-    return {
-      value: base64Url(
-        new Uint8Array(
-          await globalThis.crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier)),
-        ),
-      ),
-      method: "S256",
-    };
-  }
-  return { value: verifier, method: "plain" };
-}
