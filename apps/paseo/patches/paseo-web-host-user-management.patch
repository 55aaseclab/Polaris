+++ b/packages/app/src/screens/settings/polaris-user-page.tsx
@@ -0,0 +1,250 @@
+import { useCallback, useEffect, useState } from "react";
+import { ActivityIndicator, Text, View } from "react-native";
+import { StyleSheet, useUnistyles } from "react-native-unistyles";
+import { AdaptiveModalSheet } from "@/components/adaptive-modal-sheet";
+import { Button } from "@/components/ui/button";
+import { SettingsSection } from "@/screens/settings/settings-section";
+import { settingsStyles } from "@/styles/settings";
+import { getPolarisAuthToken, polarisApiBaseUrl, signOutPolaris } from "@/lib/polaris-authing";
+
+interface PolarisUserResponse {
+  profile: { id: string; name?: string; email?: string };
+  session: {
+    userId: string;
+    authingUserId: string;
+    authingUsername: string | null;
+    authingPhoneNumber: string | null;
+    role: string;
+    plan: string | null;
+  };
+  credentials: Array<{ id: string; label: string; kind: string; status: string; paths: string[] }>;
+}
+
+interface PolarisCredentialRecord {
+  credential: { id: string; label: string };
+  files: Array<{ key: string; sourcePath: string; content: string }>;
+}
+
+export function PolarisUserPage() {
+  const { theme } = useUnistyles();
+  const [data, setData] = useState<PolarisUserResponse | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [credentialRecord, setCredentialRecord] = useState<PolarisCredentialRecord | null>(null);
+  const [credentialLoading, setCredentialLoading] = useState(false);
+  const [credentialError, setCredentialError] = useState<string | null>(null);
+  const [signOutConfirmVisible, setSignOutConfirmVisible] = useState(false);
+
+  const load = useCallback(async () => {
+    setLoading(true);
+    try {
+      const response = await fetch(`${polarisApiBaseUrl()}/polaris-user`, {
+        headers: getPolarisAuthToken() ? { authorization: `Bearer ${getPolarisAuthToken()}` } : {},
+      });
+      const body = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(typeof body.error === "string" ? body.error : "无法加载用户信息");
+      setData(body as PolarisUserResponse);
+      setError(null);
+    } catch (reason) {
+      setError(reason instanceof Error ? reason.message : String(reason));
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const handleConfirmSignOut = useCallback(() => {
+    signOutPolaris();
+  }, []);
+
+  const handleViewCredential = useCallback(async (credential: PolarisUserResponse["credentials"][number]) => {
+    if (!data || credentialLoading) return;
+    setCredentialLoading(true);
+    setCredentialError(null);
+    setCredentialRecord({ credential: { id: credential.id, label: credential.label }, files: [] });
+    try {
+      const token = getPolarisAuthToken();
+      const response = await fetch(
+        `${polarisApiBaseUrl()}/users/${encodeURIComponent(data.session.userId)}/credentials/${encodeURIComponent(credential.id)}`,
+        { headers: token ? { authorization: `Bearer ${token}` } : {} },
+      );
+      const body = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(typeof body.error === "string" ? body.error : "无法读取凭证");
+      setCredentialRecord(body as PolarisCredentialRecord);
+    } catch (reason) {
+      setCredentialError(reason instanceof Error ? reason.message : String(reason));
+    } finally {
+      setCredentialLoading(false);
+    }
+  }, [credentialLoading, data]);
+
+  const closeCredentialViewer = useCallback(() => {
+    setCredentialRecord(null);
+    setCredentialError(null);
+  }, []);
+
+  if (loading) {
+    return <ActivityIndicator color={theme.colors.foregroundMuted} />;
+  }
+
+  if (error || !data) {
+    return <Text style={styles.error}>{error || "无法加载用户信息"}</Text>;
+  }
+
+  return (
+    <View>
+      <SettingsSection title="基本信息">
+        <View style={settingsStyles.card}>
+          <InfoRow label="用户名称" value={data.profile.name || data.session.authingUsername || "未设置"} />
+          <InfoRow label="邮箱" value={data.profile.email || "未设置"} bordered />
+          <InfoRow label="手机号" value={data.session.authingPhoneNumber || "未设置"} bordered />
+          <InfoRow label="用户 ID" value={data.session.userId} bordered />
+          <InfoRow label="Authing ID" value={data.session.authingUserId} bordered />
+          <InfoRow label="角色" value={data.session.role} bordered />
+          <InfoRow label="订阅" value={formatPlan(data.session.plan)} bordered />
+        </View>
+      </SettingsSection>
+
+      <SettingsSection title="凭证">
+        <View style={settingsStyles.card}>
+          {data.credentials.length > 0 ? data.credentials.map((credential, index) => (
+            <CredentialRow
+              key={credential.id}
+              credential={credential}
+              bordered={index > 0}
+              onView={() => void handleViewCredential(credential)}
+            />
+          )) : <Text style={styles.empty}>还没有凭证</Text>}
+        </View>
+      </SettingsSection>
+
+      <SettingsSection title="会话">
+        <View style={settingsStyles.card}>
+          <View style={settingsStyles.row}>
+            <View style={settingsStyles.rowContent}>
+              <Text style={settingsStyles.rowTitle}>退出登录</Text>
+              <Text style={settingsStyles.rowHint}>退出当前 Polaris 会话</Text>
+            </View>
+            <Button size="sm" variant="destructive" onPress={() => setSignOutConfirmVisible(true)}>
+              退出
+            </Button>
+          </View>
+        </View>
+      </SettingsSection>
+
+      {credentialRecord ? (
+        <AdaptiveModalSheet
+          header={{ title: credentialRecord.credential.label, subtitle: "凭证内容" }}
+          visible
+          onClose={closeCredentialViewer}
+          desktopMaxWidth={720}
+        >
+          {credentialLoading ? <ActivityIndicator color={theme.colors.foregroundMuted} /> : null}
+          {credentialError ? <Text style={styles.error}>{credentialError}</Text> : null}
+          {!credentialLoading && !credentialError && credentialRecord.files.length === 0 ? (
+            <Text style={styles.empty}>没有可查看的凭证文件</Text>
+          ) : null}
+          {!credentialLoading && !credentialError ? credentialRecord.files.map((file) => (
+            <View key={file.key} style={settingsStyles.card}>
+              <View style={settingsStyles.row}>
+                <Text style={settingsStyles.rowTitle} numberOfLines={1}>{file.sourcePath}</Text>
+              </View>
+              <View style={[settingsStyles.row, settingsStyles.rowBorder]}>
+                <Text selectable style={styles.fileContent}>{file.content}</Text>
+              </View>
+            </View>
+          )) : null}
+        </AdaptiveModalSheet>
+      ) : null}
+
+      <AdaptiveModalSheet
+        header={{ title: "退出登录？" }}
+        visible={signOutConfirmVisible}
+        onClose={() => setSignOutConfirmVisible(false)}
+      >
+        <Text style={styles.confirmText}>你将退出 Polaris</Text>
+        <View style={styles.confirmActions}>
+          <Button
+            size="sm"
+            variant="secondary"
+            style={styles.confirmAction}
+            onPress={() => setSignOutConfirmVisible(false)}
+          >
+            取消
+          </Button>
+          <Button
+            size="sm"
+            variant="destructive"
+            style={styles.confirmAction}
+            onPress={handleConfirmSignOut}
+          >
+            退出登录
+          </Button>
+        </View>
+      </AdaptiveModalSheet>
+    </View>
+  );
+}
+
+function InfoRow({ label, value, bordered = false }: { label: string; value: string; bordered?: boolean }) {
+  return (
+    <View style={[settingsStyles.row, bordered && settingsStyles.rowBorder]}>
+      <View style={settingsStyles.rowContent}>
+        <Text style={settingsStyles.rowTitle} numberOfLines={1}>{label}</Text>
+      </View>
+      <Text style={styles.value} numberOfLines={1}>{value}</Text>
+    </View>
+  );
+}
+
+function formatPlan(plan: string | null): string {
+  if (plan === "free") return "免费套餐";
+  if (plan === "pro") return "专业套餐";
+  return plan || "未订阅";
+}
+
+function CredentialRow({
+  credential,
+  bordered,
+  onView,
+}: {
+  credential: PolarisUserResponse["credentials"][number];
+  bordered: boolean;
+  onView: () => void;
+}) {
+  return (
+    <View style={[settingsStyles.row, bordered && settingsStyles.rowBorder]}>
+      <View style={settingsStyles.rowContent}>
+        <Text style={settingsStyles.rowTitle} numberOfLines={1}>{credential.label}</Text>
+        {credential.paths.length > 0 ? (
+          <Text style={settingsStyles.rowHint} numberOfLines={1}>{credential.paths.join(" · ")}</Text>
+        ) : null}
+      </View>
+      {credential.status === "ready" ? (
+        <Button size="sm" variant="secondary" onPress={onView}>查看</Button>
+      ) : <Text style={styles.value} numberOfLines={1}>{credential.status}</Text>}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  value: { maxWidth: "58%", color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm, textAlign: "right" },
+  empty: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm, minHeight: 42, padding: theme.spacing[3] },
+  error: { color: theme.colors.destructive, fontSize: theme.fontSize.sm },
+  confirmText: { color: theme.colors.foregroundMuted, fontSize: theme.fontSize.sm },
+  confirmActions: {
+    flexDirection: "row",
+    gap: theme.spacing[2],
+    marginTop: theme.spacing[4],
+  },
+  confirmAction: { flex: 1 },
+  fileContent: {
+    color: theme.colors.foreground,
+    fontFamily: theme.fontFamily.mono,
+    fontSize: theme.fontSize.code,
+    lineHeight: theme.lineHeight.diff,
+  },
+}));
