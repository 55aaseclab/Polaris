+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  extractServerIdFromPairingUrl,
+  findPolarisHostForServerId,
+  pickPolarisPairingUrl,
+  rankPolarisHosts,
+  resolvePostLoginHref,
+  syncPolarisHostsFromApi,
+  type PolarisHostSummary,
+} from "./polaris-host-sync";
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+function offerUrl(serverId: string, path = "/paseo"): string {
+  const payload = Buffer.from(
+    JSON.stringify({
+      v: 2,
+      serverId,
+      daemonPublicKeyB64: "abc",
+      relay: { endpoint: "relay.example:443", useTls: true },
+    }),
+  )
+    .toString("base64")
+    .replace(/\+/g, "-")
+    .replace(/\//g, "_")
+    .replace(/=+$/, "");
+  return `https://polaris.example${path}#offer=${payload}`;
+}
+
+describe("polaris host sync helpers", () => {
+  it("prefers reconnectTarget when it carries an offer", () => {
+    const host: PolarisHostSummary = {
+      name: "test",
+      status: {
+        paseo: {
+          liveTarget: offerUrl("srv_live"),
+          reconnectTarget: `https://polaris.example/paseo/h/srv_reconnect#offer=${
+            offerUrl("srv_reconnect").split("#offer=")[1]
+          }`,
+        },
+      },
+    };
+    const url = pickPolarisPairingUrl(host);
+    expect(url).toContain("srv_reconnect");
+    expect(extractServerIdFromPairingUrl(url!)).toBe("srv_reconnect");
+  });
+
+  it("extracts serverId from /h/ path and from offer payload", () => {
+    expect(
+      extractServerIdFromPairingUrl("https://polaris.example/paseo/h/srv_AiBanc_-FHWd?scope=x"),
+    ).toBe("srv_AiBanc_-FHWd");
+    expect(extractServerIdFromPairingUrl(offerUrl("srv_FromOffer"))).toBe("srv_FromOffer");
+  });
+
+  it("finds an offline Polaris host by its stable Paseo server ID", () => {
+    const hosts: PolarisHostSummary[] = [
+      {
+        name: "workspace-name",
+        status: {
+          driver: { status: "stopped" },
+          paseo: {
+            reconnectTarget: "https://polaris.example/paseo/h/srv_offline?scope=user-a",
+          },
+        },
+      },
+    ];
+
+    expect(findPolarisHostForServerId(hosts, "srv_offline")?.name).toBe("workspace-name");
+    expect(findPolarisHostForServerId(hosts, "srv_other")).toBeNull();
+  });
+
+  it("ranks running hosts before stopped ones", () => {
+    const ranked = rankPolarisHosts([
+      { name: "zzz", status: { driver: { status: "stopped" } } },
+      { name: "aaa", status: { driver: { status: "running" } } },
+      { name: "mmm", status: { driver: { status: "running" } } },
+    ]);
+    expect(ranked.map((host) => host.name)).toEqual(["aaa", "mmm", "zzz"]);
+  });
+
+  it("resolves post-login href to preferred host over return path", () => {
+    expect(
+      resolvePostLoginHref({
+        preferredHref: "/h/srv_good",
+        returnPath: "/settings",
+      }),
+    ).toBe("/h/srv_good");
+    expect(
+      resolvePostLoginHref({
+        preferredHref: null,
+        returnPath: "/welcome",
+      }),
+    ).toBe("/settings");
+  });
+
+  it("syncs hosts from API using offer URLs in ranked order", async () => {
+    const hosts: PolarisHostSummary[] = [
+      {
+        name: "stopped",
+        status: {
+          driver: { status: "stopped" },
+          paseo: { liveTarget: offerUrl("srv_stopped") },
+        },
+      },
+      {
+        name: "test",
+        status: {
+          driver: { status: "running" },
+          paseo: {
+            reconnectTarget: `https://polaris.example/paseo/h/srv_AiBanc_-FHWd#offer=${
+              offerUrl("srv_AiBanc_-FHWd").split("#offer=")[1]
+            }`,
+          },
+        },
+      },
+    ];
+    vi.stubGlobal(
+      "fetch",
+      vi.fn().mockResolvedValue(
+        new Response(JSON.stringify({ hosts }), { status: 200 }),
+      ),
+    );
+    vi.stubGlobal("location", {
+      origin: "https://polaris.example",
+      protocol: "https:",
+      hostname: "polaris.example",
+    });
+    const upsert = vi
+      .fn()
+      .mockImplementation(async (url: string) => ({
+        serverId: extractServerIdFromPairingUrl(url) ?? "unknown",
+      }));
+
+    const result = await syncPolarisHostsFromApi({
+      token: "token",
+      upsertFromOfferUrl: upsert,
+    });
+
+    expect(upsert).toHaveBeenCalledTimes(2);
+    expect(upsert.mock.calls[0]?.[1]).toBe("test");
+    expect(result.preferredServerId).toBe("srv_AiBanc_-FHWd");
+    expect(result.preferredHref).toBe("/h/srv_AiBanc_-FHWd");
+    expect(result.serverIds).toEqual(["srv_AiBanc_-FHWd", "srv_stopped"]);
+  });
+});
diff --git a/packages/app/src/lib/polaris-host-sync.ts b/packages/app/src/lib/polaris-host-sync.ts
