+++ b/packages/app/src/lib/polaris-host-sync.ts
@@ -0,0 +1,173 @@
+import { polarisApiBaseUrl } from "@/lib/polaris-authing";
+import { buildHostRootRoute } from "@/utils/host-routes";
+
+export interface PolarisHostSummary {
+  name: string;
+  status?: {
+    driver?: {
+      status?: string | null;
+      selected?: { backend?: string | null; profile?: string | null } | null;
+    } | null;
+    paseo?: {
+      liveTarget?: string | null;
+      reconnectTarget?: string | null;
+    } | null;
+  } | null;
+}
+
+export interface SyncPolarisHostsResult {
+  serverIds: string[];
+  preferredServerId: string | null;
+  preferredHref: string | null;
+}
+
+type UpsertFromOfferUrl = (
+  offerUrl: string,
+  label?: string,
+) => Promise<{ serverId: string }>;
+
+let inflight: Promise<SyncPolarisHostsResult> | null = null;
+
+function decodeBase64UrlJson(value: string): unknown {
+  const normalized = value.replace(/-/g, "+").replace(/_/g, "/");
+  const padded = normalized + "=".repeat((4 - (normalized.length % 4)) % 4);
+  const json =
+    typeof globalThis.atob === "function"
+      ? globalThis.atob(padded)
+      : Buffer.from(padded, "base64").toString("utf8");
+  return JSON.parse(json) as unknown;
+}
+
+/** Prefer reconnectTarget (includes /h/srv_...) when it carries an offer. */
+export function pickPolarisPairingUrl(host: PolarisHostSummary): string | null {
+  const reconnect = host.status?.paseo?.reconnectTarget?.trim() || "";
+  const live = host.status?.paseo?.liveTarget?.trim() || "";
+  if (reconnect.includes("#offer=")) return reconnect;
+  if (live.includes("#offer=")) return live;
+  if (reconnect) return reconnect;
+  if (live) return live;
+  return null;
+}
+
+export function extractServerIdFromPairingUrl(url: string): string | null {
+  const trimmed = url.trim();
+  if (!trimmed) return null;
+  try {
+    const parsed = new URL(trimmed, "https://polaris.local");
+    const pathMatch = parsed.pathname.match(/\/h\/(srv_[^/]+)/);
+    if (pathMatch?.[1]) return decodeURIComponent(pathMatch[1]);
+    const hash = parsed.hash.startsWith("#") ? parsed.hash.slice(1) : parsed.hash;
+    const offer = new URLSearchParams(hash).get("offer");
+    if (!offer) return null;
+    const payload = decodeBase64UrlJson(offer);
+    if (
+      payload &&
+      typeof payload === "object" &&
+      typeof (payload as { serverId?: unknown }).serverId === "string"
+    ) {
+      const serverId = (payload as { serverId: string }).serverId.trim();
+      return serverId || null;
+    }
+  } catch {
+    // Fall through to regex fallbacks for non-standard URLs.
+  }
+  const pathFallback = trimmed.match(/\/h\/(srv_[^/?#]+)/);
+  if (pathFallback?.[1]) return decodeURIComponent(pathFallback[1]);
+  return null;
+}
+
+/**
+ * A Paseo host can be renamed locally, so its label is not a safe identity.
+ * The Polaris pairing target carries the immutable Paseo server ID instead.
+ */
+export function findPolarisHostForServerId(
+  hosts: readonly PolarisHostSummary[],
+  serverId: string,
+): PolarisHostSummary | null {
+  const expectedServerId = serverId.trim();
+  if (!expectedServerId) {
+    return null;
+  }
+  return (
+    hosts.find(
+      (host) => extractServerIdFromPairingUrl(pickPolarisPairingUrl(host) ?? "") === expectedServerId,
+    ) ?? null
+  );
+}
+
+/** Running hosts first, then name order — stable for “prefer correct srv”. */
+export function rankPolarisHosts(hosts: readonly PolarisHostSummary[]): PolarisHostSummary[] {
+  return [...hosts].sort((left, right) => {
+    const leftRunning = left.status?.driver?.status === "running" ? 0 : 1;
+    const rightRunning = right.status?.driver?.status === "running" ? 0 : 1;
+    if (leftRunning !== rightRunning) return leftRunning - rightRunning;
+    return left.name.localeCompare(right.name);
+  });
+}
+
+export async function fetchPolarisHosts(token: string): Promise<PolarisHostSummary[]> {
+  const response = await fetch(`${polarisApiBaseUrl()}/polaris-hosts`, {
+    headers: { authorization: `Bearer ${token}` },
+  });
+  const body = (await response.json().catch(() => ({}))) as {
+    hosts?: PolarisHostSummary[];
+    error?: string;
+  };
+  if (!response.ok) {
+    throw new Error(typeof body.error === "string" ? body.error : "无法加载 Polaris 主机列表");
+  }
+  return Array.isArray(body.hosts) ? body.hosts : [];
+}
+
+export async function syncPolarisHostsFromApi(options: {
+  token: string;
+  upsertFromOfferUrl: UpsertFromOfferUrl;
+}): Promise<SyncPolarisHostsResult> {
+  const hosts = rankPolarisHosts(await fetchPolarisHosts(options.token));
+  const serverIds: string[] = [];
+  for (const host of hosts) {
+    const pairingUrl = pickPolarisPairingUrl(host);
+    if (!pairingUrl || !pairingUrl.includes("#offer=")) {
+      continue;
+    }
+    try {
+      const profile = await options.upsertFromOfferUrl(pairingUrl, host.name);
+      const serverId = profile.serverId?.trim();
+      if (serverId && !serverIds.includes(serverId)) {
+        serverIds.push(serverId);
+      }
+    } catch (error) {
+      console.warn("[polaris-host-sync] failed to upsert host", host.name, error);
+    }
+  }
+  const preferredServerId = serverIds[0] ?? null;
+  return {
+    serverIds,
+    preferredServerId,
+    preferredHref: preferredServerId ? buildHostRootRoute(preferredServerId) : null,
+  };
+}
+
+/** Deduplicate concurrent login/welcome syncs. */
+export function syncPolarisHostsOnce(options: {
+  token: string;
+  upsertFromOfferUrl: UpsertFromOfferUrl;
+}): Promise<SyncPolarisHostsResult> {
+  if (inflight) return inflight;
+  inflight = syncPolarisHostsFromApi(options).finally(() => {
+    inflight = null;
+  });
+  return inflight;
+}
+
+export function resolvePostLoginHref(options: {
+  preferredHref: string | null;
+  returnPath: string;
+}): string {
+  if (options.preferredHref) return options.preferredHref;
+  const returnPath = options.returnPath.trim();
+  if (returnPath && returnPath !== "/welcome" && returnPath !== "/") {
+    return returnPath;
+  }
+  return "/settings";
+}
