// ============================================================
// 业务包：摄影自动化（Studio Automation）
// 语言内核不变；本文件只描述意义 / 计算 / FFI 端口
//
// 链路：
//   机械臂就位 → 相机拍照 → 推送图库 → 修图粗修 → 展示屏投放
// ============================================================

domain PhotoStudio version "0.1"
title "摄影自动化工作室"
description "控制相机机械臂取景，拍照入库粗修，并投放到展示屏"

// ── 意义：单据与状态 ────────────────────────────────────────

enum ShootStatus {
  Draft,
  Positioned,
  Captured,
  InGallery,
  Retouched,
  OnScreen,
  Failed
}

entity ShootJob {
  id              : ID
  subject         : String
  status          : ShootStatus
  targetPose      : String
  actualPose      : String?
  exposure        : String?
  rawImageId      : String?
  galleryAssetId  : String?
  retouchedId     : String?
  screenId        : String?
  displaySession  : String?
  preset          : String?
}

// ── FFI 端口（外界设备/软件；Host 绑定真实驱动）──────────────
// 语言里只有契约；MockHost 开发态模拟，生产换 Robot/Camera SDK 等

// 机械臂：相机装在法兰上，移动到取景位姿
port RobotArmMove {
  in {
    targetPose : String
    speed      : Number
  }
  out {
    actualPose  : String
    poseReached : Boolean
  }
  effect ffi
}

// 相机：曝光/对焦后快门
port CameraCapture {
  in {
    exposure : String
    focus    : String
  }
  out {
    rawImageId : String
    width      : Number
    height     : Number
  }
  effect ffi
}

// 图库：原始/成片入库
port GalleryIngest {
  in {
    rawImageId : String
    subject    : String
    tags       : String
  }
  out {
    galleryAssetId : String
  }
  effect ffi
}

// 修图软件：按预设自动粗修（裁切、曝光、白平衡…）
port RetouchRough {
  in {
    galleryAssetId : String
    preset         : String
  }
  out {
    retouchedId : String
  }
  effect ffi
}

// 展示屏：投放指定成片
port DisplayShow {
  in {
    retouchedId : String
    screenId    : String
  }
  out {
    displaySession : String
  }
  effect ffi
}

// ── 一键全流程（演示主路径）────────────────────────────────

flow AutoShoot title "一键拍摄投放" on ShootJob {
  create
  needs { RobotArmMove, CameraCapture, GalleryIngest, RetouchRough, DisplayShow }
  description "机械臂就位 → 拍照 → 入库 → 粗修 → 上屏（端到端）"

  input {
    subject    : String required label "拍摄对象" placeholder "新品 bare 灯 / 模特 A"
    targetPose : String required label "目标位姿" placeholder "pose://shelf-A/front-0.8m"
    speed      : Number required min 1 label "臂速%" placeholder "40"
    exposure   : String required label "曝光" placeholder "1/125 f/5.6 ISO200"
    focus      : String required label "对焦" placeholder "auto-center"
    tags       : String required label "图库标签" placeholder "product,hero,auto"
    preset     : String required label "粗修预设" placeholder "product-clean-v2"
    screenId   : String required label "展示屏" placeholder "wall-led-01"
  }

  require { true }

  steps {
    move_arm "机械臂就位" {
      uses { targetPose, speed }
      call RobotArmMove
      output {
        actualPose  : String label "实际位姿"
        poseReached : Boolean label "是否到位"
      }
    }
    snap "相机拍照" {
      uses { exposure, focus }
      call CameraCapture
      output {
        rawImageId : String label "原图 ID"
        width      : Number
        height     : Number
      }
    }
    push_gallery "推送图库" {
      uses { rawImageId, subject, tags }
      call GalleryIngest
      output {
        galleryAssetId : String label "图库资产"
      }
    }
    rough_edit "自动粗修" {
      uses { galleryAssetId, preset }
      call RetouchRough
      output {
        retouchedId : String label "粗修成片"
      }
    }
    show_screen "投放展示屏" {
      uses { retouchedId, screenId }
      call DisplayShow
      output {
        displaySession : String label "投放会话"
      }
    }
  }

  output {
    jobId          : ID     from record.id label "任务号"
    actualPose     : String from actualPose
    rawImageId     : String from rawImageId
    galleryAssetId : String from galleryAssetId
    retouchedId    : String from retouchedId
    displaySession : String from displaySession
    status         : ShootStatus from record.status
  }

  transition status -> OnScreen
  emit ShootPresented

  ui {
    layout form
    primary "开始拍摄并投放"
    icon "plus-circle"
  }
}

// ── 可拆分重跑（现场调试 / 只重拍 / 只重修）────────────────

flow PositionArm title "仅：机械臂就位" on ShootJob {
  create
  needs { RobotArmMove }
  description "只移动到取景位，不拍照"
  input {
    subject    : String required label "拍摄对象"
    targetPose : String required label "目标位姿"
    speed      : Number required min 1 label "臂速%"
  }
  require { true }
  steps {
    move_arm "机械臂就位" {
      uses { targetPose, speed }
      call RobotArmMove
      output {
        actualPose  : String
        poseReached : Boolean
      }
    }
  }
  output {
    jobId      : ID from record.id
    actualPose : String from actualPose
    status     : ShootStatus from record.status
  }
  transition status -> Positioned
  emit ArmPositioned
  ui {
    layout form
    primary "移动到位"
    icon "workflow"
  }
}

flow CaptureOnly title "仅：拍照" on ShootJob {
  needs { CameraCapture }
  description "臂已到位后快门（可重复拍）"
  input {
    recordId : String required label "拍摄任务"
    exposure : String required label "曝光"
    focus    : String required label "对焦"
  }
  require { status in [Positioned, Captured, InGallery, Retouched, OnScreen] }
  steps {
    snap "相机拍照" {
      uses { exposure, focus }
      call CameraCapture
      output {
        rawImageId : String
        width      : Number
        height     : Number
      }
    }
  }
  output {
    rawImageId : String from rawImageId
    status     : ShootStatus from record.status
  }
  transition status -> Captured
  emit ShotCaptured
  ui {
    layout form
    primary "快门"
    icon "workflow"
  }
}

flow IngestAndRetouch title "入库并粗修" on ShootJob {
  needs { GalleryIngest, RetouchRough }
  description "已有原图：推图库 + 粗修"
  input {
    recordId : String required label "拍摄任务"
    subject  : String required label "对象"
    tags     : String required label "标签"
    preset   : String required label "粗修预设"
  }
  require { status in [Captured, InGallery, Retouched, OnScreen] }
  steps {
    push_gallery "推送图库" {
      uses { rawImageId, subject, tags }
      call GalleryIngest
      output {
        galleryAssetId : String
      }
    }
    rough_edit "自动粗修" {
      uses { galleryAssetId, preset }
      call RetouchRough
      output {
        retouchedId : String
      }
    }
  }
  output {
    galleryAssetId : String from galleryAssetId
    retouchedId    : String from retouchedId
    status         : ShootStatus from record.status
  }
  transition status -> Retouched
  emit ShotRetouched
  ui {
    layout form
    primary "入库粗修"
    icon "workflow"
  }
}

flow PresentScreen title "投放展示屏" on ShootJob {
  needs { DisplayShow }
  description "成片上墙 / 上屏"
  input {
    recordId : String required label "拍摄任务"
    screenId : String required label "展示屏"
  }
  require { status in [Retouched, OnScreen] }
  steps {
    show_screen "投放展示屏" {
      uses { retouchedId, screenId }
      call DisplayShow
      output {
        displaySession : String
      }
    }
  }
  output {
    displaySession : String from displaySession
    status         : ShootStatus from record.status
  }
  transition status -> OnScreen
  emit ShootPresented
  ui {
    layout form
    primary "上屏"
    icon "workflow"
  }
}
