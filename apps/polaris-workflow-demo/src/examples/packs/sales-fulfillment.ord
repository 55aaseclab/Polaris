// 域包：履约销售 — 跨包 import + port 版本 + pipeline 糖
domain SalesFulfillment version "1.0.0"
title "销售履约"
description "import Inventory + Notify；ReserveStock@2；pipeline 主路径"

import Inventory version "^1.2"
import Notify version "1.0" as N

enum OrderStatus {
  Draft,
  Reserved,
  Notified,
  Done
}

entity Order {
  id       : ID
  customer : String
  sku      : String
  qty      : Number
  status   : OrderStatus
}

// 编排糖：声明 flow 主路径（展开为元数据，不替代单 flow 事务）
pipeline FulfillMain title "履约主路径" {
  PlaceAndReserve -> CloseOrder
}

flow PlaceAndReserve title "下单并预留" on Order {
  create
  needs { ReserveStock@2.0.0, N.PushMessage }
  description "跨域包：Inventory.ReserveStock@2 + N.PushMessage"
  input {
    customer  : String required label "客户"
    sku       : String required label "SKU"
    qty       : Number required min 1 label "数量"
    warehouse : String required label "仓" placeholder "SH-01"
  }
  require { true }
  steps {
    reserve "预留库存 v2" {
      uses { sku, qty, warehouse }
      call ReserveStock@2.0.0
      output {
        reservationId : String
        warehouse     : String
      }
    }
    write "写订单" {
      uses { customer, sku, qty, reservationId }
      output {
        orderId : ID
      }
    }
    ping "通知客户" {
      uses { customer, orderId }
      call N.PushMessage
      output {
        messageId : String
      }
    }
  }
  output {
    orderId       : ID from orderId
    reservationId : String from reservationId
    messageId     : String from messageId
    status        : OrderStatus from record.status
  }
  transition status -> Notified
  emit OrderReserved
  ui {
    layout form
    primary "下单预留"
    icon "plus-circle"
  }
}

flow CloseOrder title "结案归档" on Order {
  needs { ReleaseStock@1.0.0 }
  description "释放预留并结案（pipeline 第二步）"
  input {
    recordId : String required label "订单"
  }
  require { status == Notified }
  steps {
    release "释放库存" {
      uses { reservationId }
      call ReleaseStock@1.0.0
      output {
        released : Boolean
      }
    }
    archive "归档" {
      uses { recordId, released }
      output {
        closed : Boolean
      }
    }
  }
  output {
    released : Boolean from released
    status   : OrderStatus from record.status
  }
  transition status -> Done
  emit OrderClosed
  ui {
    layout form
    primary "结案"
    icon "workflow"
  }
}
