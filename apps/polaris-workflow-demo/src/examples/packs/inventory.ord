// 域包：库存能力（被其他域包 import）
domain Inventory version "1.2.0"
title "库存域包"
description "提供预留/释放库存的 FFI 端口（多版本 ReserveStock）"

enum StockStatus { Free, Held, Spent }

entity StockHold {
  id     : ID
  sku    : String
  qty    : Number
  status : StockStatus
}

// v1：简单预留
port ReserveStock version "1.0.0" {
  in {
    sku : String
    qty : Number
  }
  out {
    reservationId : String
  }
  effect ffi
}

// v2：增加仓码
port ReserveStock version "2.0.0" {
  in {
    sku       : String
    qty       : Number
    warehouse : String?
  }
  out {
    reservationId : String
    warehouse     : String
  }
  effect ffi
}

port ReleaseStock version "1.0.0" {
  in {
    reservationId : String
  }
  out {
    released : Boolean
  }
  effect ffi
}
