// Polaris DSL · 销售记录业务包
// P1：port = FFI；step.call 只点名；Host(mock) 负责实现

domain SalesRecord version "0.3"
title "销售记录工作台"
description "意义/计算/FFI：uses·out 可见，call port 走 Host"

enum Status {
  Draft,
  Created,
  Shipped,
  Paid,
  Closed
}

entity Order {
  id         : ID
  customer   : String
  sku        : String
  qty        : Number
  amount     : Money
  currency   : String = "CNY"
  status     : Status
  address    : String?
  trackingNo : String?
  warehouse  : String?
  paidAmount : Money = 0
  method     : String?
  reference  : String?
}

// ── FFI 端口（契约 only，无路径）────────────────────────────

port ReserveStock {
  in {
    sku : String
    qty : Number
  }
  out {
    reservationId : String
  }
  effect ffi
}

port NotifyCustomer {
  in {
    customer : String
    orderId  : ID
  }
  out {
    notifyRef : String
  }
  effect ffi
}

port BookShipment {
  in {
    packageId  : String
    carrier    : String
    trackingNo : String
  }
  out {
    shipmentId : String
  }
  effect ffi
}

port CapturePayment {
  in {
    method     : String
    paidAmount : Money
    reference  : String
  }
  out {
    paymentId : String
  }
  effect ffi
}

// ── Flows ───────────────────────────────────────────────────

flow CreateOrder title "创建订单" on Order {
  create
  needs { ReserveStock, NotifyCustomer }
  description "纯计算校验 + FFI 预留/通知"
  input {
    customer : String required label "客户" placeholder "例如：上海星火贸易"
    sku      : String required label "SKU" placeholder "SKU-10086"
    qty      : Number required min 1 label "数量"
    amount   : Money  required min 0 label "订单金额"
    address  : String required label "收货地址" placeholder "上海市浦东新区…"
  }
  require { true }
  steps {
    validate_items "校验商品与数量" {
      uses { sku, qty }
      output {
        lineKey : String label "行键"
      }
    }
    check_stock "预留库存" {
      uses { sku, qty }
      call ReserveStock
      output {
        reservationId : String label "预留单号"
      }
    }
    create_order "写入订单" {
      uses { customer, sku, qty, amount, address, reservationId }
      output {
        orderId : ID label "订单号"
      }
    }
    notify_customer "通知客户" {
      uses { customer, orderId }
      call NotifyCustomer
      output {
        notifyRef : String label "通知凭证"
      }
    }
  }
  output {
    orderId       : ID     from orderId label "订单号"
    reservationId : String from reservationId label "预留单号"
    notifyRef     : String from notifyRef label "通知凭证"
    status        : Status from record.status label "状态"
  }
  transition status -> Created
  emit OrderCreated
  ui {
    layout form
    primary "提交创建"
    icon "plus-circle"
  }
}

flow ShipOrder title "发货" on Order {
  needs { BookShipment }
  description "拣货纯计算 + FFI 订舱"
  input {
    recordId   : String required label "订单号"
    warehouse  : String required label "发货仓" placeholder "SH-01"
    carrier    : String required label "承运商" placeholder "顺丰"
    trackingNo : String required label "物流单号" placeholder "SF1234567890"
  }
  require { status == Created }
  steps {
    pick_pack "拣货打包" {
      uses { recordId, warehouse }
      output {
        packageId : String label "包裹号"
      }
    }
    allocate_shipment "分配运单" {
      uses { packageId, carrier, trackingNo }
      call BookShipment
      output {
        shipmentId : String label "运单内部号"
      }
    }
    mark_shipped "标记已发货" {
      uses { recordId, shipmentId, trackingNo }
      output {
        shippedAt : String label "发货标记"
      }
    }
  }
  output {
    recordId   : ID     from recordId
    trackingNo : String from trackingNo label "物流单号"
    shipmentId : String from shipmentId label "运单内部号"
    status     : Status from record.status
  }
  transition status -> Shipped
  emit OrderShipped
  ui {
    layout form
    primary "确认发货"
    icon "truck"
  }
}

flow RemitPayment title "汇款" on Order {
  needs { CapturePayment }
  description "金额校验 + FFI 收款"
  input {
    recordId   : String required label "订单号"
    method     : String required label "汇款方式" placeholder "银行转账 / 支付宝"
    paidAmount : Money  required min 0 label "汇款金额"
    reference  : String required label "凭证号" placeholder "TXN-2026-…"
  }
  require { status in [Created, Shipped] }
  steps {
    verify_amount "核验应付金额" {
      uses { recordId, paidAmount }
      output {
        settled : Boolean label "是否足额"
      }
    }
    record_payment "登记收款" {
      uses { method, paidAmount, reference }
      call CapturePayment
      output {
        paymentId : String label "收款单号"
      }
    }
    mark_paid "标记已付款" {
      uses { recordId, paymentId }
      output {
        paidFlag : Boolean label "已付标记"
      }
    }
  }
  output {
    recordId   : ID     from recordId
    paymentId  : String from paymentId label "收款单号"
    paidAmount : Money  from paidAmount
    status     : Status from record.status
  }
  transition status -> Paid
  emit PaymentReceived
  ui {
    layout form
    primary "确认汇款"
    icon "banknote"
  }
}
