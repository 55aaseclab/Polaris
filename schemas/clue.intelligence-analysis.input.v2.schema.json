{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clue.intelligence-analysis.input.v2",
  "title": "Intelligence analysis input v2",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_kind",
    "question",
    "decision_context",
    "audience",
    "collection_ref",
    "review_policy"
  ],
  "$defs": {
    "prompt_spec": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {
          "enum": [
            "generate-text",
            "generate-file",
            "derive",
            "copy-file"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "output_kind": {
          "enum": [
            "text",
            "markdown",
            "json",
            "string_array"
          ]
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "const": "clue.intelligence-analysis.input.v2"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_kind": {
      "enum": [
        "literature-review",
        "ad-content-review",
        "business-analysis",
        "product-analysis"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "question_prompt": {
      "$ref": "#/$defs/prompt_spec"
    },
    "decision_context": {
      "type": "string",
      "minLength": 1
    },
    "decision_context_prompt": {
      "$ref": "#/$defs/prompt_spec"
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "audience_prompt": {
      "$ref": "#/$defs/prompt_spec"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_reasoning_effort": {
      "type": "string",
      "minLength": 1
    },
    "literature_method": {
      "enum": [
        "iterate",
        "batches",
        "propose"
      ]
    },
    "minimum_distinct_sources": {
      "type": "integer",
      "minimum": 1
    },
    "collection_ref": {
      "type": "object",
      "required": [
        "collection_id",
        "collection_output_sha256",
        "collection_output_path"
      ],
      "properties": {
        "collection_id": {
          "type": "string",
          "minLength": 1
        },
        "collection_output_sha256": {
          "type": "string",
          "minLength": 1
        },
        "collection_output_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "screening": {
      "type": "object",
      "required": [
        "included_record_ids"
      ],
      "properties": {
        "included_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "review_policy": {
      "type": "object",
      "properties": {
        "minimum_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.75
        },
        "review_all_claims": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "enum": [
            "auto-pass",
            "auto-approve",
            "manual-review"
          ],
          "default": "auto-pass",
          "description": "Select whether review is bypassed, automatically approved, or held for a human decision."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
