{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.seo.site.v1.schema.json",
  "title": "wanghai.seo.site v1",
  "description": "Long-lived SEO-operated website asset (one site per folder under seo-ops/sites/).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "site_id",
    "name",
    "primary_domain",
    "status",
    "locale",
    "markets",
    "positioning",
    "integrations",
    "playbook",
    "notes",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": "wanghai.seo.site" },
    "schema_version": { "const": 1 },
    "site_id": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "primary_domain": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["planning", "building", "live", "paused", "archived"]
    },
    "locale": { "type": "string", "enum": ["zh", "en", "multi"] },
    "markets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icp", "one_liner", "search_fit"],
      "properties": {
        "icp": { "type": ["string", "null"] },
        "one_liner": { "type": ["string", "null"] },
        "search_fit": { "type": ["string", "null"] }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ga4_property_id", "gsc_site_url", "clarity_project_id"],
      "properties": {
        "ga4_property_id": { "type": ["string", "null"] },
        "gsc_site_url": { "type": ["string", "null"] },
        "clarity_project_id": { "type": ["string", "null"] }
      }
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "task_states"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "task_states": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "updated_at", "note"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["todo", "doing", "done", "blocked", "skipped"]
              },
              "updated_at": { "type": "string", "minLength": 1 },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
