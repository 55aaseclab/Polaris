{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.promo.video-snapshot.v1.schema.json",
  "title": "wanghai.promo.video-snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "video_id",
    "frozen_at",
    "from_input_sha256",
    "platform",
    "purpose",
    "locale",
    "mode",
    "engine",
    "fallback",
    "api",
    "target",
    "product",
    "compare",
    "script",
    "captions",
    "cover_plan",
    "audio_plan",
    "timeline",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "wanghai.promo.video-snapshot" },
    "schema_version": { "const": 1 },
    "video_id": { "type": "string", "minLength": 2 },
    "frozen_at": { "type": "string", "minLength": 1 },
    "from_input_sha256": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "string",
      "enum": ["douyin", "xiaohongshu", "tiktok", "instagram", "generic"]
    },
    "purpose": {
      "type": "string",
      "enum": ["seed", "unbox", "scene", "compare"]
    },
    "locale": { "type": "string", "enum": ["zh", "en"] },
    "mode": {
      "type": "string",
      "enum": ["stills_motion", "footage"]
    },
    "engine": {
      "type": "string",
      "enum": ["ffmpeg_kenburns", "image_to_video_api"]
    },
    "fallback": {
      "type": ["string", "null"],
      "enum": ["ffmpeg_kenburns", null]
    },
    "api": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "model", "endpoint_env", "per_shot_prompt_template"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "endpoint_env": { "type": ["string", "null"] },
        "per_shot_prompt_template": { "type": ["string", "null"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "duration_sec",
        "width",
        "height",
        "fps",
        "allow_duration_tolerance_sec"
      ],
      "properties": {
        "aspect_ratio": { "type": "string" },
        "duration_sec": { "type": "number" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "fps": { "type": "integer" },
        "allow_duration_tolerance_sec": { "type": "number" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "slug",
        "batch",
        "display_name",
        "name_en",
        "category",
        "status",
        "source_meta_sha256",
        "copy",
        "images"
      ],
      "properties": {
        "product_id": { "type": "integer" },
        "slug": { "type": "string" },
        "batch": { "type": "string" },
        "display_name": { "type": "string" },
        "name_en": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "source_meta_sha256": { "type": "string", "minLength": 1 },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "selling_points", "description"],
          "properties": {
            "title": { "type": ["string", "null"] },
            "selling_points": {
              "type": "array",
              "items": { "type": "string" }
            },
            "description": { "type": ["string", "null"] }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["near", "wear", "detail", "promo_usage"],
          "properties": {
            "near": { "$ref": "#/$defs/imageRef" },
            "wear": { "$ref": "#/$defs/imageRef" },
            "detail": { "$ref": "#/$defs/imageRef" },
            "promo_usage": { "$ref": "#/$defs/imageRef" }
          }
        }
      }
    },
    "compare": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "mode",
        "baseline_label",
        "baseline_image",
        "other_product_id",
        "other_label",
        "other"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["vs_feature", "vs_product"] },
        "baseline_label": { "type": "string" },
        "baseline_image": { "$ref": "#/$defs/imageRef" },
        "other_product_id": { "type": ["integer", "null"] },
        "other_label": { "type": ["string", "null"] },
        "other": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "product_id",
            "slug",
            "batch",
            "display_name",
            "source_meta_sha256",
            "images"
          ],
          "properties": {
            "product_id": { "type": "integer" },
            "slug": { "type": "string" },
            "batch": { "type": "string" },
            "display_name": { "type": "string" },
            "source_meta_sha256": { "type": "string" },
            "images": {
              "type": "object",
              "additionalProperties": false,
              "required": ["near", "wear", "detail", "promo_usage"],
              "properties": {
                "near": { "$ref": "#/$defs/imageRef" },
                "wear": { "$ref": "#/$defs/imageRef" },
                "detail": { "$ref": "#/$defs/imageRef" },
                "promo_usage": { "$ref": "#/$defs/imageRef" }
              }
            }
          }
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "cta"],
      "properties": {
        "hook": { "type": "string" },
        "cta": { "type": "string" }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "burn_in", "style"],
      "properties": {
        "enabled": { "type": "boolean" },
        "burn_in": { "type": "boolean" },
        "style": { "type": "string" }
      }
    },
    "cover_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "frame_at_sec", "preferred_slot"],
      "properties": {
        "source": { "type": "string" },
        "frame_at_sec": { "type": ["number", "null"] },
        "preferred_slot": {
          "type": ["string", "null"],
          "enum": ["near", "wear", "detail", "promo_usage", null]
        }
      }
    },
    "audio_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_bgm", "loop_bgm", "bgm", "tts", "voiceover", "music_duck_db"],
      "properties": {
        "require_bgm": { "type": "boolean" },
        "loop_bgm": { "type": "boolean" },
        "bgm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "sha256", "volume", "license_note"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "volume": { "type": "number" },
            "license_note": { "type": ["string", "null"] }
          }
        },
        "tts": { "type": ["object", "null"] },
        "voiceover": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "sha256", "volume"],
          "properties": {
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "volume": { "type": "number" }
          }
        },
        "music_duck_db": { "type": ["number", "null"] }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "role",
          "t_start",
          "t_end",
          "duration_sec",
          "text",
          "motion",
          "source",
          "caption_box",
          "render_trace"
        ],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "role": { "type": "string" },
          "t_start": { "type": "number", "minimum": 0 },
          "t_end": { "type": "number", "minimum": 0 },
          "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
          "text": { "type": "string" },
          "motion": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "sha256", "slot"],
            "properties": {
              "kind": { "type": "string", "enum": ["image", "clip"] },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "minLength": 1 },
              "slot": {
                "type": ["string", "null"],
                "enum": ["near", "wear", "detail", "promo_usage", null]
              }
            }
          },
          "caption_box": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "w": { "type": "integer" },
              "h": { "type": "integer" }
            }
          },
          "render_trace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "provider", "request_id", "fallback_used"],
            "properties": {
              "engine": { "type": ["string", "null"] },
              "provider": { "type": ["string", "null"] },
              "request_id": { "type": ["string", "null"] },
              "fallback_used": { "type": "boolean" }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "imageRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 }
      }
    }
  }
}
