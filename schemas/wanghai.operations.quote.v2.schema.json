{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.operations.quote.v2.schema.json",
  "title": "wanghai.operations.quote v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "order_no",
    "status",
    "quote_no",
    "quote_date",
    "valid_until",
    "currency",
    "customer_text",
    "ports",
    "trade_term",
    "container",
    "payment_terms",
    "delivery_time",
    "partial_shipment",
    "quantity_tolerance",
    "items",
    "totals",
    "documents",
    "notes"
  ],
  "properties": {
    "schema": { "const": "wanghai.operations.quote" },
    "schema_version": { "const": 2 },
    "order_no": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "sent", "accepted", "expired", "cancelled"] },
    "quote_no": { "type": ["string", "null"] },
    "quote_date": { "type": ["string", "null"] },
    "valid_until": { "type": ["string", "null"] },
    "currency": { "type": "string", "minLength": 1 },
    "customer_text": { "type": ["string", "null"] },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loading", "discharge"],
      "properties": {
        "loading": { "type": ["string", "null"] },
        "discharge": { "type": ["string", "null"] }
      }
    },
    "trade_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "place"],
      "properties": {
        "label": { "type": ["string", "null"] },
        "place": { "type": ["string", "null"] }
      }
    },
    "container": { "type": ["string", "null"] },
    "payment_terms": { "type": ["string", "null"] },
    "delivery_time": { "type": ["string", "null"] },
    "partial_shipment": { "type": ["string", "null"] },
    "quantity_tolerance": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_no",
          "product_id",
          "description",
          "package_description",
          "size",
          "quantity_ctns",
          "weight_kgs",
          "unit_price_usd_per_kg",
          "amount_usd",
          "notes"
        ],
        "properties": {
          "line_no": { "type": "integer" },
          "product_id": { "type": ["string", "integer", "null"] },
          "description": { "type": ["string", "null"] },
          "package_description": { "type": ["string", "null"] },
          "size": { "type": ["string", "null"] },
          "quantity_ctns": { "type": ["number", "null"] },
          "weight_kgs": { "type": ["number", "null"] },
          "unit_price_usd_per_kg": { "type": ["number", "null"] },
          "amount_usd": { "type": ["number", "null"] },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity_ctns", "weight_kgs", "amount_usd", "amount_words"],
      "properties": {
        "quantity_ctns": { "type": ["number", "null"] },
        "weight_kgs": { "type": ["number", "null"] },
        "amount_usd": { "type": ["number", "null"] },
        "amount_words": { "type": ["string", "null"] }
      }
    },
    "documents": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
