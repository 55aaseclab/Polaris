{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clue.intelligence.collection-snapshot.v1",
  "title": "Immutable intelligence collection snapshot",
  "type": "object",
  "required": ["schema_version", "snapshot_id", "created_at", "clues"],
  "properties": {
    "schema_version": { "const": "clue.intelligence.collection-snapshot.v1" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "clues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clue_id",
          "source_url",
          "observed_at",
          "content_hash",
          "observations"
        ],
        "properties": {
          "clue_id": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "format": "date-time" },
          "content_hash": { "type": "string", "minLength": 1 },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["observation_id", "quote"],
              "properties": {
                "observation_id": { "type": "string", "minLength": 1 },
                "quote": { "type": "string", "minLength": 1 },
                "locator": { "type": "string" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
