{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.operations.inspection.v1.schema.json",
  "title": "wanghai.operations.inspection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "order_no", "status", "inspection_no", "inspection_date", "items", "checks", "documents", "notes"],
  "properties": {
    "schema": { "const": "wanghai.operations.inspection" },
    "schema_version": { "const": 1 },
    "order_no": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pending", "draft", "passed", "failed", "recheck"] },
    "inspection_no": { "type": ["string", "null"] },
    "inspection_date": { "type": ["string", "null"] },
    "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "checks": { "type": "object", "additionalProperties": true },
    "documents": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
