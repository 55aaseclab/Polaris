{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Polaris generic manual review state v2",
  "type": "object",
  "required": [
    "schema_version",
    "review_set_id",
    "review_kind",
    "created_at",
    "updated_at",
    "reviews",
    "audit"
  ],
  "properties": {
    "schema_version": { "const": "clue.manual-review.state.v2" },
    "review_set_id": { "type": "string", "minLength": 1 },
    "review_kind": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "producer": { "type": "object" },
    "sources": { "type": "object" },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "note", "revision_hash", "updated_at"],
        "properties": {
          "status": { "enum": ["pending", "approved", "rejected"] },
          "note": { "type": "string", "maxLength": 5000 },
          "revision_hash": { "type": "string", "minLength": 1 },
          "updated_at": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "audit": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
