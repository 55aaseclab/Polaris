{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.operations.invoice.v1.schema.json",
  "title": "wanghai.operations.invoice v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "order_no", "status", "invoice_type", "invoice_no", "issue_date", "buyer", "currency", "amount", "documents", "notes"],
  "properties": {
    "schema": { "const": "wanghai.operations.invoice" },
    "schema_version": { "const": 1 },
    "order_no": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["not_requested", "collecting_info", "draft", "issued", "cancelled"] },
    "invoice_type": { "type": ["string", "null"] },
    "invoice_no": { "type": ["string", "null"] },
    "issue_date": { "type": ["string", "null"] },
    "buyer": { "type": "object", "additionalProperties": true },
    "currency": { "type": "string", "minLength": 1 },
    "amount": { "type": ["number", "null"] },
    "documents": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
