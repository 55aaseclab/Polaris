{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.operations.payment.v1.schema.json",
  "title": "wanghai.operations.payment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "order_no", "status", "receivable_amount", "received_amount", "method", "received_at", "exchange_rate", "proof_documents", "documents", "notes"],
  "properties": {
    "schema": { "const": "wanghai.operations.payment" },
    "schema_version": { "const": 1 },
    "order_no": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pending", "partial", "paid", "refunded", "unverified"] },
    "receivable_amount": { "type": ["number", "null"] },
    "received_amount": { "type": ["number", "null"] },
    "method": { "type": ["string", "null"] },
    "received_at": { "type": ["string", "null"] },
    "exchange_rate": { "type": ["number", "null"] },
    "proof_documents": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "path", "kind"], "properties": { "label": { "type": "string" }, "path": { "type": "string" }, "kind": { "type": "string" } } } },
    "documents": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "path", "kind"], "properties": { "label": { "type": "string" }, "path": { "type": "string" }, "kind": { "type": "string" } } } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
