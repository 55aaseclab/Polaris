{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.operations.quote.v1.schema.json",
  "title": "wanghai.operations.quote v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "order_no", "status", "quote_no", "quote_date", "valid_until", "currency", "items", "totals", "documents", "notes"],
  "properties": {
    "schema": { "const": "wanghai.operations.quote" },
    "schema_version": { "const": 1 },
    "order_no": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "sent", "accepted", "expired", "cancelled"] },
    "quote_no": { "type": ["string", "null"] },
    "quote_date": { "type": ["string", "null"] },
    "valid_until": { "type": ["string", "null"] },
    "currency": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_no", "product_id", "quantity", "discount_price", "amount", "notes"],
        "properties": {
          "line_no": { "type": "integer" },
          "product_id": { "type": ["string", "integer"] },
          "quantity": { "type": ["number", "null"] },
          "discount_price": { "type": ["number", "null"] },
          "amount": { "type": ["number", "null"] },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "totals": { "type": "object", "additionalProperties": true },
    "documents": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
