{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.seo.metrics-snapshot.v1.schema.json",
  "title": "wanghai.seo.metrics-snapshot v1",
  "description": "Traffic / search metrics snapshot for one site (GA4 / GSC / manual).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "site_id",
    "source",
    "period_start",
    "period_end",
    "captured_at",
    "totals",
    "notes"
  ],
  "properties": {
    "schema": { "const": "wanghai.seo.metrics-snapshot" },
    "schema_version": { "const": 1 },
    "site_id": { "type": "string", "minLength": 2 },
    "source": {
      "type": "string",
      "enum": ["ga4", "gsc", "manual", "mixed"]
    },
    "period_start": { "type": "string", "minLength": 1 },
    "period_end": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "minLength": 1 },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "users",
        "pageviews",
        "organic_sessions",
        "clicks",
        "impressions",
        "ctr",
        "avg_position"
      ],
      "properties": {
        "sessions": { "type": ["number", "null"] },
        "users": { "type": ["number", "null"] },
        "pageviews": { "type": ["number", "null"] },
        "organic_sessions": { "type": ["number", "null"] },
        "clicks": { "type": ["number", "null"] },
        "impressions": { "type": ["number", "null"] },
        "ctr": { "type": ["number", "null"] },
        "avg_position": { "type": ["number", "null"] }
      }
    },
    "top_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "pageviews", "sessions"],
        "properties": {
          "path": { "type": "string" },
          "pageviews": { "type": ["number", "null"] },
          "sessions": { "type": ["number", "null"] }
        }
      }
    },
    "top_queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "clicks", "impressions", "position"],
        "properties": {
          "query": { "type": "string" },
          "clicks": { "type": ["number", "null"] },
          "impressions": { "type": ["number", "null"] },
          "position": { "type": ["number", "null"] }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
