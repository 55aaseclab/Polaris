{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wanghai.local/schemas/wanghai.operations.shipment.v1.schema.json",
  "title": "wanghai.operations.shipment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "order_no", "status", "carrier", "channel", "tracking_no", "ship_date", "destination_country", "packages", "costs", "documents", "notes"],
  "properties": {
    "schema": { "const": "wanghai.operations.shipment" },
    "schema_version": { "const": 1 },
    "order_no": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["pending", "ready", "shipped", "delivered", "exception"] },
    "carrier": { "type": ["string", "null"] },
    "channel": { "type": ["string", "null"] },
    "tracking_no": { "type": ["string", "null"] },
    "ship_date": { "type": ["string", "null"] },
    "destination_country": { "type": ["string", "null"] },
    "packages": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "costs": { "type": "object", "additionalProperties": true },
    "documents": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
