// Wanghai ecommerce domain pack for the first Polaris workflow vertical slice.
// The pack describes product and order meaning; the host owns persistence and effects.

domain Ecommerce version "0.2.0"
title "电商产品与订单"
description "产品登记、订单创建、审批、发货与收款的最小业务工作流"

enum ProductStatus {
  Draft,
  Review,
  Ready
}

enum OrderStatus {
  Draft,
  Created,
  Approved,
  Shipped,
  Paid,
  Cancelled
}

entity Product {
  id            : ID
  sku           : String
  name          : String?
  nameEn        : String?
  status        : ProductStatus
  inventory     : Number?
  defaultMarket : String
  description   : String?
}

entity ProductOffer {
  id         : ID
  productId  : ID
  market     : String
  currency   : String
  listPrice  : Money?
  promoPrice : Money?
  floorPrice : Money?
}

entity ProductCost {
  id             : ID
  productId      : ID
  currency       : String
  purchasePrice  : Money?
  packagingPrice : Money?
  laborPrice     : Money?
}

entity Order {
  id         : ID
  orderNo    : String
  customer   : String
  sku        : String
  quantity   : Number
  amount     : Money
  trackingNo : String?
  paymentRef : String?
  status     : OrderStatus
}

pipeline OrderLifecycle title "订单生命周期" {
  CreateOrder -> ApproveOrder -> ShipOrder -> RecordPayment
}

flow CreateProduct title "创建产品" on Product {
  create
  description "创建产品主数据，并为默认市场建立首个价格投影"
  input {
    skuSubcategory : String required label "SKU 子类"
    name           : String required label "产品名称"
    nameEn         : String label "英文名称"
    inventory      : Number min 0 label "库存"
    defaultMarket  : String required label "默认市场"
    description    : String label "产品描述"
    market         : String required label "价格市场"
    currency       : String required label "销售币种"
    listPrice      : Money min 0 label "标价"
    promoPrice     : Money min 0 label "促销价"
    floorPrice     : Money min 0 label "最低价"
    costCurrency   : String label "成本币种"
    purchasePrice  : Money min 0 label "采购成本"
    packagingPrice : Money min 0 label "包装成本"
    laborPrice     : Money min 0 label "人工成本"
  }
  require { true }
  steps {
    validate_product "校验产品资料" {
      uses { skuSubcategory, name, nameEn, inventory, defaultMarket, description, market, currency, listPrice, promoPrice, floorPrice, costCurrency, purchasePrice, packagingPrice, laborPrice }
      output { valid : Boolean }
    }
    create_product "写入产品" {
      uses { skuSubcategory, name, nameEn, inventory, defaultMarket, description, market, currency, listPrice, promoPrice, floorPrice, costCurrency, purchasePrice, packagingPrice, laborPrice }
      output { productId : ID }
    }
  }
  output {
    productId : ID from productId
    status    : ProductStatus from record.status
  }
  transition status -> Draft
  emit ProductCreated
  ui {
    layout form
    primary "创建产品"
    icon "plus-circle"
  }
}

flow UpdateProduct title "修改产品" on Product {
  description "修改产品主数据，不改变 SKU 身份"
  input {
    recordId      : String required label "产品"
    name          : String label "产品名称"
    nameEn        : String label "英文名称"
    status        : ProductStatus label "状态"
    inventory     : Number min 0 label "库存"
    defaultMarket : String label "默认市场"
    description   : String label "产品描述"
  }
  require { true }
  steps {
    validate_product_update "校验修改" {
      uses { recordId, name, nameEn, status, inventory, defaultMarket, description }
      output { valid : Boolean }
    }
    update_product "保存产品" {
      uses { recordId, name, nameEn, status, inventory, defaultMarket, description }
      output { updated : Boolean }
    }
  }
  output {
    updated : Boolean from updated
    status  : ProductStatus from record.status
  }
  emit ProductUpdated
  ui {
    layout form
    primary "修改产品"
    icon "pencil"
  }
}

flow CreateOrder title "创建订单" on Order {
  create
  description "创建订单并进入待审批状态"
  input {
    orderNo  : String required label "订单号"
    customer : String required label "客户"
    sku      : String required label "SKU"
    quantity : Number required min 1 label "数量"
    amount   : Money required min 0 label "订单金额"
  }
  require { true }
  steps {
    validate_order "校验订单" {
      uses { orderNo, customer, sku, quantity, amount }
      output { valid : Boolean }
    }
    create_order "写入订单" {
      uses { orderNo, customer, sku, quantity, amount }
      output { orderId : ID }
    }
  }
  output {
    orderId : ID from orderId
    orderNo : String from orderNo
    status  : OrderStatus from record.status
  }
  transition status -> Created
  emit OrderCreated
  ui {
    layout form
    primary "创建订单"
    icon "plus-circle"
  }
}

flow ApproveOrder title "审批订单" on Order {
  description "确认订单可以进入履约"
  input {
    recordId : String required label "订单"
  }
  require { status == Created }
  steps {
    approve_order "审批订单" {
      uses { recordId }
      output { approved : Boolean }
    }
  }
  output {
    approved : Boolean from approved
    status   : OrderStatus from record.status
  }
  transition status -> Approved
  emit OrderApproved
  ui {
    layout form
    primary "批准履约"
    icon "workflow"
  }
}

flow ShipOrder title "发货" on Order {
  description "登记物流单号并将订单标记为已发货"
  input {
    recordId   : String required label "订单"
    trackingNo : String required label "物流单号"
  }
  require { status == Approved }
  steps {
    dispatch_order "登记发货" {
      uses { recordId, trackingNo }
      output { shipped : Boolean }
    }
  }
  output {
    shipped : Boolean from shipped
    status  : OrderStatus from record.status
  }
  transition status -> Shipped
  emit OrderShipped
  ui {
    layout form
    primary "确认发货"
    icon "truck"
  }
}

flow RecordPayment title "登记收款" on Order {
  description "记录收款凭证并完成订单"
  input {
    recordId   : String required label "订单"
    paymentRef : String required label "收款凭证"
  }
  require { status in [Approved, Shipped] }
  steps {
    record_payment "登记收款" {
      uses { recordId, paymentRef }
      output { paid : Boolean }
    }
  }
  output {
    paid   : Boolean from paid
    status : OrderStatus from record.status
  }
  transition status -> Paid
  emit PaymentRecorded
  ui {
    layout form
    primary "登记收款"
    icon "banknote"
  }
}
