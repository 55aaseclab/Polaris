#!/usr/bin/env bash
# clue-social-publish: versioned social publish contract CLI.

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../business-load-env.sh
source "$ROOT_DIR/../business-load-env.sh"
PYTHON_BIN="${CLUE_SOCIAL_PUBLISH_PYTHON:-}"
if [[ -z "$PYTHON_BIN" ]]; then
  if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
    PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
  else
    PYTHON_BIN="python3"
  fi
fi

exec "$PYTHON_BIN" "$ROOT_DIR/runner.py" "$@"
