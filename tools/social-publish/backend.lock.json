{
  "lock_version": 1,
  "cli": {
    "name": "clue-social-publish",
    "version": "0.1.0"
  },
  "contract": {
    "input_schema": "schemas/clue.social-publish.input.v1.schema.json",
    "output_schema": "schemas/clue.social-publish.output.v1.schema.json",
    "schema_version_input": "clue.social-publish.input.v1",
    "schema_version_output": "clue.social-publish.output.v1"
  },
  "adapters": {
    "stub": {
      "name": "stub",
      "version": "0.1.0",
      "backend_kind": "stub",
      "note": "Contract-only; publish returns failed_not_implemented until a real adapter is wired."
    },
    "sau": {
      "name": "sau.cli",
      "version": "unpinned",
      "backend_kind": "subprocess_cli",
      "path": "third_party/social-auto-upload",
      "repository": "git@github.com:jianxiaoyitech/social-auto-upload.git",
      "note": "Optional fork of dreammis/social-auto-upload. Not required for validate-input/output."
    }
  },
  "run_defaults": {
    "request_timeout_seconds": 600
  }
}
