#!/usr/bin/env bash
# clue-justoneapi-cli: versioned, platform-generic JustOneAPI wrapper.

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$ROOT_DIR/../load-env.sh"
polaris_literature_assert_local_command "${1:-}"
PYTHON_BIN="${CLUE_SOCIAL_MEDIA_PYTHON:-}"
if [[ -z "$PYTHON_BIN" ]]; then
  if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
    PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
  else
    PYTHON_BIN="python3"
  fi
fi

if [[ "${1:-}" == "enrich" ]]; then
  shift
  exec "$PYTHON_BIN" "$ROOT_DIR/enrich.py" --root "$ROOT_DIR" "$@"
fi
exec "$PYTHON_BIN" "$ROOT_DIR/runner.py" "$@"
