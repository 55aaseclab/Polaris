#!/usr/bin/env bash
# clue-browser: Camofox (default) + Playwright fallback, all under tools/browser.

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../load-env.sh
source "$ROOT_DIR/../load-env.sh"
polaris_literature_assert_local_command "${1:-}"

if [[ "${1:-}" == "setup" ]]; then
  if [[ "${CLUE_BROWSER_SKIP_PLAYWRIGHT_DOWNLOAD:-0}" == "1" ]]; then
    # The caller must provide a compatible system Chromium executable.
    export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
  fi

  install_playwright_browser() {
    if [[ "${CLUE_BROWSER_SKIP_PLAYWRIGHT_DOWNLOAD:-0}" == "1" ]]; then
      echo "skipping Playwright Chromium download"
      return 0
    fi
    "$@"
  }

  if [[ "${CLUE_BROWSER_INSTALLER:-}" == "npm" ]]; then
    npm --prefix "$ROOT_DIR" install
    install_playwright_browser npx --prefix "$ROOT_DIR" playwright install chromium || true
  elif command -v pnpm >/dev/null 2>&1; then
    pnpm --dir "$ROOT_DIR" install --ignore-workspace --frozen-lockfile
    install_playwright_browser pnpm --dir "$ROOT_DIR" exec playwright install chromium || true
  else
    npm --prefix "$ROOT_DIR" install
    install_playwright_browser npx --prefix "$ROOT_DIR" playwright install chromium || true
  fi
  # Fetch Camoufox binary (pnpm may ignore lifecycle scripts)
  POSTINSTALL="$ROOT_DIR/node_modules/@askjo/camofox-browser/scripts/postinstall.js"
  if [[ -f "$POSTINSTALL" ]]; then
    node "$POSTINSTALL" || true
  else
    # pnpm nested path
    POSTINSTALL="$(find "$ROOT_DIR/node_modules" -path '*/@askjo/camofox-browser/scripts/postinstall.js' 2>/dev/null | head -1 || true)"
    if [[ -n "$POSTINSTALL" ]]; then
      node "$POSTINSTALL" || true
    fi
  fi
  echo "clue-browser setup complete (camofox + playwright in tools/browser only)"
  exit 0
fi

exec node "$ROOT_DIR/runner.mjs" "$@"
