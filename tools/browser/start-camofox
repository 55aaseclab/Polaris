#!/usr/bin/env bash
# Start the long-running Camofox service with the shared Polaris environment.

set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${1:-.env.dev}"
if [[ $# -gt 0 ]]; then
  shift
fi

if [[ ! -f "$ENV_FILE" ]]; then
  echo "error: env file does not exist: $ENV_FILE" >&2
  exit 1
fi

export POLARIS_LITERATURE_ENV_FILE="$ENV_FILE"

# shellcheck source=../load-env.sh
source "$ROOT_DIR/../load-env.sh"

SERVER_ENTRY="$ROOT_DIR/node_modules/@askjo/camofox-browser/server.js"
if [[ ! -f "$SERVER_ENTRY" ]]; then
  SERVER_ENTRY="$(find "$ROOT_DIR/node_modules" \
    -path '*/@askjo/camofox-browser/server.js' \
    -type f -print -quit 2>/dev/null || true)"
fi

if [[ -z "$SERVER_ENTRY" || ! -f "$SERVER_ENTRY" ]]; then
  echo "error: Camofox is not installed; run ./tools/browser/clue-browser setup" >&2
  exit 1
fi

exec node "$SERVER_ENTRY" "$@"
