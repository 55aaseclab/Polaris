{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared browser run input v1",
  "type": "object",
  "required": ["schema_version", "run_id", "start_url", "actions"],
  "properties": {
    "schema_version": {"const": "clue.browser.input.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "start_url": {"type": "string", "format": "uri"},
    "browser": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["camofox", "playwright"],
          "description": "Browser engine. Default: camofox for remote URLs, playwright for localhost."
        },
        "camofox_url": {
          "type": "string",
          "minLength": 1,
          "description": "Existing Camofox server URL (default http://127.0.0.1:9377). If unreachable, a local server is started."
        },
        "headless": {"type": "boolean"},
        "stealth": {
          "type": "boolean",
          "description": "Apply playwright-extra stealth plugin and anti-automation patches. Defaults to true."
        },
        "humanize": {
          "type": "boolean",
          "description": "Use randomized delays, mouse movement, typing cadence, and light scrolling. Defaults to true."
        },
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
        "user_agent": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 2},
        "timezone_id": {"type": "string", "minLength": 1},
        "user_data_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Persistent Chromium profile directory for multi-run continuity."
        },
        "session_user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Stable Camofox userId so cookies/storageState persist across runs (~/.camofox/profiles). Default: clue-<run_id> (ephemeral)."
        },
        "import_cookies_path": {
          "type": "string",
          "minLength": 1,
          "description": "Netscape cookies.txt path to inject after session create (absolute, or relative to CAMOFOX_COOKIES_DIR / ~/.camofox/cookies). Requires Camofox cookie import (CAMOFOX_API_KEY or loopback)."
        },
        "channel": {
          "type": "string",
          "enum": ["chrome", "chrome-beta", "chrome-dev", "msedge", "chromium"],
          "description": "Optional installed browser channel instead of bundled Chromium."
        },
        "proxy": {
          "description": "Proxy config object, or false to disable env BROWSER_PROXY_*.",
          "oneOf": [
            {"type": "boolean", "const": false},
            {
              "type": "object",
              "required": ["server"],
              "properties": {
                "server": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Proxy URL, e.g. http://host:port or socks5://host:port."
                },
                "username": {"type": "string", "minLength": 1},
                "password": {"type": "string", "minLength": 1},
                "bypass": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Comma-separated hosts to bypass the proxy."
                }
              }
            }
          ]
        },
        "wait_for_challenge": {
          "type": "boolean",
          "description": "After navigation, wait for Cloudflare-style interstitials to clear. Defaults to true."
        },
        "challenge_click": {
          "type": "boolean",
          "description": "While waiting, click Turnstile/checkbox/iframe challenge widgets. Defaults to true."
        },
        "challenge_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000,
          "description": "Max time to wait for a challenge page to clear. Defaults to 45000."
        },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 320, "maximum": 3840},
            "height": {"type": "integer", "minimum": 240, "maximum": 2160}
          }
        },
        "pacing": {
          "type": "object",
          "properties": {
            "delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000,
              "description": "Fixed delay used when humanize is false."
            },
            "min_delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000,
              "description": "Lower bound for randomized think-time when humanize is true."
            },
            "max_delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000,
              "description": "Upper bound for randomized think-time when humanize is true."
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "goto",
              "click",
              "fill",
              "press",
              "select",
              "check",
              "wait-for",
              "screenshot",
              "extract-text",
              "extract-attribute",
              "extract-html",
              "scroll",
              "solve-challenge"
            ]
          },
          "url": {"type": "string", "format": "uri"},
          "selector": {"type": "string", "minLength": 1, "maxLength": 500},
          "value": {"type": "string"},
          "key": {"type": "string", "minLength": 1},
          "attribute": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
          "max_chars": {"type": "integer", "minimum": 1, "maximum": 2000000},
          "full_page": {"type": "boolean"},
          "delta_y": {"type": "integer", "minimum": 0, "maximum": 5000},
          "times": {"type": "integer", "minimum": 0, "maximum": 20}
        }
      }
    }
  }
}
