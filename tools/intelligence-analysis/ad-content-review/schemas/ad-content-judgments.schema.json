{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdContentJudgments",
  "type": "object",
  "required": ["judgments"],
  "additionalProperties": true,
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "statement", "classification", "confidence", "clue_ids"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "classification": {
            "type": "string",
            "enum": ["new", "identical", "contradictory", "uncertain"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "clue_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
