{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/wanghai.promo.video-input.v1.schema.json",
  "title": "wanghai.promo.video-input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "video_id",
    "product_id",
    "platform",
    "purpose",
    "locale",
    "mode",
    "target",
    "script",
    "captions",
    "cover",
    "audio",
    "render",
    "options",
    "notes"
  ],
  "properties": {
    "schema": { "const": "wanghai.promo.video-input" },
    "schema_version": { "const": 1 },
    "video_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "product_id": { "type": "integer" },
    "platform": {
      "type": "string",
      "enum": ["douyin", "xiaohongshu", "tiktok", "instagram", "generic"]
    },
    "purpose": {
      "type": "string",
      "enum": ["seed", "unbox", "scene", "compare"]
    },
    "locale": { "type": "string", "enum": ["zh", "en"] },
    "mode": {
      "type": "string",
      "enum": ["stills_motion", "footage"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratio",
        "duration_sec",
        "width",
        "height",
        "fps",
        "allow_duration_tolerance_sec"
      ],
      "properties": {
        "aspect_ratio": { "type": "string", "enum": ["9:16"] },
        "duration_sec": { "type": "number", "minimum": 8, "maximum": 60 },
        "width": { "type": "integer", "minimum": 720, "maximum": 2160 },
        "height": { "type": "integer", "minimum": 1280, "maximum": 3840 },
        "fps": { "type": "integer", "enum": [24, 25, 30] },
        "allow_duration_tolerance_sec": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hook", "cta", "beats"],
      "properties": {
        "hook": { "type": "string", "minLength": 1 },
        "cta": { "type": "string", "minLength": 1 },
        "beats": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/beat" }
        }
      }
    },
    "compare": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["mode", "baseline_label", "baseline_image_path", "other_product_id", "other_label"],
      "properties": {
        "mode": { "type": "string", "enum": ["vs_feature", "vs_product"] },
        "baseline_label": { "type": "string", "minLength": 1 },
        "baseline_image_path": { "type": ["string", "null"] },
        "other_product_id": { "type": ["integer", "null"] },
        "other_label": { "type": ["string", "null"] }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "burn_in", "style"],
      "properties": {
        "enabled": { "type": "boolean" },
        "burn_in": { "type": "boolean" },
        "style": {
          "type": "string",
          "enum": ["safe_zone_bottom", "center_hook"]
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "frame_at_sec"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["auto", "near", "wear", "detail", "frame_at_sec"]
        },
        "frame_at_sec": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bgm", "tts", "voiceover", "mix"],
      "properties": {
        "bgm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "volume", "license_note"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 },
            "license_note": { "type": ["string", "null"] }
          }
        },
        "tts": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["engine", "text_source", "explicit_text", "voice", "provider", "endpoint_env"],
          "properties": {
            "engine": { "type": "string", "enum": ["api_tts"] },
            "text_source": {
              "type": "string",
              "enum": ["beats", "hook_cta", "explicit"]
            },
            "explicit_text": { "type": ["string", "null"] },
            "voice": { "type": ["string", "null"] },
            "provider": { "type": ["string", "null"] },
            "endpoint_env": { "type": ["string", "null"] }
          }
        },
        "voiceover": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["path", "volume"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "volume": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["require_bgm", "loop_bgm", "music_duck_db"],
          "properties": {
            "require_bgm": { "type": "boolean" },
            "loop_bgm": { "type": "boolean" },
            "music_duck_db": { "type": ["number", "null"] }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "transition", "fallback", "api"],
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["ffmpeg_kenburns", "image_to_video_api"]
        },
        "transition": { "type": "string", "enum": ["cut", "fade"] },
        "fallback": {
          "type": ["string", "null"],
          "enum": ["ffmpeg_kenburns", null]
        },
        "api": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["provider", "model", "endpoint_env", "per_shot_prompt_template"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": ["string", "null"] },
            "endpoint_env": { "type": ["string", "null"] },
            "per_shot_prompt_template": { "type": ["string", "null"] }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_ready",
        "require_include_in_external",
        "require_images"
      ],
      "properties": {
        "require_ready": { "type": "boolean" },
        "require_include_in_external": { "type": "boolean" },
        "require_images": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["near", "wear", "detail", "promo_usage"]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "text",
        "duration_sec",
        "motion",
        "image_slot",
        "image_path",
        "asset_ref",
        "trim"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "hook",
            "show",
            "proof",
            "cta",
            "compare_a",
            "compare_b",
            "compare_vs"
          ]
        },
        "text": { "type": "string", "minLength": 1 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "motion": {
          "type": "string",
          "enum": [
            "zoom_in",
            "zoom_out",
            "pan_left",
            "pan_right",
            "static"
          ]
        },
        "image_slot": {
          "type": ["string", "null"],
          "enum": ["near", "wear", "detail", "promo_usage", null]
        },
        "image_path": { "type": ["string", "null"] },
        "asset_ref": { "type": ["string", "null"] },
        "trim": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["start_sec", "end_sec"],
          "properties": {
            "start_sec": { "type": "number", "minimum": 0 },
            "end_sec": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
