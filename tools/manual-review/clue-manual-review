#!/usr/bin/env bash
# Polaris-owned manual-review state adapter.
set -euo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$ROOT_DIR/../load-env.sh"
polaris_literature_assert_local_command "manual-review"
if [[ "${1:-}" == "workflow" ]]; then
  shift
  command_name="${1:-}"
  shift || true
  if [[ "$command_name" != "review" ]]; then
    echo "unsupported workflow command: ${command_name:-missing}" >&2
    exit 2
  fi
  exec python3 "$ROOT_DIR/review.py" review "$@"
fi
exec python3 "$ROOT_DIR/review.py" "$@"
