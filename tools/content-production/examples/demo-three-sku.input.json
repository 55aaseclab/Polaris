{
  "schema": "wanghai.promo.catalog-input",
  "schema_version": 1,
  "catalog_id": "demo-three-sku",
  "title": "Demo Catalog",
  "subtitle": null,
  "locale": "en",
  "market": "CH",
  "template_id": "single-product-page.v1",
  "page_size": "A4",
  "orientation": "portrait",
  "selection": {
    "mode": "explicit",
    "product_ids": [12, 15, 43],
    "batch": null,
    "filters": null
  },
  "price_policy": {
    "mode": "list_price",
    "show_currency": true,
    "hide_if_null": true,
    "label": "List price"
  },
  "include_sections": {
    "cover": true,
    "toc": false,
    "brand_intro": false,
    "product_pages": true,
    "packaging": false,
    "contact": true
  },
  "brand": {
    "name": "Demo Brand",
    "tagline": null,
    "logo_path": null,
    "contact_lines": ["sales@example.com"]
  },
  "options": {
    "require_ready": true,
    "require_include_in_external": true,
    "require_images": ["near"],
    "max_selling_points": 5,
    "image_slots_on_page": ["near", "wear", "detail"]
  },
  "notes": []
}
