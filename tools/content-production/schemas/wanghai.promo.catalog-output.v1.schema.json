{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/wanghai.promo.catalog-output.v1.schema.json",
  "title": "wanghai.promo.catalog-output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "catalog_id",
    "status",
    "generated_at",
    "input_sha256",
    "snapshot_sha256",
    "template_id",
    "locale",
    "market",
    "counts",
    "products",
    "skipped",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "wanghai.promo.catalog-output" },
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "minLength": 2 },
    "status": { "type": "string", "enum": ["published"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "input_sha256": { "type": "string", "minLength": 1 },
    "snapshot_sha256": { "type": "string", "minLength": 1 },
    "template_id": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "enum": ["zh", "en"] },
    "market": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "included", "skipped"],
      "properties": {
        "requested": { "type": "integer" },
        "included": { "type": "integer" },
        "skipped": { "type": "integer" }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "slug",
          "batch",
          "name",
          "page_index",
          "images_used",
          "price_shown",
          "source_meta_sha256"
        ],
        "properties": {
          "product_id": { "type": "integer" },
          "slug": { "type": "string" },
          "batch": { "type": "string" },
          "name": { "type": "string" },
          "page_index": { "type": "integer" },
          "images_used": {
            "type": "object",
            "additionalProperties": false,
            "required": ["near", "wear", "detail"],
            "properties": {
              "near": { "type": ["string", "null"] },
              "wear": { "type": ["string", "null"] },
              "detail": { "type": ["string", "null"] }
            }
          },
          "price_shown": {
            "type": "object",
            "additionalProperties": false,
            "required": ["currency", "amount", "policy"],
            "properties": {
              "currency": { "type": ["string", "null"] },
              "amount": { "type": ["number", "null"] },
              "policy": { "type": "string" }
            }
          },
          "source_meta_sha256": { "type": "string" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "reason"],
        "properties": {
          "product_id": { "type": ["integer", "null"] },
          "reason": { "type": "string" },
          "detail": { "type": ["string", "null"] }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "pdf", "snapshot", "manifest"],
      "properties": {
        "html": { "type": "string", "minLength": 1 },
        "pdf": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
