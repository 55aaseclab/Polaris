{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/wanghai.promo.catalog-snapshot.v1.schema.json",
  "title": "wanghai.promo.catalog-snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "catalog_id",
    "frozen_at",
    "from_input_sha256",
    "template_id",
    "locale",
    "market",
    "page_size",
    "orientation",
    "cover",
    "brand",
    "include_sections",
    "price_policy",
    "pages",
    "skipped"
  ],
  "properties": {
    "schema": { "const": "wanghai.promo.catalog-snapshot" },
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "string", "minLength": 2 },
    "frozen_at": { "type": "string", "minLength": 1 },
    "from_input_sha256": { "type": "string", "minLength": 1 },
    "template_id": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "enum": ["zh", "en"] },
    "market": { "type": "string", "minLength": 1 },
    "page_size": { "type": "string" },
    "orientation": { "type": "string" },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": ["string", "null"] }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline", "logo_path", "contact_lines"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": ["string", "null"] },
        "logo_path": { "type": ["string", "null"] },
        "contact_lines": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "include_sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cover",
        "toc",
        "brand_intro",
        "product_pages",
        "packaging",
        "contact"
      ],
      "properties": {
        "cover": { "type": "boolean" },
        "toc": { "type": "boolean" },
        "brand_intro": { "type": "boolean" },
        "product_pages": { "type": "boolean" },
        "packaging": { "type": "boolean" },
        "contact": { "type": "boolean" }
      }
    },
    "price_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "show_currency", "hide_if_null", "label"],
      "properties": {
        "mode": { "type": "string" },
        "show_currency": { "type": "boolean" },
        "hide_if_null": { "type": "boolean" },
        "label": { "type": ["string", "null"] }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "product_id",
          "slug",
          "batch",
          "display_name",
          "name_en",
          "category",
          "copy",
          "specs",
          "images",
          "price",
          "source_meta_sha256"
        ],
        "properties": {
          "kind": { "const": "product" },
          "product_id": { "type": "integer" },
          "slug": { "type": "string" },
          "batch": { "type": "string" },
          "display_name": { "type": "string" },
          "name_en": { "type": ["string", "null"] },
          "category": { "type": ["string", "null"] },
          "copy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "selling_points", "description"],
            "properties": {
              "title": { "type": ["string", "null"] },
              "selling_points": {
                "type": "array",
                "items": { "type": "string" }
              },
              "description": { "type": ["string", "null"] }
            }
          },
          "specs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimensions_mm",
              "weight_with_packaging_kg",
              "packaging_mode"
            ],
            "properties": {
              "dimensions_mm": {
                "type": "object",
                "additionalProperties": false,
                "required": ["length", "width", "height"],
                "properties": {
                  "length": { "type": ["number", "null"] },
                  "width": { "type": ["number", "null"] },
                  "height": { "type": ["number", "null"] }
                }
              },
              "weight_with_packaging_kg": { "type": ["number", "null"] },
              "packaging_mode": { "type": "string", "enum": ["normal", "gift"] }
            }
          },
          "images": {
            "type": "object",
            "additionalProperties": false,
            "required": ["near", "wear", "detail"],
            "properties": {
              "near": { "$ref": "#/$defs/imageRef" },
              "wear": { "$ref": "#/$defs/imageRef" },
              "detail": { "$ref": "#/$defs/imageRef" }
            }
          },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["currency", "amount", "display", "policy"],
            "properties": {
              "currency": { "type": ["string", "null"] },
              "amount": { "type": ["number", "null"] },
              "display": { "type": ["string", "null"] },
              "policy": { "type": "string" }
            }
          },
          "source_meta_sha256": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "reason"],
        "properties": {
          "product_id": { "type": ["integer", "null"] },
          "reason": { "type": "string", "minLength": 1 },
          "detail": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "imageRef": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "minLength": 1 }
      }
    }
  }
}
