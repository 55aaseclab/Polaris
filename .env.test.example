POLARIS_DATA_ROOT=./config
POLARIS_NETFS_LOCAL_EXPORT_ROOT=./config/exports/workspaces
POLARIS_SERVER_BIND_HOST=127.0.0.1
POLARIS_SERVER_PORT=8787
POLARIS_WEBPORTAL_BIND_HOST=127.0.0.1
POLARIS_WEBPORTAL_PORT=8081
POLARIS_EXECUTOR_HOST=127.0.0.1
POLARIS_EXECUTOR_PORT=8788
POLARIS_EXECUTOR_BASE_URL=http://127.0.0.1:8788
POLARIS_RUNTIME_EXECUTOR_BASE_URL=http://host.docker.internal:8788
POLARIS_EXECUTOR_SHARED_SECRET=test-executor-shared-secret
VITE_POLARIS_API_BASE=/api
AUTHING_APP_ID=your-authing-app-id
AUTHING_ISSUER=https://your-tenant.authing.cn/oidc
AUTHING_JWKS_URL=https://your-tenant.authing.cn/oidc/.well-known/jwks.json
VITE_AUTHING_APP_ID=your-authing-app-id
VITE_AUTHING_AUTHORIZATION_URL=https://your-tenant.authing.cn/oidc/auth
VITE_AUTHING_TOKEN_URL=https://your-tenant.authing.cn/oidc/token
VITE_AUTHING_LOGOUT_URL=https://your-tenant.authing.cn/oidc/session/end
VITE_AUTHING_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
