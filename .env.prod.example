POLARIS_DATA_ROOT=/srv/polaris/data
POLARIS_NETFS_LOCAL_EXPORT_ROOT=/srv/polaris/data/exports/vaults
POLARIS_RELEASE_ID=0.3.2
POLARIS_RELEASE_PROFILE=0.3.0-single-host
POLARIS_RELEASE_GATE_MODE=local-test
POLARIS_DEPLOYMENT_MODE=single-host
POLARIS_SERVER_REPLICAS=1
POLARIS_GATEWAY_REPLICAS=1
POLARIS_JOB_WORKER_CONCURRENCY=1
POLARIS_JOB_LEASE_MS=60000
POLARIS_MAX_ACTIVE_VAULTS=10
POLARIS_ACTIVE_WORKSPACE_QUOTA_BYTES=268435456
# Wanghai is mounted on the same public Polaris origin; no subdomain is used.
POLARIS_WANGHAI_GATEWAY_ORIGIN=https://polaris.jianxiaoyitech.com
POLARIS_WANGHAI_GATEWAY_MASTER_SECRET=replace-with-at-least-32-random-characters
POLARIS_WANGHAI_DOCKER_GATEWAY_HOST=127.0.0.1
# These limits apply per tenant, vault, user, and request category.
POLARIS_WANGHAI_RATE_LIMIT_READS_PER_MINUTE=600
POLARIS_WANGHAI_RATE_LIMIT_MUTATIONS_PER_MINUTE=60
POLARIS_WANGHAI_RATE_LIMIT_UPLOADS_PER_MINUTE=10
# Private, service-user-owned directory for per-vault Wanghai backup keys.
POLARIS_WANGHAI_BACKUP_KEY_ROOT=/srv/polaris/data/backup-keys
POLARIS_WANGHAI_BACKUP_RETENTION_COUNT=2
POLARIS_WANGHAI_BACKUP_TIMEOUT_MS=900000
POLARIS_WANGHAI_BACKUP_SUBMISSIONS_PER_HOUR=6
# Required by remote promotion and release-profile startup. Use a registry image
# pinned by digest; remote provisioning pulls this final image and does not
# build a mutable Wanghai or workspace-base image on the host.
POLARIS_WANGHAI_VAULT_IMAGE=registry.example.invalid/wanghai-admin-portal@sha256:replace-with-64-lowercase-hex-characters
# Candidate manifest generated for this exact environment and source revision.
POLARIS_WORKSPACE_BASE_IMAGE=registry.example.invalid/polaris-workspace-base@sha256:replace-with-64-lowercase-hex-characters
POLARIS_RELEASE_MANIFEST=deploy/release-manifest.json
# External image signing, provenance, and SBOM verification are 0.3.2 gates.
# Production mode still requires these values.
POLARIS_WANGHAI_COSIGN_CERTIFICATE_IDENTITY=
POLARIS_WANGHAI_COSIGN_CERTIFICATE_OIDC_ISSUER=
# Set this to the public Polaris shell origin. Do not allow arbitrary origins.
POLARIS_PORTAL_ALLOWED_ORIGINS=https://polaris.jianxiaoyitech.com
NGINX_SERVER_NAME=polaris.jianxiaoyitech.com
NGINX_HTTP_PORT=8080
POLARIS_SERVER_BIND_HOST=127.0.0.1
POLARIS_SERVER_PORT=8787
POLARIS_PUBLIC_BASE_URL=https://polaris.jianxiaoyitech.com
PASEO_APP_BIND_HOST=127.0.0.1
PASEO_APP_PORT=8082
POLARIS_BOOTSTRAP_ADMIN_USERS=
RIGHTCODE_USERNAME=
RIGHTCODE_PASSWORD=
POLARIS_DEFAULT_CODEX_RIGHTCODE_API_KEY_SCRIPT=
POLARIS_DEFAULT_CODEX_RIGHTCODE_QUOTA_LIMIT=20
POLARIS_DEFAULT_CODEX_RIGHTCODE_ALLOWED_PREFIXES=/codex,/draw
POLARIS_PASEO_APP_BASE_URL=https://polaris.jianxiaoyitech.com/paseo
POLARIS_AUTH_MODE=authing-browser-session
POLARIS_AUTHING_APP_ID=your-authing-app-id
POLARIS_AUTHING_APP_SECRET=your-authing-app-secret
POLARIS_AUTHING_ISSUER=https://your-tenant.authing.cn/oidc
POLARIS_AUTHING_AUTHORIZATION_URL=https://your-tenant.authing.cn/oidc/auth
POLARIS_AUTHING_TOKEN_URL=https://your-tenant.authing.cn/oidc/token
POLARIS_AUTHING_LOGOUT_URL=https://your-tenant.authing.cn/oidc/session/end
POLARIS_AUTHING_LOGOUT_REDIRECT_URI=https://polaris.jianxiaoyitech.com/welcome
POLARIS_AUTHING_REDIRECT_URI=https://polaris.jianxiaoyitech.com/auth/callback
POLARIS_AUTH_SHARED_SECRET=
