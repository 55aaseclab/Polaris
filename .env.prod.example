POLARIS_DATA_ROOT=/srv/polaris/data
POLARIS_NETFS_LOCAL_EXPORT_ROOT=/srv/polaris/data/exports/workspaces
NGINX_SERVER_NAME=polaris.example.com
NGINX_HTTP_PORT=8080
POLARIS_SERVER_BIND_HOST=127.0.0.1
POLARIS_SERVER_PORT=8787
POLARIS_PUBLIC_BASE_URL=https://polaris.example.com
PASEO_APP_BIND_HOST=127.0.0.1
PASEO_APP_PORT=8082
POLARIS_DOCS_BIND_HOST=127.0.0.1
POLARIS_DOCS_PORT=4180
POLARIS_EXECUTOR_HOST=127.0.0.1
POLARIS_EXECUTOR_PORT=8788
POLARIS_EXECUTOR_BASE_URL=http://host.docker.internal:8788
POLARIS_RUNTIME_EXECUTOR_BASE_URL=http://host.docker.internal:8788
POLARIS_EXECUTOR_SHARED_SECRET=change-me-to-a-long-random-secret
POLARIS_BOOTSTRAP_ADMIN_USERS=
RIGHTCODE_USERNAME=
RIGHTCODE_PASSWORD=
POLARIS_DEFAULT_CODEX_RIGHTCODE_API_KEY_SCRIPT=
POLARIS_DEFAULT_CODEX_RIGHTCODE_QUOTA_LIMIT=20
POLARIS_DEFAULT_CODEX_RIGHTCODE_ALLOWED_PREFIXES=/codex,/draw
POLARIS_PASEO_APP_BASE_URL=https://polaris.example.com
POLARIS_AUTH_MODE=authing-browser-session
POLARIS_AUTHING_APP_ID=your-authing-app-id
POLARIS_AUTHING_APP_SECRET=your-authing-app-secret
POLARIS_AUTHING_ISSUER=https://your-tenant.authing.cn/oidc
POLARIS_AUTHING_JWKS_URL=https://your-tenant.authing.cn/oidc/.well-known/jwks.json
POLARIS_AUTHING_AUTHORIZATION_URL=https://your-tenant.authing.cn/oidc/auth
POLARIS_AUTHING_TOKEN_URL=https://your-tenant.authing.cn/oidc/token
POLARIS_AUTHING_LOGOUT_URL=https://your-tenant.authing.cn/oidc/session/end
POLARIS_AUTHING_LOGOUT_REDIRECT_URI=https://polaris.example.com
POLARIS_AUTHING_REDIRECT_URI=https://polaris.example.com/auth/callback
POLARIS_AUTH_SHARED_SECRET=
