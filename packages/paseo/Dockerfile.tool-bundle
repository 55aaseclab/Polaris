# syntax=docker/dockerfile:1.7

FROM node:22 AS bundle

ARG PASEO_SOURCE_REF=v0.1.101

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt,sharing=locked \
  apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/paseo

COPY packages/paseo/source ./
COPY packages/paseo/patches/paseo-web-authing-package.patch /tmp/paseo-authing-package.patch

RUN git reset --hard -q "${PASEO_SOURCE_REF}" \
  && git clean -fdq \
  && git apply --3way /tmp/paseo-authing-package.patch

RUN --mount=type=cache,target=/root/.npm \
  --mount=type=cache,target=/root/.cache \
  npm ci --ignore-scripts --no-audit --prefer-offline \
  && PATH="/opt/paseo/node_modules/.bin:${PATH}" node scripts/postinstall-patches.mjs

COPY packages/paseo/patches /tmp/paseo-patches

RUN git apply --3way /tmp/paseo-patches/paseo-web-authing-core.patch /tmp/paseo-patches/paseo-web-polaris-branding.patch /tmp/paseo-patches/paseo-web-settings-auth-visibility.patch /tmp/paseo-patches/paseo-web-host-account-isolation.patch /tmp/paseo-patches/paseo-web-embed-mode.patch /tmp/paseo-patches/paseo-web-auth-disabled-clean.patch /tmp/paseo-patches/paseo-web-surface-only.patch \
  && rm -rf .git

RUN --mount=type=cache,target=/root/.npm \
  --mount=type=cache,target=/root/.cache \
  npm run build:highlight \
  && npm run build:relay \
  && npm run build:protocol \
  && npm run build:client \
  && npm run build --workspace=@getpaseo/server \
  && npm run build --workspace=@getpaseo/cli

RUN mkdir -p /tmp/packs /bundle \
  && npm pack --workspace=@getpaseo/highlight --pack-destination /tmp/packs \
  && npm pack --workspace=@getpaseo/relay --pack-destination /tmp/packs \
  && npm pack --workspace=@getpaseo/protocol --pack-destination /tmp/packs \
  && npm pack --workspace=@getpaseo/client --pack-destination /tmp/packs \
  && npm pack --workspace=@getpaseo/server --pack-destination /tmp/packs \
  && npm pack --workspace=@getpaseo/cli --pack-destination /tmp/packs \
  && npm install -g --prefix /bundle /tmp/packs/*.tgz

FROM scratch AS bundle-export

COPY --from=bundle /bundle /bundle
