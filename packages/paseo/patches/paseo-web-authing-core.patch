+import { useEffect } from "react";
+import { polarisShellWelcomeHref } from "@/lib/polaris-authing";
+
+export default function PaseoAliasRoute() {
+  useEffect(() => {
+    const search = window.location.search ?? "";
+    const hash = window.location.hash ?? "";
+    window.location.replace(`${polarisShellWelcomeHref()}${search}${hash}`);
+  }, []);
+
+  return null;
+}
