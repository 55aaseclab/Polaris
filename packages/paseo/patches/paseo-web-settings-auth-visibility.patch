+export function canManageSettingsHosts(hasPolarisSession: boolean): boolean {
+  return hasPolarisSession;
+}
+
+export function getVisibleSettingsHosts<THost>(
+  hosts: readonly THost[],
+  hasPolarisSession: boolean,
+): THost[] {
+  return canManageSettingsHosts(hasPolarisSession) ? [...hosts] : [];
+}
