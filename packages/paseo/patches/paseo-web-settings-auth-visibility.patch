+import { describe, expect, it } from "vitest";
+import { canManageSettingsHosts, getVisibleSettingsHosts } from "./settings-screen-auth";
+
+describe("settings host auth visibility", () => {
+  it("hides host management when the user is not authenticated", () => {
+    expect(canManageSettingsHosts(false)).toBe(false);
+    expect(
+      getVisibleSettingsHosts(
+        [{ serverId: "srv_1", label: "Host 1" }],
+        false,
+      ),
+    ).toEqual([]);
+  });
+
+  it("keeps hosts visible for authenticated users", () => {
+    const hosts = [{ serverId: "srv_1", label: "Host 1" }];
+    expect(canManageSettingsHosts(true)).toBe(true);
+    expect(getVisibleSettingsHosts(hosts, true)).toEqual(hosts);
+  });
+});
