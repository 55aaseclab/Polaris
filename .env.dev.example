POLARIS_DATA_ROOT=/path/to/polaris/data
POLARIS_NETFS_LOCAL_EXPORT_ROOT=/path/to/polaris/data/exports/vaults
# Polaris exposes the Wanghai surface through the same origin at /g/.
POLARIS_WANGHAI_GATEWAY_ORIGIN=http://localhost:8787
POLARIS_WANGHAI_GATEWAY_MASTER_SECRET=replace-with-at-least-32-random-characters
POLARIS_WANGHAI_DOCKER_GATEWAY_HOST=127.0.0.1
# Polaris owns gateway authorization and durable tenant-scoped rate limits.
POLARIS_WANGHAI_RATE_LIMIT_READS_PER_MINUTE=600
POLARIS_WANGHAI_RATE_LIMIT_MUTATIONS_PER_MINUTE=60
POLARIS_WANGHAI_RATE_LIMIT_UPLOADS_PER_MINUTE=10
# Polaris stores one private encryption key per integrated Wanghai vault here.
POLARIS_WANGHAI_BACKUP_KEY_ROOT=/path/to/polaris/backup-keys
POLARIS_WANGHAI_BACKUP_RETENTION_COUNT=2
POLARIS_WANGHAI_BACKUP_TIMEOUT_MS=900000
POLARIS_WANGHAI_BACKUP_SUBMISSIONS_PER_HOUR=6
# Comma-separated browser origins allowed to call the Polaris API.
POLARIS_PORTAL_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
POLARIS_SERVER_BIND_HOST=0.0.0.0
POLARIS_SERVER_PORT=8787
POLARIS_PUBLIC_BASE_URL=http://203.0.113.10:8082
POLARIS_PASEO_APP_BIND_HOST=0.0.0.0
POLARIS_PASEO_APP_PORT=8082
# Local stack starts Paseo through Expo with Fast Refresh; no web artifact build.
POLARIS_DOCS_BIND_HOST=0.0.0.0
POLARIS_DOCS_PORT=4180
POLARIS_BOOTSTRAP_ADMIN_USERS=
RIGHTCODE_USERNAME=your-username
RIGHTCODE_PASSWORD=your-password
POLARIS_DEFAULT_CODEX_RIGHTCODE_API_KEY_SCRIPT='node scripts/rightcode-api-key.mjs create'
POLARIS_DEFAULT_CODEX_RIGHTCODE_QUOTA_LIMIT=20
POLARIS_DEFAULT_CODEX_RIGHTCODE_ALLOWED_PREFIXES=/codex,/draw
POLARIS_PASEO_APP_BASE_URL=http://203.0.113.10:8082
POLARIS_AUTH_MODE=disabled
POLARIS_AUTH_DEFAULT_USER_ID=100000000000000001
POLARIS_AUTHING_APP_ID=your-authing-app-id
POLARIS_AUTHING_APP_SECRET=your-authing-app-secret
POLARIS_AUTHING_ISSUER=https://your-tenant.authing.cn/oidc
POLARIS_AUTHING_AUTHORIZATION_URL=https://your-tenant.authing.cn/oidc/auth
POLARIS_AUTHING_TOKEN_URL=https://your-tenant.authing.cn/oidc/token
POLARIS_AUTHING_LOGOUT_URL=https://your-tenant.authing.cn/oidc/session/end
POLARIS_AUTHING_LOGOUT_REDIRECT_URI=http://203.0.113.10:8787/welcome
POLARIS_AUTHING_REDIRECT_URI=http://203.0.113.10:8787/auth/callback
